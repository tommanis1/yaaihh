def profile_of(args):
    """The profile ARGS build with: release for -r/--release, NAME for --profile NAME, else debug (test: debug too)."""
    for i, a in enumerate(args):
        if a in ("-r", "--release"):
            return "release"
        if a == "--profile" and i + 1 < len(args):
            return args[i + 1]
        if a.startswith("--profile="):
            return a.split("=", 1)[1]
    return "debug"


def drop_target_dir(args):
    out, skip = [], False
    for a in args:
        if skip:
            skip = False
        elif a == "--target-dir":
            skip = True
        elif not a.startswith("--target-dir="):
            out.append(a)
    return out


def option_of(args, name):
    """The value of cargo's option NAME (--manifest-path, --target) in ARGS, given as `NAME V` or `NAME=V`; None if absent."""
    for i, a in enumerate(args):
        if a == name and i + 1 < len(args):
            return args[i + 1]
        if a.startswith(name + "="):
            return a.split("=", 1)[1]
    return None


def worktree_of(cwd):
    """The caller's worktree: git's top level of CWD (a nested repo such as flavor/ inside soft-swarm counts as the
    outer one's, so its crates are ours too), or CWD itself outside git."""
    top, d = None, Path(cwd).resolve()
    while True:
        r = subprocess.run(["git", "-C", str(d), "rev-parse", "--show-toplevel"], capture_output=True, text=True)
        if r.returncode != 0:
            break
        top = Path(r.stdout.strip())
        if top.parent == top:
            break
        d = top.parent
    return top or Path(cwd).resolve()


class Gone:
    """Stops the job P (its process group) the moment its caller's connection C ends, rather than at the job's next
    line (a test that prints nothing for an hour); on the build machine C is the relay of a caller over ssh, which ends
    when that link has gone (relay: its input silent for RELAY_SILENT_SEC). What C brings meanwhile (the caller's blank
    lines that keep its link known to be there) is read and dropped. `end()` once the job has ended (a2h-speed N-1446
    p3251; paper-research p3253: with this the 1800 s limit per job had no reason left)."""
    def __init__(self, c, p, what):
        self.c, self.p, self.what, self.done, self.fired = c, p, what, threading.Event(), False
        if c is not None:
            threading.Thread(target=self.watch, daemon=True).start()

    def watch(self):
        import select
        try:
            while not self.done.is_set():
                if not select.select([self.c], [], [], 1)[0]:
                    continue
                try:
                    b = self.c.recv(4096, socket.MSG_DONTWAIT)
                except BlockingIOError:
                    continue
                except OSError:
                    b = b""
                if b:
                    continue
                if not self.done.is_set() and self.p.poll() is None:
                    self.fired = True
                    log(f"stopped (caller gone: its connection ended) {self.what}")
                    try:
                        os.killpg(self.p.pid, signal.SIGTERM)
                    except ProcessLookupError:
                        pass
                return
        except (OSError, ValueError):  # the connection closed here: the job's end
            return

    def end(self):
        self.done.set()


class Service:
    def __init__(self):
        self.cv = threading.Condition()  # guards now and waiting; waiting is the queue, served first come first
        self.now = {}  # folder key -> (who, cwd, args, since, warm, train): the builds running, one per shared folder
        self.waiting = []  # (who, cwd, args, front, key, came, pid, warm, train, member): the --train requests first, then the
        # --front ones, each part in the order it came
        self.state_lock = threading.Lock()  # state.json, written by builds running side by side
        self.leaving = False  # a restart was asked: no new build starts here; the running one ends first
        self.srv = None
        self.serve_from = None  # the file a restart asked for: this process becomes it (exec) once its builds end
        self.state = json.loads(STATE.read_text()) if STATE.exists() else {}
        # the requests the old service had waiting at a restart, [front, came, caller pid]: until each has come again
        # (or its caller has ended), a request after it in the order does not start (a request that comes back first
        # would otherwise start first; test 17)
        self.expected = json.loads(CARRIED.read_text()) if CARRIED.exists() else []
        CARRIED.unlink(missing_ok=True)
        self.carry = []
        self.restart_soon = False  # a restart was asked and waits for the running hold to end
        self.hold = None  # the token of the hold running (build-runner hold), else None; a request carrying it runs in it
        self.hold_pid = None  # the hold's caller: a request whose caller descends from it is in the hold too
        # every hold token this service has given: a job carrying one whose hold has ended keeps that hold's standing
        # (the train's, out of the rules) but waits in the queue as any other (a2h-speed N-1446 p3251)
        self.given = set()
        self.members = set()  # folder keys running inside the hold
        self.beside = set()  # folder keys of --front builds started beside a train: they take no place
        self.hold_folders = set()  # folder keys the hold's requests have asked for: the hold's alone while it runs

    def save(self):  # with state_lock held
        tmp = STATE.with_suffix(".tmp")
        tmp.write_text(json.dumps(self.state, indent=1))
        tmp.replace(STATE)

    def publish(self):  # with cv held
        """QUEUE, for a page: what runs and what waits, and why (N-808). Small, rewritten whole at each change."""
        P = parallel()
        verb = lambda args: args[0] if args else ""
        doc = {"at": time.strftime("%FT%T%z"), "parallel": P,
               "running": [{"who": who, "cwd": cwd, "folder": key, "verb": verb(args), "args": args, "since": int(since),
                            "cold": not warm, "train": train}
                           for key, (who, cwd, args, since, warm, train) in sorted(self.now.items(), key=lambda x: x[1][3])],
               "waiting": [{"who": e[0], "cwd": e[1], "folder": e[4], "verb": verb(e[2]), "args": e[2], "since": int(e[5]),
                            "cold": not e[7], "front": e[3], "train": e[8], "why": self.why(e)} for e in self.waiting]}
        try:
            HOME.mkdir(parents=True, exist_ok=True)
            tmp = QUEUE.with_suffix(".tmp")
            tmp.write_text(json.dumps(doc, indent=1))
            tmp.replace(QUEUE)
        except OSError as e:
            log(f"queue.json: {e}")

    def why(self, entry):  # with cv held
        """Why ENTRY waits now, in words (status, queue.json)."""
        P = parallel()
        if self.member(entry):
            if entry[4] in self.now:
                return f"its folder {entry[4]} is in use ({self.now[entry[4]][0]})"
            if len(self.members) >= self.hold_places():
                return f"the hold runs {len(self.members)}, its most ({self.hold_places()} of {P}: one serves the queue)"
            return f"{self.used()} are running, at most {P} at once: it takes the first place that frees"
        trains = [n for n in self.now.values() if n[5]]
        if entry[3] and not entry[8] and (trains or any(e[8] for e in self.waiting)):
            if entry[4] in self.now:
                return f"its folder {entry[4]} is in use ({self.now[entry[4]][0]})"
            if len(self.beside) >= FRONT_KEPT:
                return f"beside a train: the places kept for --front are in use ({len(self.beside)} running)"
            return "behind an earlier --front request"
        if self.hold is not None and not any(n[5] for k, n in self.now.items() if not k.startswith("hold-") and k not in self.members):
            if entry[4] in self.now:
                return f"its folder {entry[4]} is in use ({self.now[entry[4]][0]})"
            if self.outside() >= P - self.hold_places():
                return f"a train's hold runs: {P - self.hold_places()} place serves the queue, in use ({self.outside()} running)"
            return f"{self.used()} are running, at most {P} at once"
        if trains:
            return f"the train's {verb_of(trains[0][2])} runs alone ({trains[0][0]})"
        if entry[8] and entry[4].startswith("hold-"):
            return f"{self.used()} are running, at most {P} at once: the hold takes the first place that frees"
        if entry[8]:
            if self.now:
                return f"a train's job runs alone: it waits for the {len(self.now)} running to end"
            return "behind an earlier train job"
        if any(e[8] and not self.member(e) for e in self.waiting):
            return "a train's job waits to run alone: nothing new starts before it"
        if entry[4] in self.now:
            return f"its folder {entry[4]} is in use ({self.now[entry[4]][0]})"
        if len(self.now) >= P + (FRONT_KEPT if entry[3] else 0):
            return (f"{len(self.now)} are running, at most {P} at once"
                    + (f" and {FRONT_KEPT} kept for --front" if entry[3] else f" ({FRONT_KEPT} more kept for --front)"))
        cold = sum(not n[4] for n in self.now.values())
        if not entry[7] and cold >= max(1, P - 1):
            return f"it is cold, and {cold} cold {'one runs' if cold == 1 else 'ones run'} (at most {max(1, P - 1)})"
        return "behind an earlier request"

    def may_start(self, entry):  # with cv held
        """ENTRY starts when fewer than PARALLEL builds run, none runs in its folder, and every request waiting before
        it waits for a folder that is busy: in order, except that a build for a free folder does not wait behind one
        whose folder is taken (a2h-speed's warm check in ra-prod beside an implementer's build; N-412 p163)."""
        if not self.fits(entry):
            return False
        self.expected = [x for x in self.expected if alive(x[2])]
        if any(carried_order(x) < order(entry) for x in self.expected):
            return False
        for e in self.waiting:
            if e is entry:
                return True
            if self.fits(e):
                return False
        return False

    def fits(self, entry):  # with cv held
        """A place for ENTRY now, order aside: fewer than PARALLEL run, none in its folder, and when it is cold (its
        folder last built by another worktree, or never: its dependencies or our crates compiled anew) fewer than
        PARALLEL - 1 cold ones run, so a warm request (a named test, a check after an edit, in the folder its worktree
        built last) always finds a place instead of waiting behind cold whole-workspace builds (paper-research N-467 p6:
        a one-test run behind 15 at 14:41)."""
        P = parallel()
        # a request made inside the running hold runs alone in its folder, PARALLEL of the hold's at once; the hold
        # itself takes no place (N-837; N-412 p763: its second step waited on its own hold)
        if self.member(entry):
            return entry[4] not in self.now and self.used() < P and len(self.members) < self.hold_places()
        # a --front build (an install's, a release check) runs beside a train's job or hold, never behind it: the
        # owner's window does not wait on the next train's check (paper-research N-412 p763)
        # it takes a place kept for --front (FRONT_KEPT), never more, beside a train (paper-research N-412 p1084; at 15:11
        # nine ran on three places while train 19's hold waited, load 103)
        if entry[3] and not entry[8] and (any(n[5] for n in self.now.values()) or any(e[8] for e in self.waiting)):
            return entry[4] not in self.now and len(self.beside) < FRONT_KEPT
        # while a hold runs, the places it does not take serve the requests waiting from outside, oldest first (N-412
        # p820: 22 builders' jobs waited behind trains run back to back)
        if self.hold is not None and not any(n[5] for k, n in self.now.items() if not k.startswith("hold-") and k not in self.members):
            # the places the hold does not use serve them too, while none of its steps waits; a step that comes takes
            # the next place that frees (docket-core8 p1003: 477 s of an empty place with 21 waiting)
            step_waits = any(self.member(e) for e in self.waiting)
            return (entry[4] not in self.now and not entry[8] and self.used() < P
                    and (self.outside() < P - self.hold_places() or not step_waits))
        # a train's job runs alone, and once one waits nothing else starts: the running ones finish first (N-808)
        if any(n[5] for n in self.now.values()):
            return False
        # a hold does not wait for the running jobs to end: it starts when a place is free, its steps take places as
        # they free up, and nothing new from outside starts meanwhile (paper-research N-412 p804: 6.5 min waited)
        if entry[8] and entry[4].startswith("hold-"):
            return self.used() < P and not self.restart_soon  # a restart waits on the running hold: none starts after it
        if entry[8]:
            return not self.now
        if any(e[8] and not self.member(e) for e in self.waiting):
            return False
        # FRONT_KEPT places more are kept for --front jobs: the others take at most PARALLEL (N-412 p1084)
        if len(self.now) >= P + (FRONT_KEPT if entry[3] else 0) or entry[4] in self.now:
            return False
        # in the store nothing is cold: a job compiles what no entry covers, in a place of its own (docket-core8 p1003)
        return STORE_MODE or entry[7] or sum(not n[4] for n in self.now.values()) < max(1, P - 1)

    def hold_places(self):  # with cv held
        """How many places a running hold's steps may take: all but one, so one always serves the requests from
        outside (N-412 p820); all of them when there is only one."""
        return max(1, parallel() - 1)

    def outside(self):  # with cv held
        """Builds running from outside the hold (a --front one beside it not counted)."""
        return sum(1 for k in self.now if not k.startswith("hold-") and k not in self.members and k not in self.beside)

    def used(self):  # with cv held
        """Places taken: the builds running, but not a hold itself nor a --front build started beside a train."""
        return sum(1 for k in self.now if not k.startswith("hold-") and k not in self.beside)

    def now_hold_who(self):  # with cv held
        return next((n[0] for k, n in self.now.items() if k.startswith("hold-")), "?")

    def member(self, entry):  # with cv held
        """ENTRY is in the running hold: it carries the hold's token, or its caller descends from the hold's caller
        (a client older than the token, e.g. a release tree's own copy of this file run by release.sh; N-412 p763)."""
        if self.hold is None:
            return False
        return entry[9] == self.hold or (self.hold_pid is not None and descends(entry[6], self.hold_pid))

    def serve(self):
        HOME.mkdir(parents=True, exist_ok=True)
        if SOCK.exists():
            try:
                socket.socket(socket.AF_UNIX).connect(str(SOCK))
                sys.exit("build-runner: a service already answers on " + str(SOCK))
            except OSError:
                SOCK.unlink()
        srv = self.srv = socket.socket(socket.AF_UNIX)
        srv.bind(str(SOCK))
        os.chmod(SOCK, 0o600)
        srv.listen(16)
        log(f"serve: pid {os.getpid()}, shared folders under {HOME / 'target'}, -j {JOBS}")
        global SERVING
        SERVING = True  # Home's Store: the build machine's last rows at once, read again behind them (machine_rows)
        # the store page's walk (N-1446 p2926): by the service of the runner's own home (a test's service walks only
        # when its BUILD_RUNNER_WALK says 1), where the scratch folders are
        mine = "1" if HOME == Path.home() / "agent-coord" / "build-runner" else "0"
        if os.environ.get("BUILD_RUNNER_WALK", mine) != "0" and WALK_SCRATCH.is_dir():
            threading.Thread(target=walk_hourly, daemon=True).start()
        while True:
            try:
                c, _ = srv.accept()
            except OSError:
                if self.leaving:
                    break
                raise
            threading.Thread(target=self.handle, args=(c,), daemon=True).start()
        # a restart: the running builds end and their callers have their results, the waiting ones are told to come
        # again; then this process becomes the service of the restart's file, in the same unit, so there is no moment
        # without one in which a caller would start its own worktree's copy (18 Nov, 12:05: accounts-3's older one)
        with self.cv:
            while self.now or self.waiting:
                self.cv.wait()
        srv.close()
        CARRIED.write_text(json.dumps(self.carry))
        log(f"restart: the running builds ended; this service becomes {self.serve_from}")
        os.execv(sys.executable, [sys.executable, "-I", self.serve_from, "serve"])

    def leave(self, serve_from):
        """A restart (build-runner restart): new callers find no socket and wait for this service's end (connect);
        the waiting ones are told to send their request again, to the new service; the running build goes on. The
        caller shuts the listening socket once the restart's caller has its reply: that wakes `serve`, which may
        become the new service at once, and its exec cut the reply (store test step 19 on the tower, 20 Nov 20:30)."""
        # the socket goes before the waiting are woken, so that none of them sends its request here again
        with self.cv:
            self.leaving, self.serve_from = True, serve_from
            now = list(self.now.values())
            self.carry = [[e[3], e[5], e[6], e[8]] for e in self.waiting]
        SOCK.unlink(missing_ok=True)
        with self.cv:
            self.cv.notify_all()
        log(f"restart asked; {'the running builds end first: ' + '; '.join(' '.join(n[2]) for n in now) if now else 'nothing runs'}")
        return now

    def handle(self, c):
        f = c.makefile("rwb", buffering=0)
        try:
            pid, uid, _gid = struct.unpack("3i", c.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")))
            if uid != os.getuid():
                log(f"refused: a caller of uid {uid}")
                raise PermissionError(f"uid {uid} is not the service's user ({os.getuid()}): a boxed caller's build "
                                      "would run outside its box, so the runner serves only unboxed projects")
            req = json.loads(f.readline())
            if req.get("status"):
                f.write(self.status().encode())
                return
            if req.get("store") is not None:  # Home's Store (coordd's Request::Store, N-1446 p2815)
                q = req["store"] if isinstance(req["store"], dict) else {}
                start = q.get("from") if isinstance(q.get("from"), int) and q["from"] >= 0 else 0
                f.write(json.dumps(store_answer(q.get("row") if isinstance(q.get("row"), str) else None, start)).encode() + b"\n")
                return
            if isinstance(req.get("free"), str):  # a press on Home deletes one of the walk's findings (free)
                f.write(json.dumps(free(req["free"])).encode() + b"\n")
                return
            if req.get("restart"):
                if not os.path.isfile(req["restart"]):
                    raise ValueError(f"restart: no file {req['restart']}")
                onto = b""
                if machine() and os.path.realpath(req["restart"]) != os.path.realpath(SERVE_FILE):
                    # an older copy's restart would make the service that copy, without the refusal below: while a
                    # build machine is named the service is main's file, whichever copy asks (docket-core3 N-412 p1996);
                    # said after the restarting line, which an older client looks for at the reply's start
                    onto = (f"build-runner: the service restarts onto {SERVE_FILE}, the installed runner, not "
                            f"{req['restart']}: a build machine is named\n").encode()
                    req["restart"] = str(SERVE_FILE)
                # while a hold runs, the service goes on serving (its steps ask for jobs; a restart that took the
                # socket away at once left train 19's hold waiting on the restart and the restart on it, N-412
                # p1073); no new hold starts meanwhile, and the restart comes when the running one has ended
                with self.cv:
                    self.restart_soon = True
                    if self.hold is not None:
                        f.write(b"build-runner: a hold runs; the restart comes once it has ended (the service serves meanwhile)\n")
                        log("restart asked while a hold runs: it comes once the hold has ended")
                    while self.hold is not None:
                        self.cv.wait()
                now = self.leave(req["restart"])
                try:
                    f.write(("".join(f"build-runner: restarting after {n[0]}'s running build ({' '.join(n[2])})\n" for n in now)
                             or "build-runner: restarting; nothing runs\n").encode() + onto)
                finally:
                    self.srv.shutdown(socket.SHUT_RDWR)  # wakes serve's accept, after the reply (`leave`)
                return
            mc = (req.get("args") is not None or req.get("hold")) and machine()
            if mc:
                # a build machine is named: this runner sends its callers' jobs there and compiles nothing itself; a job
                # reaching this socket came from a copy without that (a release folder's agent-base/bin, first on the
                # PATH of the sessions restarted on 20 Nov, or a worktree's): refused, so nothing compiles on this PC
                # whichever copy sent it (kpi-data N-412 p1892; paper-research p1895)
                refusal(f, f"this PC compiles nothing: jobs go to the build machine {mc[0]} through main's runner, and "
                           f"the build-runner that sent this one is an older copy without that (a release folder's or a "
                           f"worktree's agent-base/bin, first on PATH?): send it again with {_MAIN}")
                log(f"refused (a build machine is named, an older client) {caller_agent(pid) or '?'} {req.get('cwd')}: "
                    f"{' '.join(req.get('args') or ['hold'])}")
                return
            req["pid"] = pid  # the caller's, from the socket (not what it sent)
            # nor its coord (docket-core3 N-412 p949); on the machine, the one the sending side found for its caller
            req["coord"] = req.get("coord") if TRUST_AGENT else caller_coord(pid)
            # nor its name, where it decides (p1133); a runner whose callers come over its machine key only (the tower)
            # takes the name the sending side read from coordd's cgroup there (BUILD_RUNNER_TRUST_AGENT=1)
            req["agent"] = req.get("agent") if TRUST_AGENT else caller_agent(pid)
            if req.get("hold") or req.get("train"):
                why = train_refused(req)
                if why:
                    refusal(f, why)
                    log(f"refused (train) {req.get('agent') or '?'} {req.get('cwd')}: {why}")
                    return
            if req.get("hold"):
                self.hold_for(req, f, c)
                return
            if req.get("tree") is not None:
                # its tree by content (piece B): its base held while it waits and runs, nothing at the worktree's path
                why = (None if TRUST_AGENT and STORE_MODE else "a tree by content is taken by the build machine's runner "
                       "in store mode only") or tree_refused(req["tree"])
                if why:
                    refusal(f, why)
                    log(f"refused (tree) {req.get('agent') or '?'} {req.get('cwd')}: {why}")
                    return
                with TreeBase(req["tree"]) as tb:
                    if tb.lost:
                        f.write(f"build-runner: {tb.why}; it is sent again\n".encode() + json.dumps(
                            {"exit": 2, "again": True, "came": req.get("came"), "tree_lost": tb.lost}).encode() + b"\n")
                        return
                    if tb.why:
                        refusal(f, tb.why)
                        log(f"refused (tree) {req.get('agent') or '?'} {req.get('cwd')}: {tb.why}")
                        return
                    req["base"] = tb.path
                    self.run(req, f, c)
                return
            self.run(req, f, c)
        except (BrokenPipeError, ConnectionResetError):
            pass
        except Exception as e:  # the caller is told; the service goes on
            try:
                f.write(f"build-runner: {e!r}\n".encode() + json.dumps({"exit": 2}).encode() + b"\n")
            except OSError:
                pass
        finally:
            c.close()

    def status(self):
        lines = []
        with self.cv:
            now, waiting = dict(self.now), list(self.waiting)
            whys = [self.why(e) for e in waiting]
        lines.append(f"at most {parallel()} at once")
        for key, (who, cwd, args, since, warm, train) in sorted(now.items()):
            what = f"hold: {' '.join(args[1:])}" if key.startswith("hold-") else f"cargo {' '.join(args)}"
            lines.append(f"running{' (train)' if train else ''}: {who} in {cwd}: {what} ({int(time.time() - since)} s, folder {key}{'' if warm else ', cold'})")
        if not now:
            lines.append("running: nothing")
        for (who, cwd, args, front, key, _came, _pid, warm, train, _m), why in zip(waiting, whys):
            mark = ' (train)' if train else ' (front)' if front else ''
            lines.append(f"waiting{mark}: {who} in {cwd}: cargo {' '.join(args)} (folder {key}{'' if warm else ', cold'}): {why}")
        with self.state_lock:
            folders = sorted(self.state.items())
        for p, wt in folders:
            d = HOME / "target" / p
            lines.append(f"folder {p}: {size_gb(d):.1f} GB (cap {CAP_GB:g}), last worktree {wt}")
        lines.append(f"disk: {shutil.disk_usage(HOME).free / 2**30:.0f} GB free (builds refused below {MIN_FREE_GB:g})")
        return "\n".join(lines) + "\n"

    def run(self, req, f, c=None):
        cwd, args, who = req["cwd"], list(req["args"]), req.get("who") or "?"
        if not args or args[0] not in VERBS:
            raise ValueError(f"cargo verb {args[:1]} is not one of {sorted(VERBS)}")
        args = drop_target_dir(args)
        prof = profile_of(args)
        folder, target = req.get("folder"), option_of(args, "--target")
        bad = [(what, name) for what, name in (("--profile", prof), ("--folder", folder), ("--target", target))
               if name is not None and not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.-]*", name)]
        # 4. a variable passed with --env that would choose the target folder or the compiler (docket-core8 p1003)
        bad += [("--env", n) for n in (req.get("env") or {}).get("") or [] if n in OWN_VARS or (OWN_VAR_RE.match(n) and not CALLER_CARGO_RE.fullmatch(n))]
        if bad:
            what, name = bad[0]
            why = ("the runner sets it: drop it" if what == "--env" else
                   "a name of letters, digits, _ . and -, not starting with . (a kind: engine, window, flavour, proxy, "
                   "symbols)")
            refusal(f, f"{what} {name}: {why}")
            log(f"refused ({what} {name}) {who} {cwd}: {' '.join(args)}")
            return
        # the shared folder's name, and its key in state.json. A --target build has a folder of its own: in a shared
        # one, the clean on a worktree switch would take out only the switching build's target, and a later build for
        # the other target from the same worktree would link the crates another worktree left there
        key = "-".join(filter(None, (folder, prof, target)))
        tdir = HOME / "target" / key
        wt = str(worktree_of(cwd))
        if TRUST_AGENT and req.get("wt"):
            # the machine's runner: no .git came; the worktree and its git facts are the sending side's
            rwt = os.path.realpath(req["wt"])
            if os.path.realpath(cwd) == rwt or os.path.realpath(cwd).startswith(rwt + "/"):
                wt = req["wt"]
                GIT_FACTS[wt] = req.get("git") or {}
        tbase = req.get("base") if req.get("base") and wt == req.get("wt") else None  # its tree's base (TreeBase)
        front, train = bool(req.get("front")), bool(req.get("train"))
        # --front --train in the store: a window-only train's job beside an engine train's hold (paper-research N-412
        # p1114). It is the train's for the rules and its log line, and runs as a --front one: in the places kept for
        # --front, behind and beside nothing of the trains
        qtrain = train and not (front and STORE_MODE)
        kind, base = key, None
        if STORE_MODE:
            key = f"job-{req['pid']}-{int(float(req.get('came') or time.time()) * 1000)}"  # a job waits on no folder
        elif PER_WT:
            # the worktree's own folder of this kind, named by a hash of its whole path (docket-core3 N-412 p897 point 5)
            wname = f"{re.sub(r'[^A-Za-z0-9_.-]', '_', Path(wt).name)}-{hashlib.sha1(wt.encode()).hexdigest()[:10]}"
            key, tdir, base = f"{kind}@{wname}", HOME / "target" / "wt" / wname / kind, HOME / "target" / "base" / kind
        with self.cv:
            given = req.get("in_hold") in self.given
        if req.get("in_hold") and not given:
            # a token this service never gave (one from before its restart, or made up): the job is a builder's, under
            # the rules, as if it named no hold
            f.write(b"build-runner: the hold this job names was not given by this runner (it ended before the runner's "
                    b"restart?): it runs as an ordinary job, under the rules\n")
            log(f"a hold not given ({who} {cwd}): it runs as an ordinary job: {' '.join(args)}")
            req["in_hold"] = None
        in_hold = bool(req.get("in_hold"))
        for opt_, val, lsp in (("--out", req.get("out"), False), ("--keep", req.get("keep"), True)):
            if val and not writable_for(os.path.join(cwd, val), wt, lsp and req.get("coord")):
                where = "inside your worktree" + (" or under your coord's lsp/ folder ($COORD/lsp/)" if lsp else "")
                refusal(f, f"{opt_} {val}: the runner writes only {where} (resolved past links)")
                log(f"refused ({opt_} outside) {who} {cwd}: {val}")
                return
        if req.get("keep") and req.get("coord"):
            # a keep under lsp/ is made at once, so it is there even when the job has nothing to keep (no proc-macro, no
            # build script): on a build machine it is fetched back whole (the remote test's step 9, 19 Nov 20:07)
            lsp_root = Path(os.path.realpath(req["coord"])) / "lsp"
            kp = os.path.realpath(os.path.join(cwd, req["keep"]))
            if Path(kp).is_relative_to(lsp_root) and Path(kp) != lsp_root:
                mkdirs_within(kp, lsp_root)
        why_not = RULES and not train and not in_hold and refused_by_rules(args, folder, prof, in_base(cwd, wt, tbase), in_base(wt, wt, tbase), req.get("env") or {}, front)
        why_not = why_not.replace(tbase, wt) if why_not and tbase else why_not
        if why_not:
            refusal(f, why_not)
            log(f"refused (rules) {who} {cwd}: {' '.join(args)}: {why_not}")
            return
        # when it first came: kept across a restart (the caller sends it again with its request), so the waiting
        # keep their order under the new service (paper-research N-462)
        came = float(req.get("came") or time.time())
        with self.cv:
            # an expected request is known by its first coming or by its caller: a caller started before ed07606
            # sends no `came` again, and kept as expected while it lived, it held back every later request but the
            # --front ones (N-480: a debug build behind seven release requests); it keeps its place
            mine = [x for x in self.expected if x[1] == came or x[2] == req["pid"]]
            if mine:
                came = mine[0][1]
                self.expected = [x for x in self.expected if x not in mine]
                self.cv.notify_all()
            with self.state_lock:
                warm = self.state.get(key) == wt or PER_WT  # a worktree's own folder is never cold by another's build
            member = req.get("in_hold") or None
            entry = (who, cwd, args, front, key, came, req["pid"], warm, qtrain, member)
            # a --train request (N-808) goes behind the --train ones waiting and ahead of all others; a --front one (a
            # release check, paper-research N-412 p127) behind the --front ones and ahead of the rest; within each, in
            # the order they first came
            self.waiting.insert(sum(order(e) <= order(entry) for e in self.waiting), entry)
            self.publish()
            if not req.get("came"):
                log(f"queued in {key} {who} ({cwd}): {' '.join(args)}")
            steps = Steps(f, req.get("steps"), c)
            told_ended = []

            def ended():  # with cv held: a job naming a hold that has ended runs as an ordinary one, said once
                if entry[9] is not None and not told_ended and not self.member(entry):
                    told_ended.append(True)
                    try:
                        f.write(b"build-runner: the hold this job names is not running (it has ended: its caller's link "
                                b"went, or its command ended): it runs as an ordinary job, in the queue's order\n")
                    except OSError:
                        pass
                    log(f"a hold ended ({who} {cwd}): it runs as an ordinary job: {' '.join(args)}")
            ended()

            def queued():  # how many wait before it, said at each change; a caller gone is found by the loop below
                try:  # under the lock: a caller that does not read loses the line, it never holds the service
                    steps.say("queued", nowait=True, ahead=self.waiting.index(entry))
                except OSError:
                    pass
            if not self.may_start(entry):
                ahead = self.now[key][0] if key in self.now else ", ".join(n[0] for n in self.now.values())
                f.write(f"build-runner: queued behind {ahead or 'nobody running'} ({self.waiting.index(entry)} waiting "
                        f"before this; {len(self.now)} of {parallel()} running): {self.why(entry)}\n".encode())
                queued()
            # looked at each second: an expected caller's end wakes nobody, nor does this caller's (a caller that
            # has gone leaves the queue instead of its build running later for nobody, its folder taken meanwhile)
            # (a request inside the hold runs while a restart waits: the hold is among the builds it lets end)
            stay = lambda: not self.leaving or self.member(entry)
            if self.member(entry):
                self.hold_folders.add(key)
            # a folder the running hold has used is its alone: a request from outside for it is refused (N-412 p781:
            # an accounts server's try in rel-release between two steps of the train's release.sh build)
            taken = lambda: self.hold is not None and key in self.hold_folders and not self.member(entry)
            while not taken() and not self.may_start(entry) and stay() and alive(entry[6]):
                self.cv.wait(1)
                ended()
                queued()
            self.waiting.remove(entry)
            self.publish()
            if taken():
                self.cv.notify_all()
                refusal(f, f"folder {key} is the running train's hold's ({self.now_hold_who()}) until it ends; use "
                           "another: --folder engine or --folder window, or one of your own")
                log(f"refused (folder {key} is the hold's) {who} {cwd}: {' '.join(args)}")
                return
            if not alive(entry[6]):
                self.cv.notify_all()
                log(f"left the queue, its caller gone: {cwd}: {' '.join(args)}")
                return
            if not stay():
                self.cv.notify_all()
                f.write(json.dumps({"exit": 2, "again": True, "came": came}).encode() + b"\n")
                return
            if front and not qtrain and not self.member(entry) and (
                    any(n[5] for n in self.now.values()) or any(e[8] for e in self.waiting)):
                self.beside.add(key)
            self.now[key] = (who, cwd, args, time.time(), warm, qtrain)
            if self.member(entry):
                self.members.add(key)
            self.publish()
            self.cv.notify_all()  # another folder's request may start beside this one
        try:
            if base is not None:
                prepare_folder(tdir, base, prof, target, train)
                with self.state_lock:
                    self.state[key] = wt
                    self.save()
            out_to = NO_COPY if req.get("no_copy") else req.get("out") and os.path.join(cwd, req["out"])
            waited = int(time.time() - came)
            denied = []
            if STORE_MODE:
                report = {"twice": TRUST_AGENT and bool(req.get("twice")), "by_content": bool(req.get("by_content")),
                          "base": tbase}
                code, produced = self.build_in_place(cwd, args, prof, key, wt, req.get("env") or {}, out_to, f, waited,
                                                     who, train or in_hold or key in self.members,  # a hold's job is the train's (p978)
                                                     req.get("keep") and os.path.join(cwd, req["keep"]), report, steps, c)
            else:
                code, produced = self.build(cwd, args, prof, key, tdir, wt, req.get("env") or {}, out_to, f, waited, denied, steps, c)
            if base is not None and code != 0 and denied:
                # cargo wanted to write a file linked from the base (docket-core3 N-412 p897 point 3): those units get
                # copies of their own, and the job runs once more; its second answer is the job's
                n = unlink_units(tdir, prof, target, denied)
                log(f"relinked {n} units in {key} after a write to a linked file, running again: {' '.join(args)}")
                f.write(f"build-runner: cargo wanted to write {n} files linked from the shared base; they are copies now, "
                        "running once more\n".encode())
                code, produced = self.build(cwd, args, prof, key, tdir, wt, req.get("env") or {}, out_to, f, waited, None, steps, c)
            if base is not None and code == 0:
                try:
                    n = harvest(tdir, base, prof, target)
                    if n:
                        log(f"base {kind}: {n} dependency builds added from {key}")
                except OSError as e:
                    log(f"base {kind}: not added from {key}: {e}")
            f.write(json.dumps({"exit": code, "produced": produced, **steps.ended(),
                                **({"differ": report["differ"]} if STORE_MODE and report.get("differ") else {}),
                                # each file made, by content: the client links it from its own store (take_back)
                                **({"blobs": report["blobs"], "store": report["store"]}
                                   if STORE_MODE and report.get("blobs") is not None else {})}).encode() + b"\n")
        finally:
            with self.cv:
                del self.now[key]
                self.members.discard(key)
                self.beside.discard(key)
                self.publish()
                self.cv.notify_all()

    def hold_for(self, req, f, c):
        """build-runner hold: wait as a --train request, then hold the runner alone while the caller's CMD runs; the
        hold ends when the caller closes its connection (CMD ended) or goes away (N-837)."""
        cwd, who, cmd = req["cwd"], req.get("who") or "?", list(req["hold"])
        came = float(req.get("came") or time.time())
        key = f"hold-{req['pid']}"
        with self.cv:
            entry = (who, cwd, ["hold", *cmd], False, key, came, req["pid"], True, True, None)
            self.waiting.insert(sum(order(e) <= order(entry) for e in self.waiting), entry)
            self.publish()
            if not self.may_start(entry):
                f.write(f"build-runner: the hold waits ({self.waiting.index(entry)} waiting before it; "
                        f"{len(self.now)} running): {self.why(entry)}\n".encode())
            while not self.may_start(entry) and not self.leaving and alive(entry[6]):
                self.cv.wait(1)
            self.waiting.remove(entry)
            if not alive(entry[6]) or self.leaving:
                self.publish()
                self.cv.notify_all()
                if self.leaving and alive(entry[6]):
                    f.write(json.dumps({"exit": 2, "again": True, "came": came}).encode() + b"\n")
                return
            token = os.urandom(8).hex()
            self.hold, self.hold_pid = token, req["pid"]
            self.given.add(token)
            self.now[key] = (who, cwd, ["hold", *cmd], time.time(), True, True)
            self.publish()
        log(f"hold start {who} ({cwd}): {' '.join(cmd)}")
        t0 = time.time()
        try:
            f.write(json.dumps({"held": token}).encode() + b"\n")
            c.settimeout(1)
            while alive(req["pid"]):
                try:
                    if not c.recv(64):
                        break
                except socket.timeout:
                    continue
        except OSError:
            pass
        finally:
            with self.cv:
                self.hold = self.hold_pid = None
                self.members.clear()
                self.hold_folders.clear()
                del self.now[key]
                self.publish()
                self.cv.notify_all()
            log(f"hold end in {int(time.time() - t0)} s {who} ({cwd}): {' '.join(cmd)}")

    places_used = None

    def take_place(self, key):
        """The lowest free place's number, taken for KEY."""
        with self.cv:
            if self.places_used is None:
                self.places_used = {}
            i = 0
            while i in self.places_used.values():
                i += 1
            self.places_used[key] = i
            return i

    def free_place(self, key):
        with self.cv:
            (self.places_used or {}).pop(key, None)

    def build_in_place(self, cwd, args, prof, key, wt, cenv, out_to, f, waited, who, train, keep=None, report=None, steps=None,
                       conn=None):
        """A job in an empty place (N-412 p925, p927): the place emptied, the worktree at AT_TREE and the place at
        AT_PLACE in a user and mount namespace of the job's own, each rustc call through the store's wrapper; test
        binaries cargo runs run inside that namespace, with this tree mounted (docket-core3 p928 point 2). Produced
        executables are copied out to the caller's tree as before. (rc, produced)"""
        free = shutil.disk_usage(HOME).free / 2**30
        if free < MIN_FREE_GB:
            why = f"{free:.1f} GB free, below {MIN_FREE_GB:g} GB"
            f.write(f"build-runner: refused: {why}\n".encode())
            if steps is not None:
                steps.refused = why  # into the job's last line, as `refusal` gives it
            log(f"refused (disk {free:.1f} GB) {wt}: {' '.join(args)}")
            return 3, []
        i = self.take_place(key)
        try:
            return self._in_place(i, cwd, args, prof, key, wt, cenv, out_to, f, waited, who, train, keep, report,
                                  steps or Steps(f, False), conn)
        finally:
            self.free_place(key)

    def _in_place(self, i, cwd, args, prof, key, wt, cenv, out_to, f, waited, who, train, keep=None, report=None, steps=None,
                  conn=None):
        place = HOME / "places" / f"p{i}"
        if place.exists():
            move_out(place)
        place.mkdir(parents=True)
        # a tree by content (piece B): its base, read-only and shared, under a layer of the job's own, which goes when
        # the job ends: whatever it writes into its tree (Cargo.lock) goes there, never into the base or the store
        tbase, layer = (report or {}).get("base"), HOME / "places" / f"p{i}.layer"
        if layer.exists():
            move_out(layer)
        if tbase:
            (layer / "up").mkdir(parents=True)
            (layer / "work").mkdir()
            if re.search(r"[,:\\\s]", f"{tbase}{layer}"):
                why = f"{tbase} or {layer} has a character overlay's options cannot carry"
                f.write(f"build-runner: refused: {why}\n".encode())
                if steps is not None:
                    steps.refused = why  # into the job's last line, as the disk's refusal (build_in_place)
                return 3, []
        for d in (AT_TREE, AT_PLACE, STORE_DIR):
            d.mkdir(parents=True, exist_ok=True)
        (place / "CACHEDIR.TAG").write_text("Signature: 8a477f597d28d172789f06886806bc55\n")
        run_file = place / ".store-run"
        inside = lambda p: str(p).replace(wt, str(AT_TREE), 1) if str(p).startswith(wt) else str(p)
        cargs = [inside(a) if a.startswith(wt) else (a.split("=", 1)[0] + "=" + inside(a.split("=", 1)[1])
                 if "=" in a and a.split("=", 1)[1].startswith(wt) else a) for a in args]
        branch = (git(wt, "rev-parse", "--abbrev-ref", "HEAD") or b"").decode().strip()
        commit = (git(wt, "rev-parse", "--short=8", "HEAD") or b"").decode().strip()
        by = json.dumps({"who": who, "wt": wt, "branch": branch, "commit": commit, "train": bool(train)})
        env = {"PATH": PATH, "HOME": str(Path.home()), "CARGO_TARGET_DIR": str(AT_PLACE), "CARGO_INCREMENTAL": "0",
               "CARGO_TERM_COLOR": "never", "RUSTC_WRAPPER": str(WRAPPER), "BUILD_STORE": str(STORE_DIR),
               "BUILD_STORE_RUN": str(run_file), "BUILD_STORE_BY": by}
        twice = bool(report and report.get("twice"))
        if twice:
            env["BUILD_STORE_TWICE"] = "1"
        env.update({k: os.environ[k] for k in ("XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS") if k in os.environ})
        # the caller's first, the runner's own over them (docket-core3 N-412 p1007); under both the machine's git
        # identity, which a caller's --env GIT_* replaces
        env = {**GIT_IDENTITY,
               **{k: in_tree(v, wt, str(AT_TREE)) for k, v in cenv.items()
                  if k and (k in PASS or k.startswith("REPLAY_") or k in (cenv.get("") or []))}, **env}
        verb, rest = cargs[0], cargs[1:]
        cut = rest.index("--") if "--" in rest else len(rest)
        raw = any(a.startswith("--message-format") for a in rest[:cut])
        steps = steps if steps is not None and not raw else Steps(f, False)  # a raw caller's lines are cargo's alone
        cargo = (["cargo"] + (Steps.CONFIG if steps.on else []) + [verb, "-j", JOBS]
                 + ([] if raw else ["--message-format=json-diagnostic-rendered-ansi"]) + rest)
        uid, gid = os.getuid(), os.getgid()
        tree_mount = (f"mount -t overlay overlay -o lowerdir={tbase},upperdir={layer}/up,workdir={layer}/work"
                      if tbase else f"mount --bind {shlex.quote(wt)}")
        inner = (f"{tree_mount} {shlex.quote(str(AT_TREE))} && "
                 f"mount --bind {shlex.quote(str(place))} {shlex.quote(str(AT_PLACE))} && "
                 f"exec unshare --map-user={uid} --map-group={gid} env -C {shlex.quote(inside(os.path.realpath(cwd)))} "
                 + " ".join(shlex.quote(x) for x in cargo))
        cmd = ((["/usr/bin/systemd-run", "--user", "--scope", "-q", "-p", "MemoryMax=10G", "-p", "MemorySwapMax=0"]
                if SCOPE else []) + ["unshare", "-rm", "sh", "-c", inner])
        log(f"start in place p{i} (store, waited {waited} s) {wt} ({cwd}): {' '.join(args)}")
        t0 = time.time()
        p = subprocess.Popen(cmd, cwd="/", env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, start_new_session=True)
        gone = Gone(conn, p, f"{wt}: {' '.join(args)}")
        produced, compile_error, tests_ran, cargo_error = [], [False], [False], [None]
        no_run = verb == "test" and "--no-run" in rest[:cut]
        try:
            at_tree, mine = str(AT_TREE).encode(), wt.encode()
            steps.say("compiling")
            for line in p.stdout:
                line = line.replace(at_tree, mine)  # paths in the worktree named as the caller's, not the mount's
                if raw:
                    f.write(kept(line, place, keep) if keep else line)
                    continue
                line = steps.line(line)
                if line is None:
                    continue
                if line.startswith(b"{"):
                    try:
                        m = json.loads(line)
                    except ValueError:
                        f.write(line)
                        continue
                    if m.get("reason") == "compiler-message" and m.get("message", {}).get("rendered"):
                        f.write(m["message"]["rendered"].encode())
                    elif m.get("reason") == "compiler-artifact" and m.get("executable") and (verb == "build" or no_run):
                        produced.append(m["executable"])
                    continue
                if b"could not compile" in line:
                    compile_error[0] = True
                elif line.startswith(b"test result:") or line.startswith(b"     Running "):
                    tests_ran[0] = True
                elif line.startswith(b"error: ") and cargo_error[0] is None:
                    cargo_error[0] = line[7:].decode(errors="replace").strip()[:120]
                steps.test(line)
                f.write(line)
        except (BrokenPipeError, ConnectionResetError):
            os.killpg(p.pid, signal.SIGTERM)
            p.wait()
            gone.end()
            log(f"stopped (caller gone) {wt}: {' '.join(args)}")
            raise
        code = p.wait()
        gone.end()
        if gone.fired:  # stopped, its caller gone: nobody to copy for nor to tell
            raise BrokenPipeError
        out = []
        if code == 0 and out_to != NO_COPY:
            target = option_of(args, "--target")
            man = option_of(args, "--manifest-path")
            # the tree's files are in its base here: cargo finds the workspace there, named at the worktree's path
            root = in_base(self.workspace_root(in_base(cwd, wt, tbase), in_base(man, wt, tbase),
                                               {"PATH": PATH, "HOME": str(Path.home())}), tbase, wt)
            outdir = Path(out_to) if out_to else Path(root) / "target" / (target or "") / prof
            by_content = bool(report and report.get("by_content"))
            blobs_out, handed = [], None
            for exe in produced:
                real = Path(str(exe).replace(str(AT_PLACE), str(place), 1))
                dest = outdir / ("deps" if verb == "test" else "") / real.name
                if by_content:
                    # nothing written into the tree here: the file is named by its blob of the store, and the client
                    # links it from its own (step 1 of the storage page, N-1446 p2726, p2727)
                    try:
                        handed = handed or handed_folder()
                        blobs_out.append([str(dest), store_blob(real, handed)])
                    except OSError as e:
                        f.write(f"build-runner: {real.name} could not be put in the store: {e}\n".encode())
                        log(f"not put in the store: {real}: {e}")
                        code = 1
                        break
                    out.append(str(dest))
                    continue
                dest.parent.mkdir(parents=True, exist_ok=True)
                tmp = dest.with_name(f"{dest.name}.build-runner-{key}-{threading.get_ident()}")
                shutil.copy2(real, tmp)
                os.chmod(tmp, 0o755)
                tmp.replace(dest)
                out.append(str(dest))
            if by_content and code == 0:
                report["blobs"], report["store"] = blobs_out, str(handed) if handed else None
        counts, missed, differ = {"hit": 0, "miss": 0, "pass": 0, "hit_builder": 0}, [], []
        try:
            for w in run_file.read_text().split():
                counts[w.split(":")[0]] = counts.get(w.split(":")[0], 0) + 1
                counts["hit_builder"] += w == "hit:b"
                if w.startswith("miss:"):
                    missed.append(w[5:])
                if w.startswith("differ:"):
                    differ.append(w[7:])
        except OSError:
            pass
        if report is not None:
            report["differ"] = differ
        secs = int(time.time() - t0)
        how = "" if code == 0 else (f", two compiles differ: {', '.join(differ[:5])}" if differ else ", compile error" if compile_error[0] else ", tests failed" if tests_ran[0]
                                    else f", failed: {cargo_error[0]}" if cargo_error[0] else ", failed")
        hb = f", {counts['hit_builder']} of the hits from builders' entries" if train else ""
        log(f"end rc {code}{how} in {secs} s, in place p{i} (store {counts['hit']} hit {counts['miss']} miss{hb}"
            f"{', each miss compiled twice' if twice else ''}) {wt}: "
            f"{' '.join(args)}; {'handed by content' if report and report.get('by_content') else 'copied'} {len(out)}")
        try:
            with open(STORE_DIR / "runs.jsonl", "a") as r:
                r.write(json.dumps({"at": time.strftime("%FT%T%z"), "who": who, "wt": wt, "branch": branch,
                                    "commit": commit, "train": bool(train), "args": args, "rc": code, "secs": secs,
                                    "waited": waited, **counts, "missed": missed[:50], "twice": twice, "differ": differ}) + "\n")
        except OSError:
            pass
        move_out(place)
        move_out(layer)
        store_gc()
        return code, out

    def build(self, cwd, args, prof, key, tdir, wt, cenv, out_to, f, waited=0, denied=None, steps=None, conn=None):
        """DENIED, when given, gets each path in TDIR that cargo or rustc said it was refused writing."""
        env = {"PATH": PATH, "HOME": str(Path.home()), "CARGO_TARGET_DIR": str(tdir), "CARGO_INCREMENTAL": "0",
               "CARGO_TERM_COLOR": "never"}
        # the user manager's bus, for the scope
        env.update({k: os.environ[k] for k in ("XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS") if k in os.environ})
        # the caller's first, the runner's own over them (docket-core3 N-412 p1007)
        env = {**{k: v for k, v in cenv.items() if k and (k in PASS or k.startswith("REPLAY_") or k in (cenv.get("") or []))}, **env}
        man, target = option_of(args, "--manifest-path"), option_of(args, "--target")
        free = shutil.disk_usage(HOME).free / 2**30
        if free < MIN_FREE_GB:
            why = f"{free:.1f} GB free, below {MIN_FREE_GB:g} GB"
            f.write(f"build-runner: refused: {why}\n".encode())
            if steps is not None:
                steps.refused = why  # into the job's last line, as `refusal` gives it
            log(f"refused (disk {free:.1f} GB) {wt}: {' '.join(args)}")
            return 3, []
        # how this build starts, for its two log lines (paper-research N-808 p5: which jobs are cold, and why)
        how = "warm"
        size = size_gb(tdir)
        if size > CAP_GB:
            how = f"cold, the folder emptied over its cap ({size:.1f} GB)"
            f.write(f"build-runner: the folder {key} holds {size:.1f} GB, over its cap of {CAP_GB:g}: emptied, this "
                    "build is cold\n".encode())
            log(f"emptied {tdir} ({size:.1f} GB)")
            shutil.rmtree(tdir, ignore_errors=True)
            with self.state_lock:
                self.state.pop(key, None)
                self.save()
        tdir.mkdir(parents=True, exist_ok=True)
        # cargo writes its CACHEDIR.TAG only into a target folder it makes itself, and cargo 1.99 refuses to clean a folder
        # without one (18 Nov, the first real build): the tag as cargo writes it
        tag = tdir / "CACHEDIR.TAG"
        if not tag.exists():
            tag.write_text("Signature: 8a477f597d28d172789f06886806bc55\n# This file is a cache directory tag created by cargo.\n"
                           "# For information about cache directory tags see https://bford.info/cachedir/\n")
        dirs = self.ours_dirs(cwd, man, wt, env)
        ours = sorted(dirs)
        files = snapshot(wt, dirs.values())
        if self.state.get(key) != wt:
            by_content = None
            if how == "warm" and self.state.get(key):
                by_content, why_not = self.switch_by_content(key, tdir, prof, target, wt, ours, files,
                                                             self.workspace_root(cwd, man, env))
            if by_content is not None:
                how = (f"switched by content from {self.state[key]}: {len(by_content)} files differ, their times set "
                       "to now; our crates kept")
                f.write(f"build-runner: {key} last built {self.state[key]}; {len(by_content)} files differ from it: "
                        f"their times are set to now here, so cargo rebuilds what reads them, and keeps the rest\n".encode())
            elif how == "warm":
                how = (f"cold, last built {self.state[key]}: {len(ours)} of our crates taken out ({why_not})"
                       if self.state.get(key) else "cold, a new folder")
            if by_content is None:
                f.write(f"build-runner: {key} last built {self.state.get(key) or 'nothing'}; taking out our crates "
                        f"({len(ours)}) before building {wt}\n".encode())
            if ours and by_content is None:
                # cargo clean -p takes out only the profile it is given (dev when none): with a release build's crates
                # left in place, rel's coordd linked another worktree's coord_types (18 Nov, the first real builds)
                # (and only the host's, without --target: a --target build's crates are under tdir/TARGET/)
                cmd = (["cargo", "clean", "--offline", "--target-dir", str(tdir), "--profile", "dev" if prof == "debug" else prof]
                       + (["--manifest-path", man] if man else []) + (["--target", target] if target else []))
                for n in ours:
                    cmd += ["-p", n]
                r = subprocess.run(cmd, cwd=cwd, env=env, capture_output=True, text=True)
                if r.returncode != 0:
                    f.write(r.stderr.encode())
                    return r.returncode, []
            with self.state_lock:
                self.state[key] = wt
                self.save()
        # what this build is made from, for the next worktree's switch (written before cargo runs: a build that fails
        # half way has some of these files compiled, and the next switch compares against them all)
        save_built(key, wt, ours, files)
        used = set()  # the variants of our crates this build compiled or found fresh (from cargo's artifact lines)
        # -j and the artifact messages go after the verb; a `--` (test binaries' own arguments) keeps its place
        verb, rest = args[0], args[1:]
        cut = rest.index("--") if "--" in rest else len(rest)
        # a caller's own --message-format (rust-analyzer's build scripts, a2h-speed N-412 p21) gets cargo's lines raw
        raw = any(a.startswith("--message-format") for a in rest[:cut])
        steps = steps if steps is not None and not raw else Steps(f, False)  # a raw caller's lines are cargo's alone
        cargo = (["cargo"] + (Steps.CONFIG if steps.on else []) + [verb, "-j", JOBS]
                 + ([] if raw else ["--message-format=json-diagnostic-rendered-ansi"]) + rest)

        cmd = (["/usr/bin/systemd-run", "--user", "--scope", "-q", "-p", "MemoryMax=10G", "-p", "MemorySwapMax=0"]
               if SCOPE else []) + cargo
        log(f"start in {key} ({how}, waited {waited} s) {wt} ({cwd}): {' '.join(args)}")
        t0 = time.time()
        p = subprocess.Popen(cmd, cwd=cwd, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                             start_new_session=True)
        gone = Gone(conn, p, f"{wt}: {' '.join(args)}")
        peak = [0]  # the scope's memory.peak, read while the build runs (the scope is gone once it ends, and systemd
        # logs no peak for a scope): the figures for a third build at once (paper-research N-412 p204)

        def sample():
            # the cgroup read each time: at the start the process is still systemd-run in the runner's own service,
            # whose peak is not this build's (the first figures were all the service's 2.0 GB)
            while p.poll() is None:
                try:
                    cg = Path("/proc", str(p.pid), "cgroup").read_text().split("::", 1)[1].strip()
                    if cg.endswith(".scope"):
                        peak[0] = max(peak[0], int(Path("/sys/fs/cgroup" + cg, "memory.peak").read_text()))
                except (OSError, IndexError, ValueError):
                    pass
                time.sleep(2)
        if SCOPE:
            threading.Thread(target=sample, daemon=True).start()
        produced = []
        # a test binary built with --no-run is copied out too (to target/<profile>/deps/, as cargo has it), so it can
        # be run again after the next worktree's build has replaced it in the shared folder (docket-edge2, N-462)
        no_run = verb == "test" and "--no-run" in rest[:cut]
        seen = []  # paths in the folder named on a line of the output, and whether a refusal to write was said
        refused = [False]

        def note(text):
            if denied is not None and str(tdir) in text:
                seen.extend(m.group(0) for m in re.finditer(re.escape(str(tdir)) + r"[^\s:'\"`]*", text))
            if "Permission denied" in text or "os error 13" in text:
                refused[0] = True
        try:
            steps.say("compiling")
            for line in p.stdout:
                note(line.decode(errors="replace"))
                if raw:
                    f.write(line)
                    continue
                line = steps.line(line)
                if line is None:
                    continue
                if line.startswith(b"{"):
                    try:
                        m = json.loads(line)
                    except ValueError:
                        f.write(line)
                        continue
                    if m.get("reason") == "compiler-message" and m.get("message", {}).get("rendered"):
                        f.write(m["message"]["rendered"].encode())
                    elif m.get("reason") == "compiler-artifact":
                        used.update(variant_of(x) for x in m.get("filenames") or [])
                        if m.get("executable") and (verb == "build" or no_run):
                            produced.append(m["executable"])
                    continue
                steps.test(line)
                f.write(line)
        except (BrokenPipeError, ConnectionResetError):
            os.killpg(p.pid, signal.SIGTERM)  # its own session: cargo and its rustcs
            p.wait()
            gone.end()
            log(f"stopped (caller gone) {wt}: {' '.join(args)}")
            raise
        code = p.wait()
        gone.end()
        if gone.fired:  # stopped, its caller gone: nobody to copy for nor to tell
            raise BrokenPipeError
        if code != 0 and refused[0] and denied is not None:
            denied.extend(seen)
        # each variant of our crates this build compiled (its dep-info written since it began) or found fresh is now
        # this worktree's content; the others keep what they were built from (runner test 29)
        note_variants(key, wt, files, tdir, prof, target, ours, used, t0)
        out = []
        if code == 0 and out_to != NO_COPY:
            # to where cargo would have put it in the caller's workspace: <workspace root>/target/<profile dir>
            # (with --target: target/<triple>/<profile dir>)
            outdir = (Path(out_to) if out_to else
                      Path(self.workspace_root(cwd, man, env)) / "target" / (target or "") / prof)
            for exe in produced:
                dest = outdir / ("deps" if verb == "test" else "") / Path(exe).name
                dest.parent.mkdir(parents=True, exist_ok=True)
                # a name of this build's own: two builds of one worktree in two folders (a hold's tests and its engine
                # build in the rel tree) copy out at the same moment (runner test 28, 19 Nov)
                tmp = dest.with_name(f"{dest.name}.build-runner-{key}-{threading.get_ident()}")
                shutil.copy2(exe, tmp)
                tmp.replace(dest)  # a running copy of the old one keeps its file
                out.append(str(dest))
        log(f"end rc {code} in {int(time.time() - t0)} s, peak {peak[0] / 2**30:.1f} GB, in {key} ({how}) {wt}: {' '.join(args)}; copied {len(out)}")
        return code, out

    def metadata(self, cwd, man, env):
        """cargo metadata --no-deps: the workspace's own packages, each dependency with its `path` if it has one. Never
        the full graph: that resolves every platform's and every optional dependency, and fails offline on one no build
        here fetched (18 Nov: flavor/app on `arbitrary`, the proxy on `ar_archive_writer`; docket-core N-412 p142)."""
        r = subprocess.run(["cargo", "metadata", "--format-version", "1", "--offline", "--no-deps"]
                           + (["--manifest-path", man] if man else []), cwd=cwd, env=env, capture_output=True, text=True)
        if r.returncode != 0:
            raise RuntimeError("cargo metadata: " + r.stderr.strip()[-400:])
        return json.loads(r.stdout)

    def switch_by_content(self, key, tdir, prof, target, wt, ours, files, root):
        """Whether the folder KEY, last built from another worktree, can be built from WT by setting the times of the
        files that differ (N-808): (the paths that differ, None), or (None, why not), and then our crates are taken
        out as before. Not when nothing records what the folder was built from, our crates are not the same, any
        Cargo.toml, Cargo.lock or .cargo file differs, or a crate of ours read a file outside the recorded set (cargo's
        dep-info). Done: each differing file's time is set to now in WT, newer than every build in the folder, so cargo
        takes the crates reading it as stale and the rest as fresh, their content being the same."""
        built = load_built(key)
        if not built or built.get("wt") != self.state.get(key):
            return None, "nothing records what it was built from"
        if built.get("ours") != ours:
            return None, "our crates differ"
        old = built.get("files") or {}
        diff = lambda a: {p for p in set(a) | set(files) if a.get(p) != files.get(p)}
        differ = diff(old)
        # each variant of our crates in the folder (a test build, a check, another feature set) was last compiled from
        # the content its record names, which may be an older worktree's than the last build's: a variant the last
        # worktree never built is compared with what it was built from (runner test 29, 19 Nov); one with no record
        # (from before these records) is taken out alone
        snaps, kinds = built.get("snaps") or {}, built.get("variants") or {}
        rel_root = os.path.relpath(root, wt)
        gone, compared = [], set()
        for v, d in variants(tdir, prof, target, ours).items():
            sid = kinds.get(v)
            snap = snaps.get(sid)
            if snap is None:
                drop_variant(tdir, prof, target, v)
                gone.append(v)
                continue
            vfiles = snap["files"]
            if sid not in compared:
                compared.add(sid)
                differ |= diff(vfiles)
            prev = Path(snap["wt"])
            for read in dep_info(d):
                p = Path(read)
                if p.is_absolute():
                    if not p.is_relative_to(prev):
                        continue  # the registry, rune, a build script's output in the folder: not the worktree's
                    rel = str(p.relative_to(prev))
                else:
                    rel = os.path.normpath(os.path.join(rel_root, read))
                if rel not in vfiles and (rel in files or (Path(wt) / rel).is_file()):
                    differ.add(rel)  # read but not recorded (an untracked file outside the crate folders): rebuilt
        if gone:
            log(f"{key}: {len(gone)} variants with no record of what they were built from taken out: {' '.join(sorted(gone))}")
        cargo_files = sorted(p for p in differ if Path(p).name in ("Cargo.toml", "Cargo.lock") or ".cargo" in Path(p).parts)
        if cargo_files:
            return None, f"{cargo_files[0]} differs"
        differ = sorted(differ)
        now = time.time()
        for p in differ:
            if p in files or (Path(wt) / p).is_file():
                try:
                    os.utime(Path(wt) / p, (now, now))
                except OSError as e:
                    return None, f"{p}: {e}"
        return differ, None

    def ours_dirs(self, cwd, man, wt, env):
        """ours(), each name with its package folder."""
        return self.ours(cwd, man, wt, env, dirs=True)

    def ours(self, cwd, man, wt, env, dirs=False):
        """Every path package the build can read whose manifest lies inside the worktree WT: the build's workspace
        members, and each path dependency inside WT, followed on from there (flavor/app reaches crates/yaaihh
        and proxy/crates/yaaihh-proxy). Of a dependency in another workspace only that package is taken, not its
        workspace's other members: those are not in this build's graph, and `cargo clean -p` refuses a name outside it
        (18 Nov, the proxy through crates/usage/prices: "coord-pty did not match any packages"). A path outside WT
        (rune, wgpu-hal) is not ours and is not followed."""
        names, seen, where = set(), set(), {}
        todo = [(man, None)]  # (manifest to read, the one package wanted from its workspace; None: all members)
        while todo:
            m, want = todo.pop()
            for p in self.metadata(cwd, m, env)["packages"]:
                pm = Path(p["manifest_path"]).resolve()
                if (want and pm != want) or not pm.is_relative_to(wt):
                    continue
                names.add(p["name"])
                where[p["name"]] = str(pm.parent)
                for d in p["dependencies"]:
                    dm = d.get("path") and Path(d["path"]).resolve() / "Cargo.toml"
                    if dm and dm.is_relative_to(wt) and dm not in seen:
                        seen.add(dm)
                        todo.append((str(dm), dm))
        return where if dirs else sorted(names)

    def workspace_root(self, cwd, man, env):
        r = subprocess.run(["cargo", "locate-project", "--workspace", "--message-format", "plain", "--offline"]
                           + (["--manifest-path", man] if man else []), cwd=cwd, env=env, capture_output=True, text=True)
        return str(Path(r.stdout.strip()).parent) if r.returncode == 0 else cwd


BUILT = HOME / "built"  # per folder: the worktree and the content of our crates' files it was last built from (N-808)


GIT_FACTS = {}  # on the machine: worktree -> {branch, commit} as the sending side read them


class Steps:
    """Where a job stands, said into its stream F (N-1334) when the caller asked (ON): one STEP line at each change of
    step, binary or total, and at most one a second while only the count moves. `line` takes cargo's own count out of a line of its output (the
    bar it draws with `term.progress.when = "always"`, `Building [==>  ] K/M: ...` ending in a carriage return, the
    word left out under -q), so the job's output is what it was without it; `test` reads a test binary's lines. A
    step said while the service holds its lock (`queued`) goes with NOWAIT through SOCK: when the caller does not
    read, the line is dropped rather than the lock held (a2h-speed N-1334 p10), and tried again at the next look."""
    BAR = re.compile(rb"\s*(?:Building )?\[[=> ]*\]\s*(\d+)/(\d+)")  # under -q cargo draws the bar with no `Building` (a2h-speed N-1334 p10)
    RUNNING = re.compile(rb"\s+Running .*\((?:.*/)?([^/()]+?)(?:-[0-9a-f]{16})?(?:\.exe)?\)\s*$")
    DOCTESTS = re.compile(rb"\s+Doc-tests (\S+)\s*$")  # a library's doc-tests: cargo names them, with no `Running` (consult-3 N-1334 p15)
    # a binary that died (a stack overflow, an abort, a kill at the memory cap) prints no `test result:` of its own;
    # cargo says it, under `Caused by:` (proto-window N-1446 p1562 point 2)
    DIED = re.compile(rb"process didn't exit successfully: `([^`]*)` \(signal: (\d+), (SIG[A-Z0-9]+)")
    # cargo's own settings for its count without a terminal, given on its command line: as variables they would be in
    # every key of the store (build-store-rustc keys on each CARGO* variable), and every job would compile all again
    CONFIG = ["--config", 'term.progress.when="always"', "--config", "term.progress.width=80"]

    def __init__(self, f, on, sock=None):
        self.f, self.on, self.sock, self.d, self.at, self.bin, self.n = f, bool(on), sock, {}, 0.0, None, None
        self.passed = self.failed = 0  # over the test binaries that have ended
        self.failing = []  # the names of the tests that failed, in the order the binaries said them (p1502, head 2)
        self.died = []  # the binaries that died, each its name and the signal (`died`, p1563)
        self.in_failures = False  # between a binary's `failures:` and its `test result:`, where a failed test's output is
        self.refused = None  # a refusal's words, when the job was refused after this was made (the disk's)

    def say(self, step, nowait=False, **d):
        d = {"step": step, **{k: v for k, v in d.items() if v is not None}}
        if not self.on or d == self.d:
            return
        now = time.time()
        # within a step only the count moving is held to one a second: a count first known (cargo's first bar, a
        # binary's `running N tests`) is said at once, so a job of under a second still says its total
        if all(d.get(k) == self.d.get(k) for k in ("step", "what", "of")) and now - self.at < 1:
            return
        line = STEP + b": " + json.dumps(d).encode() + b"}\n"
        if nowait and self.sock is not None:
            try:  # a line this short is one write to a unix socket: it goes whole or not at all
                sent = self.sock.send(line, socket.MSG_DONTWAIT)
            except BlockingIOError:
                return
            if sent < len(line):
                self.f.write(line[sent:])
        else:
            self.f.write(line)
        self.d, self.at = d, now

    def line(self, line):
        """LINE without cargo's bar; None when nothing else was on it."""
        if not self.on or b"\r" not in line:
            return line
        parts, out, bars = line.split(b"\r"), [], 0
        for i, c in enumerate(parts):
            m = self.BAR.match(c)
            if m:
                bars += 1
                self.say("compiling", done=int(m.group(1)), of=int(m.group(2)))
            elif c.strip() or i == len(parts) - 1:  # the spaces a bar is wiped with go too
                out.append(c)
        if not bars:
            return line  # a carriage return of the job's own
        rest = b"\r".join(out)
        return rest if rest.strip() else None

    def test(self, line):
        """A line of a test run: which binary (`Running …`, or `Doc-tests NAME` for a library's doc-tests), how many
        tests it runs, each test's end, its result line. Under -q cargo names no binary (no `Running` line): a binary's
        run begins at its `running N tests`, and the harness marks each test with one character, a line at a time
        (`....F... 88/293`, the count every 88 tests). A failed test's name is read from its output's header only in the
        binary's `failures:`, since `--show-output` gives each passing test's output the same header under `successes:`
        (proto-window N-1446 p1562 point 1). A binary that died is said by cargo's `process didn't exit successfully:
        … (signal: N, NAME)`: `died` names it, so a crash or a kill at the memory cap is not read as no tests run."""
        if not self.on:
            return
        m = self.RUNNING.match(line) or self.DOCTESTS.match(line)
        if m:
            self.bin, self.n, self.in_failures = m.group(1).decode(errors="replace"), None, False
            self.say("testing", what=self.bin, failed=self.failed or None)
        elif m := self.DIED.search(line):
            self.died.append({"binary": self.name_of((m.group(1).split() or [b""])[0]), "signal": int(m.group(2)),
                              "name": m.group(3).decode()})
            self.bin, self.n, self.in_failures = None, None, False
        elif self.n is None and (m := re.fullmatch(rb"running (\d+) tests?\s*", line)):
            self.n, self.k, self.bad, self.in_failures = int(m.group(1)), 0, 0, False
            self.say("testing", what=self.bin, done=0, of=self.n, failed=self.failed or None)
        elif self.n is None:
            return
        elif line.startswith(b"test ") and (m := re.search(rb" \.\.\. (ok|FAILED|ignored\b.*|bench\b.*)\s*$", line)):
            self.k += 1
            self.bad += m.group(1) == b"FAILED"
            if m.group(1) == b"FAILED":
                self.fails(line[5:m.start()])
            self.say("testing", what=self.bin, done=self.k, of=self.n, failed=(self.failed + self.bad) or None)
        elif re.fullmatch(rb"failures:\s*", line):
            self.in_failures = True
        elif self.in_failures and (m := re.fullmatch(rb"---- (.+) stdout ----\s*", line)):
            self.fails(m.group(1))  # a failed test's output, under -q too, where its own line is one `F`
        elif m := re.fullmatch(rb"([.Fi]+)(?: \d+/\d+)?\s*", line):
            self.k += len(m.group(1))
            self.bad += m.group(1).count(b"F")
            self.say("testing", what=self.bin, done=self.k, of=self.n, failed=(self.failed + self.bad) or None)
        elif line.startswith(b"test result:") and (m := re.search(rb"(\d+) passed; (\d+) failed", line)):
            self.passed, self.failed, self.bin, self.n = self.passed + int(m.group(1)), self.failed + int(m.group(2)), None, None
            self.in_failures = False

    @staticmethod
    def name_of(exe):
        """A binary's name as `Running` gives it: the path's last part without cargo's hash or `.exe`."""
        name = re.sub(rb"(?:-[0-9a-f]{16})?(?:\.exe)?$", b"", exe.rsplit(b"/", 1)[-1], count=1)
        return name.decode(errors="replace") or "?"

    def fails(self, name):
        name = name.decode(errors="replace")
        if name not in self.failing:
            self.failing.append(name)

    def ended(self):
        """For the job's last line: the tests passed and failed over its binaries, when it ran any, with the names of
        those that failed; and a refusal's words (proto-mind N-1446 p1502, head 2: a job line says its state, and the
        failing tests by name, as p781's step 4 holds a head "with the failing test named"); the binaries that died."""
        out = {"passed": self.passed, "failed": self.failed} if self.on and (self.passed or self.failed) else {}
        if self.on and self.failing:
            out["failing"] = self.failing
        if self.on and self.died:
            out["died"] = self.died
        if self.refused:
            out["refused"] = self.refused
        return out


def commit_items(wt, commit):
    """The `Item:` trailers of COMMIT in WT (agent-base/git/trail: the item, ticket or post its work belongs to), in
    their order; [] for none or when git cannot say."""
    r = subprocess.run(["git", "-C", str(wt), "log", "-1", "--format=%(trailers:key=Item,valueonly,separator=%x00)",
                        commit or "HEAD", "--"], capture_output=True)
    return [i.strip() for i in r.stdout.decode(errors="replace").strip().split("\0") if i.strip()] if r.returncode == 0 else []


def sent_tree(wt):
    """The git tree of what a job sends of WT's own repository: its tracked files as they are in the worktree
    (`tree_list`'s, without the nested repositories and the .cargo/config.toml files), made in a copy of the worktree's
    index, so its own is untouched (`git add -u` there writes the changed files' blobs, as `git add` does). It is the
    commit's tree when nothing tracked is changed, and a later commit's when that commit takes this state whole. None
    when git cannot say."""
    idx = subprocess.run(["git", "-C", str(wt), "rev-parse", "--git-path", "index"], capture_output=True, text=True)
    if idx.returncode != 0:
        return None
    with tempfile.TemporaryDirectory() as td:
        tmp = os.path.join(td, "index")
        try:
            shutil.copyfile(os.path.join(str(wt), idx.stdout.strip()), tmp)
        except OSError:
            return None
        env = {**os.environ, "GIT_INDEX_FILE": tmp}
        if subprocess.run(["git", "-C", str(wt), "add", "-u"], env=env, capture_output=True).returncode != 0:
            return None
        r = subprocess.run(["git", "-C", str(wt), "write-tree"], env=env, capture_output=True, text=True)
        return r.stdout.strip() if r.returncode == 0 else None


def changed_files(wt, commit, tree):
    """How many files TREE (`sent_tree`'s) holds that COMMIT's tree does not hold the same: 0 when the work sent is
    the commit's; None when git cannot say."""
    if not tree:
        return None
    r = subprocess.run(["git", "-C", str(wt), "diff-tree", "-r", "--name-only", f"{commit or 'HEAD'}^{{tree}}", tree],
                       capture_output=True, text=True)
    return len(r.stdout.splitlines()) if r.returncode == 0 else None


FAILING_MAX = 200  # the failing tests named in a job's line; the rest counted (`JobFile.act`)
TAKES_OUT_MAX = 200  # the files a red's line names as taken out; the rest counted (`JobFile.red`)
BINARIES_MAX = 50  # the binaries a job's end names with their md5 (`JobFile.end`)
# a job's line, sent by a child of its own (`JobFile.send`): WHAT names it, ARGV is the coordc command. It holds MINE,
# its lock file, from its making until it is sent, and first waits for PREV, the line made before it for the same coord
# (`flock`), so a coord's lines land in the order they were made, each job's and all jobs' (paper-research N-1446
# p1872). A line coordc could not take to coordd (rc 3, client.rs `connect`: coordd is not running, as in a switch or a
# restart) is never dropped: it waits for coordd, trying again each second, with no count and no time limit, and goes
# once coordd is back, the lines after it waiting behind it; the journal says it waits, and when it went. rc 3 is the
# only rc tried again: coordd never had that line, so sending it again makes no twin. A line coordd had and did not take
# (any other rc) goes to the journal with coordc's words, as before. TAIL names the coord's last line (under ORDER's
# lock): a line still the last once sent takes its lock file and TAIL away; else the next line takes its lock file away
ACT_PY = r'''
import fcntl, os, subprocess, sys, time
what, mine, prev, tail, order, argv = *sys.argv[1:6], sys.argv[6:]
def journal(*lines):
    try:
        subprocess.run(["logger", "-t", "build-runner-act"], input="".join(f"{l}\n" for l in lines if l), text=True,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass
if prev:
    try:
        p = os.open(prev, os.O_RDONLY)
        fcntl.flock(p, fcntl.LOCK_EX)
        os.unlink(prev)
        os.close(p)
    except OSError:
        pass
waited = None
while True:
    try:
        r = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, text=True)
        rc, out = r.returncode, (r.stdout + r.stderr).strip()
    except OSError as e:
        rc, out = 127, str(e)
    if rc != 3:
        break
    if waited is None:
        waited = time.time()
        journal(f"build-runner: the record's line of {what} waits for coordd: coordc act job failed (rc 3)", out)
    time.sleep(1)
if rc:
    journal(f"build-runner: the record's line of {what} not recorded: coordc act job failed (rc {rc})", out)
elif waited is not None:
    journal(f"build-runner: the record's line of {what} recorded once coordd was back, {time.time() - waited:.0f} s after it first failed")
try:
    o = os.open(order, os.O_RDWR)
    fcntl.flock(o, fcntl.LOCK_EX)
    try:
        last = open(tail).read()
    except OSError:
        last = ""
    if last == mine:
        os.unlink(tail)
        os.unlink(mine)
except OSError:
    pass

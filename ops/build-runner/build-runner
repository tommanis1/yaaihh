ACT_SENT = []  # the children the jobs' lines went out with (`JobFile.send`), so a test can wait for them
# a replay job's own, in both its lines (`replay`)
REPLAY_FACTS = ("record", "lines", "way", "back", "copy", "copy_at", "view", "view_at", "copied_bytes", "project",
                "project_at", "binary", "binary_md5", "unchecked")
REPLAY_COUNTS = ("problem_lines", "now_makes", "now_refused")  # a replay job's end, as its test prints them
# the steps of a job that runs, out of the queue: its first says `runs` in the record (`JobFile.step`); before it the job
# waits (queued, unreachable, sending, waiting for the replay lock), so a reader tells waiting from running by the
# record alone (the scheduling of the owner's N-1104 p1156; paper-research N-1446 p3044)
RUNS_STEPS = ("compiling", "testing", "replaying")


class JobFile:
    """This caller's job as a file a page reads (N-1334): JOBS_DIR/PID-WHEN.json, rewritten whole at each change (a
    temporary file, then a rename). It names no command line: the verb, the packages (-p) and the target. A page's
    file never fails a job: an error writing it is passed over. At its start a caller takes out the files of callers
    gone for more than a day. It also names the job's work (the owner, N-1104 p764: work sent to the runner tracks its
    commits; paper-research N-1446 p1372): `items`, the commit's `Item:` trailers, `tree`, the git tree of what the
    job sent (`sent_tree`), which differs from the commit's when the work is not committed, and `changed`, how many
    files it holds that the commit does not. The job also says itself in its coord's record, with that work, as it
    starts and as it ends (`act`; p1372, p1386: a day of files is no record)."""
    def __init__(self, req, wt, facts, agent, coord, machine=None, more=None):
        args = req["args"]
        cut = args.index("--") if "--" in args else len(args)
        pk = [a.split("=", 1)[1] if "=" in a else args[i + 1] for i, a in enumerate(args[:cut])
              if a in ("-p", "--package") and i + 1 < cut or a.startswith(("--package=", "-p="))]
        now = time.strftime("%FT%T%z")
        self.path = JOBS_DIR / f"{os.getpid()}-{int(time.time())}.json"  # the pid and when: a pid comes again
        self.d = {"pid": os.getpid(), "agent": agent, "coord": coord, "who": req.get("who"), "wt": wt,
                  "branch": facts.get("branch"), "commit": facts.get("commit"), "verb": args[0] if args else "",
                  "packages": pk, "target": option_of(args[:cut], "--target"), "machine": machine,
                  "front": bool(req.get("front")), "train": bool(req.get("train")), "since": now, "step_since": now,
                  "tree": sent_tree(wt), "items": commit_items(wt, facts.get("commit"))}
        self.d["changed"] = changed_files(wt, facts.get("commit"), self.d["tree"])
        self.d.update(tests_named(args))  # a test job: which tests it names, or whole (p1502, head 2)
        self.d.update(more or {})  # a replay's own facts (`replay`): its record, binary, and the tree it was built from
        self.red_why = self.red(wt, req.get("red_of"))
        self.t0, self.said_end, self.said_runs, self.sent, self.t1 = time.time(), False, False, 0, None
        try:
            JOBS_DIR.mkdir(parents=True, exist_ok=True)
            self.end_gone()
            for old in [*JOBS_DIR.glob("*.json"), *JOBS_DIR.glob("*.act")]:  # a job's file, and its lines' locks
                pid = old.stem.split("-")[0]
                if (pid.isdigit() and not alive(int(pid)) and time.time() - old.stat().st_mtime > 86400 and not held(old)
                        and (not unended(old) or time.time() - old.stat().st_mtime > GONE_KEPT)):
                    old.unlink()
                    old.with_suffix(".gone").unlink(missing_ok=True)
        except OSError:
            pass
        self.act("start")
        self.save()  # with no step yet (a page passes it over): a caller killed before its first step is found (end_gone)

    def end_gone(self):
        """The end of each job of this caller's coord whose caller is gone with no end of its own (killed outright, its
        machine gone down): said here, as this caller's, so no job of a dead caller stays open in its record and reads
        as waiting (docket-edge5 H-1651 p3: 18 of research's 3,387 jobs; paper-research N-1446 p3164: a job ends when
        its process is gone). Its line says `gone`, why, with no rc and no counts, its seconds those to its file's last
        change, and `job_agent`, the agent whose job it was when that is not this caller's. A caller stopped by a
        signal says its own end (`stop_ends`); this is for one that could not. Each such job is ended by one caller:
        the first to make its JOBS_DIR/ID.gone."""
        for old in JOBS_DIR.glob("*.json"):
            pid = old.stem.split("-")[0]
            if old == self.path or not pid.isdigit() or alive(int(pid)) or not unended(old):
                continue
            try:
                d = json.loads(old.read_text())
                t1 = old.stat().st_mtime
            except (OSError, ValueError):
                continue
            if not isinstance(d, dict) or d.get("coord") != self.d.get("coord") or not d.get("agent"):
                continue
            try:
                os.close(os.open(old.with_suffix(".gone"), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC, 0o600))
            except OSError:
                continue  # another caller ends it
            g = JobFile.__new__(JobFile)
            g.path, g.d, g.said_end, g.said_runs, g.sent, g.red_why = old, d, False, True, 0, None
            try:
                g.t0 = time.mktime(time.strptime(d.get("since") or "", "%Y-%m-%dT%H:%M:%S%z"))
            except (ValueError, OverflowError):
                g.t0 = t1
            g.t1 = t1
            g.step("ended", rc=None, gone=f"its caller (pid {pid}) is gone with no end of its own",
                   **({"job_agent": d["agent"]} if d["agent"] != self.d.get("agent") else {}))

    def red(self, wt, rev):
        """A red's own facts (--red-of REV; proto-mind N-1446 p1502, head 3: a red names the green tree it takes a change
        out of, and the change): `red_of`, REV's commit, `red_of_tree`, its tree, and `takes_out`, the files where the
        tree this job sends differs from REV's (TAKES_OUT_MAX named, `takes_out_more` counting the rest). The words a
        client refuses it with (rc 3) when REV is no commit, the tree sent is not known, or nothing is taken out; else
        None."""
        if not rev:
            return None
        g = lambda *a: subprocess.run(["git", "-C", str(wt), *a], capture_output=True, text=True)
        c, t = g("rev-parse", "--short=8", f"{rev}^{{commit}}"), g("rev-parse", f"{rev}^{{tree}}")
        self.d["red_of"] = c.stdout.strip() if c.returncode == 0 else rev
        if c.returncode != 0 or t.returncode != 0:
            return f"--red-of {rev}: no commit of {wt}"
        self.d["red_of_tree"] = t.stdout.strip()
        if not self.d.get("tree"):
            return f"--red-of {rev}: the tree this job sends is not known, so neither is what it takes out of {rev}"
        names = lambda out: [x for x in out.split("\0") if x]  # -z: a name with a space (or quoted by git) whole
        r = g("diff-tree", "-r", "-z", "--name-only", self.d["red_of_tree"], self.d["tree"])
        if r.returncode != 0:
            return f"--red-of {rev}: git diff-tree {self.d['red_of_tree'][:8]} {self.d['tree'][:8]} answered {r.returncode}"
        self.d["takes_out"] = names(r.stdout)
        if not self.d["takes_out"]:
            return (f"--red-of {rev}: what it sends is {self.d['red_of']}'s tree ({self.d['red_of_tree'][:8]}), so it takes "
                    "nothing out: a red is the green commit with its change undone")
        # what it takes out beyond REV's own change (REV against its first parent; a root commit's own change is all
        # of it): a red that takes out its own test as well proves less than one that takes out only the fix
        # (proto-window N-1446 p1565 point 1), and a reader sees it without running git
        par = g("rev-parse", "-q", "--verify", f"{rev}^1^{{commit}}")
        own = (g("diff-tree", "-r", "-z", "--no-commit-id", "--name-only", par.stdout.strip(), c.stdout.strip())
               if par.returncode == 0 else g("diff-tree", "-r", "-z", "--no-commit-id", "--name-only", "--root", c.stdout.strip()))
        if own.returncode == 0:
            mine = set(names(own.stdout))
            self.d["takes_out_beyond"] = [x for x in self.d["takes_out"] if x not in mine]
        return None

    def step(self, step, **d):
        now = time.strftime("%FT%T%z")
        if step != self.d.get("step") or d.get("what") != self.d.get("what"):
            self.d["step_since"] = now
        for k in ("what", "done", "of", "failed", "ahead"):  # a step's own figures do not outlive it
            self.d.pop(k, None)
        self.d.update({"step": step, "at": now, **d})
        self.save()
        if step in RUNS_STEPS and not self.said_runs and not self.said_end:
            self.said_runs = True
            self.act("runs")
        if step == "ended" and not self.said_end:
            self.said_end = True
            self.act("end", **{k: d.get(k) for k in ("rc", "passed", "failed", "failing", "refused", "died", "binaries", "gone",
                                                     "job_agent", *REPLAY_COUNTS)})

    def save(self):
        """The file written whole (a temporary file, then a rename)."""
        try:
            tmp = self.path.with_suffix(".tmp")
            tmp.write_text(json.dumps(self.d, indent=1))
            tmp.replace(self.path)
        except OSError:
            pass

    def act(self, phase, **end):
        """The job's line in its coord's record (the owner, N-1104 p764: work sent to the runner tracks its commits;
        paper-research N-1446 p1364, p1386): `coordc act job TEXT FIELD=VALUE...`, coordd's `Request::Act`, the way an
        agent's edit reaches it, recorded as `{"ev": "act", "agent", "is": "job", "text", "phase", ...}` (64's coordd
        a45d6e7d takes it, checked by hand 08:39Z 22 Nov, as p1386 asks): as the job starts, its worktree, branch, commit, the
        commit's `Item:` trailers, the tree it sent and how many files that tree holds the commit does not, the verb,
        packages and target; as it ends, the same with its rc, its tests passed and failed, its seconds and the files
        its output went to (the caller's stdout and stderr, when they are files), each a field of its own. A test job's
        two lines also say what it named (`tests_named`: `tests`, `targets`, `skip`, `exact`, `ignored`, `no_run`, or
        `whole`), and its end its state (proto-mind N-1446 p1502, head 2): `refused` with the runner's words when it
        was refused (rc 3, nothing ran, no counts); else `passed` and `failed` always, 0 and 0 when no test ran; and
        `failing`, the names of the tests that failed (`failing_more` counting those past FAILING_MAX); and `died`, each
        binary that died with its signal (`Steps.died`, a replay's binary killed; p1563). A red's two lines
        (--red-of REV, `red`; head 3) say `red_of`, `red_of_tree` and `takes_out`, the files taken out. Only for an
        agent's job, with the agent's own coordc ($AGENT_BASE/bin/coordc; coordd knows the agent by the caller's
        cgroup, as for an edit), and only through production's runner: the runner's own tests (UNIT
        build-runner-test, ...) say nothing in a record. Like the file it never fails a job, and nothing waits on it:
        each line goes out from a child of its own, handed off, in its coord's order, waiting for a coordd that is down
        (`send`, `ACT_PY`; p1872)."""
        cc = Path(os.environ.get("AGENT_BASE") or "/nonexistent") / "bin" / "coordc"
        if not self.d.get("agent") or UNIT != "build-runner" or not os.access(cc, os.X_OK):
            return
        d = self.d
        pk = " ".join(f"-p {p}" for p in d.get("packages") or [])
        on = f"{d.get('branch') or '?'} {d.get('commit') or '?'}" + (f" + {d['changed']} changed" if d.get("changed") else "")
        back = f" back, {d['back']}'s binary," if d.get("back") else ""  # a replay back (p1522)
        n_out, n_beyond = len(d.get("takes_out") or []), len(d.get("takes_out_beyond") or [])
        red = (f", a red of {d['red_of']} taking out {n_out} file{'' if n_out == 1 else 's'}"
               + (f", {n_beyond} beyond its own change" if n_beyond else "") if n_out else
               f", a red of {d['red_of']}" if d.get("red_of") else "")  # a red (--red-of; head 3)
        work = (f"{d.get('verb') or ''}{' ' + pk if pk else ''}{' of ' + d['record'] if d.get('record') else ''}{back} on {on}{red}"
                + (f", for {', '.join(d['items'])}" if d.get("items") else ""))
        # the job file's own names, its file's name as `id`, so a reader takes a line and a file as one job (docket-edge5
        # N-1446 p1391); coordc gives a value that is no JSON list or object as a string (rc "0", train "1")
        f = {"phase": phase, "id": self.path.stem, "since": d.get("since") or "", "verb": d.get("verb") or "",
             "packages": json.dumps(d.get("packages") or []),
             "wt": str(d.get("wt") or ""), "branch": d.get("branch") or "", "commit": d.get("commit") or "",
             "items": json.dumps(d.get("items") or []), "tree": d.get("tree") or "",
             "changed": "" if d.get("changed") is None else str(d["changed"]), "target": d.get("target") or "",
             "machine": d.get("machine") or "", "train": "1" if d.get("train") else ""}
        test = d.get("verb") in ("test", "replay")
        # a replay's own facts (`replay`; proto-mind N-1446 p1502, head 4): the record, its lines, the binary
        f.update({k: str(d[k]) for k in REPLAY_FACTS if d.get(k) not in (None, "")})
        if d.get("red_of"):  # a red's (--red-of; head 3): the green commit and tree it takes the change out of, and the files
            out = d.get("takes_out") or []

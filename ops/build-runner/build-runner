def record_upto(log, line):
    """(lines, bytes) of LOG's first LINE lines; when LINE is None, of its lines before the last input among its whole
    lines, as the engine's save_on cuts (docket-edge5 N-1556 p3): a last line still being written would read as a
    problem line, and so would an input whose outputs are still being written; None when no whole line is an input.
    The record only grows at its end, so these bytes stay as they are."""
    n, end, at = 0, 0, 0
    with open(log, "rb") as f:
        for blk in iter(lambda: f.read(1 << 22), b""):
            i = -1
            while line is None or n < line:
                i = blk.find(b"\n", i + 1)
                if i < 0:
                    break
                n, end = n + 1, at + i + 1
            if line is not None and n >= line:
                break
            at += len(blk)
    if line is not None:
        return n, end
    cut = last_input(log, end)
    return None if cut is None else (n - cut[1], cut[0])


def remove_view(d):
    """D with what overlay left in it (its work folder is mode 000)."""
    for root, dirs, _ in os.walk(d):
        for x in dirs:
            try:
                os.chmod(os.path.join(root, x), 0o700)
            except OSError:
                pass
    shutil.rmtree(d, ignore_errors=True)


class RecordView:
    """A replay's view of NAME's live record at line N, or with no N before its last input (record_upto) (step 2 of the
    storage page, N-1446 p2726, p2727), in a folder of REPLAY_VIEWS named after this runner's pid: `lower/`, the coord's
    project file and tickets/log.jsonl, the record's first N lines; `up/` and `work/`, the run's own layer; `view/`,
    where the binary sees the lower with its own layer over it, mounted in a mount namespace of its own (`wrap`). Until
    the replay reads only up to a line (docket-core's), the lower's record is a cut copy; once it does, it is a link to
    the live file, and nothing is copied. The view holds only the files the copies held (the replay also reads the
    folder's tickets/alive.json and decider when they are there, and a copy had neither). The folder goes when the run
    ends (`remove`), and one a runner left that died goes at the next view."""

    def __init__(self, name, line):
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", name):
            sys.exit(f"build-runner replay: refused: --record {name!r} is no record's name")
        self.live = RECORDS / name
        self.log = self.live / "tickets" / "log.jsonl"
        if not self.log.is_file():
            sys.exit(f"build-runner replay: refused: {self.log} is not there (--record NAME names a coord folder of "
                     f"{RECORDS})")
        upto = record_upto(self.log, line)
        if upto is None:
            sys.exit(f"build-runner replay: refused: {name}'s record holds no input among its whole lines (a view "
                     f"with no --line ends before the last one, as save_on cuts)")
        self.lines, self.bytes = upto
        if line is not None and self.lines < line:
            sys.exit(f"build-runner replay: refused: --line {line}: {name}'s record has {self.lines} lines")
        self.at = time.strftime("%FT%TZ", time.gmtime())
        self.project = (self.live / "project").read_bytes() if (self.live / "project").is_file() else None
        # what make() copies, for the job's line: the record's first `bytes` and the project file
        self.copied = self.bytes + len(self.project or b"")
        REPLAY_VIEWS.mkdir(parents=True, exist_ok=True)
        for d in REPLAY_VIEWS.iterdir():  # one a runner that died left
            try:
                os.kill(int(d.name.split("-")[0]), 0)
            except ProcessLookupError:
                remove_view(d)
            except (ValueError, PermissionError):
                pass
        self.dir = Path(tempfile.mkdtemp(prefix=f"{os.getpid()}-", dir=REPLAY_VIEWS))
        if re.search(r"[,:\\\s]", str(self.dir)):
            sys.exit(f"build-runner replay: refused: {self.dir} has a character overlay's options cannot carry")
        self.path = self.dir / "view"

    def make(self):
        """The lower's files, the layer's folders, and the mount point: once the replay lock is held."""
        lower = self.dir / "lower"
        (lower / "tickets").mkdir(parents=True)
        for x in ("up", "work", "view"):
            (self.dir / x).mkdir()
        if self.project is not None:
            (lower / "project").write_bytes(self.project)
        with open(self.log, "rb") as src, open(lower / "tickets" / "log.jsonl", "wb") as dst:
            left = self.bytes
            while left:
                b = src.read(min(left, 1 << 22))
                if not b:
                    raise OSError(f"{self.log} is shorter than when its line {self.lines} was taken")
                dst.write(b)
                left -= len(b)

    def wrap(self, cmd):
        """CMD run with the view mounted: in a user and mount namespace of its own, as a job's tree is, and back in a
        user namespace that maps this user's id, so the binary runs as this user."""
        d = self.dir
        opts = f"lowerdir={d}/lower,upperdir={d}/up,workdir={d}/work"
        inner = (f"mount -t overlay overlay -o {shlex.quote(opts)} {shlex.quote(str(self.path))} && "
                 f'exec unshare --map-user={os.getuid()} --map-group={os.getgid()} "$@"')
        return ["unshare", "-rm", "sh", "-c", inner, "sh", *cmd]

    def remove(self):
        remove_view(self.dir)


REPLAY_SCOPE = shlex.split(os.environ.get("BUILD_RUNNER_REPLAY_SCOPE") or "/usr/bin/systemd-run --user --scope -q -p MemoryMax={memory} --")
REPLAY_LINE = re.compile(rb"\b(\d+) problem lines?(?:, (\d+) now makes?, (\d+) now refused)?")


def replay(argv):
    """build-runner replay: a test binary run on a copy of a record as a job of its own (proto-mind N-1446 p1502, head 4:
    replays and stills write the same `act job` lines as a cargo job, verb `replay`), on this PC: the record never goes
    to the build machine, and nothing compiles (the binary is built already, `cargo test --no-run`). It waits for the
    shared replay lock (REPLAY_LOCK: one replay at a time on this PC, N-1446 p1139), runs CMD in a scope of its own with
    MemoryMax SIZE (14G), its output (stdout and stderr, one stream) passed through on stdout, and gives CMD's rc. Its
    lines: the worktree's facts (branch, commit, tree, changed, items) or, with --commit REV, REV's (the commit the
    binary was built from, when the worktree has moved on since); the tests CMD names (`tests_named`); `record`, NAME or
    REPLAY_COORD's folder name, and `lines`, its record's lines; `binary` and `binary_md5`; at the end rc, passed,
    failed, the failing names, and the replay's counts, `problem_lines`, `now_makes` and `now_refused`, the highest each
    line of its output gave (`replay ... : N problem lines, N now makes, N now refused`).
    Which way it runs (proto-mind N-1446 p1522, REPLAYED(TREE, R, WAY) at dev.eflint:136): `way` forward, the binary
    built from the job's tree on a copy of the live record; or, with --back RELEASE, back, `back` RELEASE: the way-back
    release's binary on a coord the gated tip's engine wrote (`record` names that coord; --commit TIP gives the tip's
    tree, which is not the binary's). The copies it ran on, so a reader checks they were the live project's (p1522,
    p508's "line 1 names the copy and its time"): `copy`, REPLAY_COORD's path, and `copy_at`, when its log.jsonl was
    last changed; `project`, REPLAY_PROJECT's path, and `project_at`, when that folder was. A change time (ctime), which
    cp -a does not carry over from the source as it does the mtime: for a copy nothing has written into since, the time
    it was made. The runner's own view of a live record (--record NAME, no REPLAY_COORD) is no copy a caller made, and
    its lines say so (consult-lead N-1446 p2805): `view`, the live coord folder it reads; `view_at`, when its line N was
    taken; and `copied_bytes`, what the runner copied to make the view (the cut record and the project file today; once
    the replay reads only up to REPLAY_BYTES, the record is a link and only the project file is copied)."""
    record, rev, back, memory, line = None, None, None, "14G", None
    while len(argv) > 1 and argv[0] in ("--record", "--line", "--commit", "--back", "--memory"):
        if argv[0] == "--record":
            record = argv[1]
        elif argv[0] == "--line":
            line = argv[1]
        elif argv[0] == "--commit":
            rev = argv[1]
        elif argv[0] == "--back":
            back = argv[1]
        else:
            memory = argv[1]
        argv = argv[2:]
    if argv[:1] == ["--"]:
        argv = argv[1:]
    if not argv or not re.fullmatch(r"[0-9]+[KMGT]?", memory) or back == "" or (line is not None and not line.isdigit()):
        sys.exit("build-runner replay [--record NAME [--line N]] [--commit REV] [--back RELEASE] [--memory SIZE] -- TEST_BINARY [ARGS...]")
    cwd = os.getcwd()
    if subprocess.run(["git", "-C", cwd, "rev-parse", "--show-toplevel"], capture_output=True).returncode != 0:
        # a line that names no work is one REPLAYED can never use (proto-window N-1446 p1564 point 2)
        sys.exit(f"build-runner replay: {cwd} is in no git worktree: run it from the worktree whose tree the binary is")
    wt = str(worktree_of(cwd))
    g = lambda *a: (git(wt, *a) or b"").decode().strip()
    more = {}
    if rev:
        commit, tree = g("rev-parse", "--short=8", f"{rev}^{{commit}}"), g("rev-parse", f"{rev}^{{tree}}")
        if not commit or not tree:
            sys.exit(f"build-runner replay: {rev} is no commit of {wt}")
        facts, more = {"branch": "", "commit": commit}, {"tree": tree, "changed": 0}
    else:
        facts = {"branch": g("rev-parse", "--abbrev-ref", "HEAD"), "commit": g("rev-parse", "--short=8", "HEAD")}
    more["way"], more["back"] = ("back", back) if back else ("forward", "")
    changed_at = lambda p: time.strftime("%FT%TZ", time.gmtime(os.stat(p).st_ctime))
    coord_copy = os.environ.get("REPLAY_COORD") or ""
    view = None
    if line is not None and (not record or coord_copy or back):
        sys.exit("build-runner replay: refused: --line N reads NAME's live record up to line N: give --record NAME, "
                 "and no REPLAY_COORD (a copy) and no --back")
    # the store page's check (paper-research N-1446 p2926, his p1055): no replay on a copy of a live record, which the
    # runner's own view replaces. A way-back replay goes on, on whatever coord it is given: an exemption that ends when
    # release.sh links a release's programs from the store (paper-research p2929; docket-core's commit that does it, p2935)
    if coord_copy and not back and (live := live_record_of(coord_copy)):
        sys.exit(f"build-runner replay: refused: REPLAY_COORD {coord_copy} is {live}'s live record or a copy of it: "
                 f"send --record {live} with no REPLAY_COORD (no caller's copy; the runner's view is removed when the "
                 "run ends; the store page's check, N-1446 p2926)")
    binary = shutil.which(argv[0]) or argv[0]
    try:
        binary_md5, binary_sha = file_hashes(binary)
    except OSError:
        binary_md5 = binary_sha = None
    # the store page's second check (paper-research N-1446 p2926): the binary it runs, and a binary its arguments name
    # (a script's, as the gate's snapshot `bash train-check.sh _inview ... TEST_BINARY`), is a link to this PC's store,
    # not a copy. A way-back replay's binary in a release folder (release_folder_of) goes on: an exemption that ends
    # when release.sh links a release's programs from the store (paper-research p2929; docket-core's commit, p2935).
    # With the store off nothing is linked, and the job's lines say that nothing was checked (consult-lead p2949)
    if not STORE_MODE:
        more["unchecked"] = "the store is off (BUILD_RUNNER_STORE=0)"
    for i, p in enumerate([binary] + [a for a in argv[1:] if os.path.isfile(a)] if STORE_MODE else []):
        if not built_binary(p) or (back and release_folder_of(p)):
            continue
        try:
            sha = binary_sha if i == 0 and binary_sha else file_sha256(p)
        except OSError:
            continue
        if not store_link(p, sha):
            sys.exit(f"build-runner replay: refused: {os.path.abspath(p)} is a binary outside the store, no link to the "
                     f"blob of its content ({sha[:12]}…): run the one a runner job linked from the store (in target/…, "
                     "or its --out), not a copy (the store page's check, N-1446 p2926)")
    if record and not coord_copy and not back:
        view = RecordView(record, None if line is None else int(line))
        coord_copy = str(view.path)
        os.environ.update({"REPLAY_COORD": coord_copy, "REPLAY_LINES": str(view.lines), "REPLAY_BYTES": str(view.bytes)})
    more["record"] = record or (Path(coord_copy).name if coord_copy else "")
    if view is not None:
        # the live record it reads, up to its line, when that line was taken, and what was copied to make the view: no
        # copy a caller made (consult-lead N-1446 p2805)
        more.update({"view": str(view.live), "view_at": view.at, "lines": view.lines, "copied_bytes": view.copied})
    elif coord_copy:
        more["copy"] = os.path.abspath(coord_copy)
        try:
            log = Path(coord_copy) / "tickets" / "log.jsonl"
            more["copy_at"] = changed_at(log)
            with open(log, "rb") as lf:
                more["lines"] = sum(1 for _ in lf)
        except OSError:
            pass
    if project := os.environ.get("REPLAY_PROJECT") or "":
        more["project"] = os.path.abspath(project)
        try:
            more["project_at"] = changed_at(project)
        except OSError:
            pass
    more["binary"] = os.path.abspath(binary)
    if binary_md5:
        more["binary_md5"] = binary_md5[:8]
    if view is not None:
        # the run's layer (Home's Layers now, N-1446 p2815, p2927): what lies under it and its own folder, which coordd
        # measures when asked and shows as a layer of kind "run" while the job runs; the folder goes when it ends
        under = [{"what": "record", "record": record, "line": view.lines, "bytes": view.bytes}]
        if binary_md5:
            under.append({"what": "binary", "path": os.path.abspath(binary), "md5": binary_md5[:8],
                          "bytes": os.path.getsize(binary)})
        more["layer"] = {"up": str(view.dir / "up"), "at": view.at, "under": under}
    job = JobFile({"args": ["replay", "--", *argv[1:]]}, wt, facts, job_agent(os.getpid()), caller_coord(os.getpid()),
                  more=more)
    REPLAY_LOCK.parent.mkdir(parents=True, exist_ok=True)
    st, counts, p, rc = Steps(open(os.devnull, "wb"), True), {}, None, None

    class Stopped(Exception):
        pass

    def stopped(signum, frame):
        raise Stopped(signum)

    def take(line):  # a line of the binary's: passed on, and read for its tests and the replay's three counts
        sys.stdout.buffer.write(line)
        sys.stdout.flush()
        st.test(line)
        if m := REPLAY_LINE.search(line):
            for k, v in zip(REPLAY_COUNTS, m.groups()):
                if v is not None:
                    counts[k] = max(counts.get(k, 0), int(v))

    # stopped by SIGTERM (or ^C), the job still ends: the signal goes on to the binary, and the end line says how it
    # ended (proto-window N-1446 p1564 point 1); a second SIGTERM while that binary ends is the default's again
    old = signal.signal(signal.SIGTERM, stopped)
    old = signal.SIG_DFL if old is None else old  # a handler not set from Python
    try:
        with open(REPLAY_LOCK, "a") as lock:
            job.step("waiting", what="the replay lock")
            fcntl.flock(lock, fcntl.LOCK_EX)  # flock(1)'s lock, so the scripts' `flock LOCK` and this one queue together
            if view is not None:
                try:
                    view.make()
                except OSError as e:
                    job.end({}, 1)
                    sys.exit(f"build-runner replay: the view of {record}'s record could not be made: {e}")
            job.step("replaying")
            cmd = [a.replace("{memory}", memory) for a in REPLAY_SCOPE] + (view.wrap(argv) if view is not None else argv)
            try:
                # the binary holds the lock too, as under `flock LOCK CMD`: if this runner dies alone, the lock stays
                # held until the replay has ended, and no second replay starts beside it (p1564 point 1, p1139)
                p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, pass_fds=(lock.fileno(),))
            except OSError as e:
                job.end({}, 127)
                sys.exit(f"build-runner replay: {e}")
            for line in p.stdout:
                take(line)
            rc = p.wait()
    except (Stopped, KeyboardInterrupt) as e:
        signal.signal(signal.SIGTERM, old)
        sig = e.args[0] if isinstance(e, Stopped) else signal.SIGINT
        if p is not None:
            if p.poll() is None:
                p.send_signal(sig)
            # the rest of its output read as before it was stopped: a binary that writes on as it ends can't fill the
            # pipe and wait there, and its last lines (a count line) still count (proto-window N-1446 p1576 point 1)
            for line in p.stdout:
                take(line)
        rc = p.wait() if p is not None else -sig
    finally:
        signal.signal(signal.SIGTERM, old)
        if view is not None:
            view.remove()
    if rc < 0 and p is not None:  # the binary killed by a signal (the scope execs it; at its memory cap, SIGKILL)
        try:
            sig = signal.Signals(-rc).name
        except ValueError:
            sig = "?"
        st.died.append({"binary": Steps.name_of(os.fsencode(binary)), "signal": -rc, "name": sig})
    job.end({**st.ended(), **counts}, rc)
    return rc


def main(argv):
    if argv[:1] == ["serve"]:
        Service().serve()
    elif argv[:1] == ["relay"]:
        relay()
    elif argv[:1] == ["machine-install"]:
        sys.exit(machine_install())
    elif argv[:1] == ["start"]:
        start()
    elif argv[:1] == ["restart"]:
        # the service on this file as it is now, once the running build has ended (nobody's build is stopped)
        try:
            s = socket.socket(socket.AF_UNIX)
            s.connect(str(SOCK))
        except OSError:
            s = None  # none runs: started below
        if s:
            s.sendall(json.dumps({"restart": os.path.abspath(__file__)}).encode() + b"\n")
            reply = s.makefile().read()
            sys.stdout.write(reply)
            if "build-runner: restarting" not in reply:
                sys.exit("build-runner: the running service does not know restart (a copy older than 92c01f9); "
                         "it is still the one serving")
        connect()  # the new one, once the old one's builds have ended
        pid = subprocess.run(["systemctl", "--user", "show", "-p", "MainPID", "--value", UNIT], capture_output=True, text=True)
        print(f"build-runner: restarted, pid {pid.stdout.strip()}")
        mc = machine()
        if mc:
            # the build machine runs its own copy of the two files, and a job is refused while they differ from the
            # client's: a restart onto changed files installs them there too, so the two steps are never done apart
            # (main 159c02ca restarted here alone refused every store job, paper-research N-412 p1973, 20 Nov)
            installed = os.environ.get("BUILD_RUNNER_INSTALLED_FILE") or str(_MAIN)
            if os.path.realpath(__file__) != os.path.realpath(installed):
                sys.exit(f"build-runner: this copy ({os.path.realpath(__file__)}) is not the installed runner, so the "
                         f"build machine's runner files are not checked: run {installed} restart")
            why = remote_files_differ(mc[1])
            if why == "unreachable":
                sys.exit(f"build-runner: the build machine {mc[0]} does not answer, so its runner files are not checked: "
                         f"run {_MAIN} machine-install once it answers (a job is refused there while they differ)")
            if why:
                print(f"build-runner: {mc[0]}'s runner files are not this one's: installing them there "
                      "(machine-install; it waits for the jobs running there)", file=sys.stderr)
                sys.exit(machine_install())
            print(f"build-runner: {mc[0]}'s runner files are this one's already", file=sys.stderr)
    elif argv[:1] == ["hold"]:
        args = argv[1:]
        while args[:1] == ["--train"]:
            args = args[1:]
        if args[:1] == ["--"]:
            args = args[1:]
        if not args:
            sys.exit("build-runner hold [--train] -- CMD [ARGS...]")
        sys.exit(hold_client(args))
    elif argv[:1] == ["replay"]:
        sys.exit(replay(argv[1:]))
    elif argv[:1] == ["stored"]:
        sys.exit(stored(argv[1:]))
    elif argv[:1] == ["store"]:
        sys.exit(store_cli(argv[1:]))
    elif argv[:1] == ["walk"]:
        sys.exit(walk())
    elif argv[:1] == ["free"] and len(argv) == 2:
        out = free(argv[1])
        print(json.dumps(out))
        sys.exit(1 if "error" in out else 0)
    elif argv[:1] == ["gc"]:
        store_gc(force=True)  # the store's gc now: the blobs no entry names go, then entries down to the cap
    elif argv[:1] == ["status"]:
        s = connect()
        s.sendall(b'{"status": true}\n')
        sys.stdout.write(s.makefile().read())
    elif argv[:1] == ["cargo"] and len(argv) > 1:
        out, folder, names, args = None, None, [], argv[1:]
        front = train = False
        while args[:1] in (["--front"], ["--train"]):
            front, train = front or args[0] == "--front", train or args[0] == "--train"
            args = args[1:]
        keep, no_copy, red_of = None, False, None
        while args[:1] == ["--no-copy"] or len(args) > 1 and args[0] in ("--out", "--env", "--folder", "--keep", "--red-of"):
            if args[0] == "--no-copy":
                no_copy, args = True, args[1:]
                continue
            if args[0] == "--out":
                out = args[1]
            elif args[0] == "--keep":
                keep = args[1]
            elif args[0] == "--folder":
                folder = args[1]
            elif args[0] == "--red-of":
                red_of = args[1]
            else:
                names.append(args[1])
            args = args[2:]
        env = {k: v for k, v in os.environ.items() if k in PASS or k.startswith("REPLAY_") or k in names}
        env[""] = names  # the names the caller passed on (the service lets them through)
        rc = client({"cwd": os.getcwd(), "args": args, "out": out, "folder": folder, "env": env, "front": front, "train": train,
                     "keep": keep, "no_copy": no_copy, "red_of": red_of, "steps": os.environ.get("BUILD_RUNNER_STEPS", "1") != "0",
                     "in_hold": os.environ.get("BUILD_RUNNER_HOLD"),
                     "who": os.environ.get("AGENT_NAME") or os.environ.get("USER"), "agent": os.environ.get("BUILD_RUNNER_AGENT")})
        note = outside_note(os.environ.get("AGENT_NAME"))  # the walk's finding, to its owner (N-1446 p3061)
        if note:
            print(note, file=sys.stderr)
        sys.exit(rc)
    else:
        sys.stdout.write(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv[1:])

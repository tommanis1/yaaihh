# the record's lines that are outputs: the `ev` of each variant of docket-machine's Line that `Line::is_input`
# (docket-machine/src/line.rs) does not name. A line of any other `ev` counts here as an input, so a kind the engine
# gains only moves the cut further back; runner-replay-job-test.sh checks this list against line.rs.
RECORD_OUTPUTS = frozenset((
    "halted", "opened", "step", "step_args", "asked", "posted", "replied", "refused", "reminded", "forming", "gave",
    "rests", "holds", "freed", "handling", "ask_answered", "passed_up", "stopped", "shaped", "told", "dropped",
    "released", "marked", "agent", "forked", "closed"))
# the message runtime's `event` lines that are outputs, fired nothing and on no ticket (syntax::delivery_output)
RECORD_EVENT_OUTPUTS = frozenset(("delivery_opened", "delivery_acted"))


def record_input(raw):
    """Whether RAW, one line of a record, is an input, as `Line::is_input` tells it; a line that does not read is
    none, as there."""
    try:
        m = json.loads(raw)
        ev = m["ev"]
    except (ValueError, KeyError, TypeError, IndexError):
        return False
    if not isinstance(ev, str) or ev in RECORD_OUTPUTS:
        return False
    return not (ev == "event" and not m.get("fired") and m.get("on") is None and m.get("name") in RECORD_EVENT_OUTPUTS)


def last_input(log, end):
    """(the byte where LOG's last input line before byte END starts, how many lines from it to END), read back from
    END, a line's end; None when no line there is an input."""
    pos, rest, after = end, b"", 0  # rest: the bytes from pos to the first line looked at, ending at a line's end
    with open(log, "rb") as f:
        while pos > 0:
            k = min(pos, 1 << 20)
            pos -= k
            f.seek(pos)
            rest = f.read(k) + rest
            lines = rest.split(b"\n")  # its last is the empty one after rest's last newline
            first = 0 if pos == 0 else 1  # unless at the file's start, the first may begin before pos
            off = len(rest)
            for i in range(len(lines) - 2, first - 1, -1):
                off -= len(lines[i]) + 1
                after += 1
                if record_input(lines[i]):
                    return pos + off, after
            rest = lines[0] + b"\n" if first else b""
    return None


def live_heads():
    """Each live record (RECORDS/NAME/tickets/log.jsonl): NAME -> (its first 4 KB, its file's stat), read once for a
    check of many files (the walk) as for one (live_record_of)."""
    out = {}
    try:
        lives = sorted(RECORDS.iterdir())
    except OSError:
        return out
    for d in lives:
        try:
            with open(d / "tickets" / "log.jsonl", "rb") as f:
                out[d.name] = (f.read(4096), os.fstat(f.fileno()))
        except OSError:
            continue
    return out


def record_copy_of(log, heads):
    """NAME when LOG is NAME's live record (the same file, past links) or a copy of it, cut or whole: it starts with
    the same bytes as the live one (HEADS, live_heads), over its first 4 KB, or over all of a shorter copy that holds
    a whole line; else None. A stand-in record (a test's, a leg's own) is no live one's."""
    try:
        with open(log, "rb") as f:
            head, st = f.read(4096), os.fstat(f.fileno())
    except OSError:
        return None
    if len(head) < 4096 and b"\n" not in head:
        return None
    for name, (live, lst) in heads.items():
        if (st.st_dev, st.st_ino) == (lst.st_dev, lst.st_ino) or live[:len(head)] == head:
            return name
    return None


def live_record_of(coord):
    """NAME when COORD is NAME's live coord folder (RECORDS/NAME) or holds a copy of its record (record_copy_of: its
    tickets/log.jsonl); else None."""
    return record_copy_of(Path(coord) / "tickets" / "log.jsonl", live_heads())


# the store page's second check (paper-research N-1446 p2926): a program of the system's, or of a tool installed in
# its own folder of HOME (TOOL_FOLDERS, each named: a copy of ours under another dot-folder is checked; consult-lead
# p2949), is no build of ours, and the check passes it
SYSTEM_PROGRAMS = re.compile(r"/(usr|bin|sbin|lib|lib32|lib64|libx32|opt|snap|nix)/|/mnt/[a-z]/(Windows|Program Files[^/]*)/")
TOOL_FOLDERS = {".bun", ".cabal", ".cargo", ".deno", ".elan", ".ghcup", ".local", ".nvm", ".opam", ".pyenv", ".rustup", ".stack"}


def release_folder_of(p):
    """The release folder P (past its links) lies in, else None: a folder of a `releases` folder that holds its
    built-from.sha256, as every release release.sh makes does (not a word in a path; consult-lead p2949)."""
    for d in Path(os.path.realpath(p)).parents:
        if d.parent.name == "releases" and (d / "built-from.sha256").is_file():
            return d
    return None


def built_binary(p):
    """P, past its links, is a binary a build of ours made: an ELF file or a Windows PE (the window's exe), and no
    system program (SYSTEM_PROGRAMS, a tool's folder of HOME, TOOL_FOLDERS). Scripts and folders are not."""
    real = os.path.realpath(p)
    try:
        if not os.path.isfile(real):
            return False
        with open(real, "rb") as f:
            magic = f.read(4)
    except OSError:
        return False
    if (magic != b"\x7fELF" and magic[:2] != b"MZ") or SYSTEM_PROGRAMS.match(real):
        return False
    rel = os.path.relpath(real, Path.home())
    return rel.startswith("..") or rel.split(os.sep)[0] not in TOOL_FOLDERS


def store_link(p, sha=None):
    """The blob of this PC's store that P (past its links) is a hard link of: the one its content names (sha256, `.x`
    when executable, as take_back links what a job made). None for a copy, or content no blob holds."""
    try:
        sha = sha or file_sha256(p)
    except OSError:
        return None
    for name in (sha + ".x", sha):
        b = STORE_DIR / "blobs" / sha[:2] / name
        try:
            if os.path.samefile(p, b):
                return b
        except OSError:
            continue
    return None


def file_hashes(p):
    """P's md5 and sha256, in one read."""
    m, s = hashlib.md5(), hashlib.sha256()
    with open(p, "rb") as f:
        for blk in iter(lambda: f.read(1 << 20), b""):
            m.update(blk)
            s.update(blk)
    return m.hexdigest(), s.hexdigest()


def stored(paths):
    """build-runner stored PATH...: each PATH, and each binary a folder PATH holds (built_binary: no script, no text),
    is a hard link to this PC's store (store_link), not a copy; for release.sh, which links a release's programs from
    the store and checks the release folder with it before the release counts as made (docket-core N-1446 p2935).
    rc 0 when every one is; else 1, with a line for each one that is not."""
    if not paths:
        return "build-runner stored PATH...: each PATH, and each binary a folder holds, is a link to this PC's store"
    files, bad = [], []
    for p in paths:
        if os.path.isdir(p):
            for dp, dns, fns in os.walk(p):
                dns.sort()
                files += [os.path.join(dp, f) for f in sorted(fns) if built_binary(os.path.join(dp, f))]
        elif os.path.isfile(p):
            files.append(p)
        else:
            bad.append(f"{p}: not there")
    for f in files:
        if not store_link(f):
            bad.append(f"{f}: not in the store (a copy, or content no blob of {STORE_DIR / 'blobs'} holds)")
    for line in bad:
        print(f"build-runner stored: {line}", file=sys.stderr)
    if bad:
        return 1
    print(f"build-runner stored: {len(files)} files, each a link to this PC's store")
    return 0


# the store page's walk (paper-research N-1446 p2926, D3; plan p2928, answers p2929): what lies outside the store in
# the agents' folders, found by a walk over each agent's scratch folder and each worktree, written to OUTSIDE for
# Home's "Outside the store" row (`store outside`). It deletes nothing.
WALK_SCRATCH = Path(os.environ.get("BUILD_RUNNER_WALK_SCRATCH") or RECORDS / "docket-try-saved")
WALK_REPOS = [Path(x) for x in (os.environ.get("BUILD_RUNNER_WALK_REPOS")
                                or str(Path.home() / "Documents" / "papers" / "soft-swarm")).split(":") if x]
WALK_OWNERS = HOME / "walk-owners.json"  # {folder: owner}, the owners no rule finds (main's own: paper-research's, p2928)
OUTSIDE = HOME / "outside.json"
OUTSIDE_SEC = int(os.environ.get("BUILD_RUNNER_WALK_SEC") or 3600)  # the service walks at most this often
OUTSIDE_OVER = 2**30  # an agent's folder over this is a finding of its own
OUTSIDE_BINARY = 2**20  # a binary this big or more, outside a target folder and the store, is one


# what the walk never opens nor goes into: coordd's "never served" (files.rs never_served), the same names: a
# repository's own folder, a coord's keys and homes (and what is named from one of them), a coord's own `route`, the
# browser's profile, the owner's logins and settings (consult-lead N-1446 p3077)
NEVER_WALKED = (".proxy-key", "telemetry.token", "envdir", "claude-home", "codex-home", "claude-settings.json",
                ".claude", ".codex", ".ssh", ".config")


def never_walked(dp, name):
    """NAME in folder DP is one the walk never opens nor goes into (NEVER_WALKED)."""
    if name == ".git" or name.startswith(NEVER_WALKED):
        return True
    if name == "route" and os.path.exists(os.path.join(dp, "registry.jsonl")):  # a coord's own route
        return True
    return name == "ffprof" and dp.endswith(os.path.join("box", "run"))


def walk_projects():
    """Each project of this PC (the owner's walk, items 20 and 23: what takes space, a project's and the whole
    installation's): a coord folder RECORDS/NAME whose `project` file names its project.toml. {id, coord, repos,
    agents}: its folder, the paths of its `repos` (and `repo`), and the agents its registry ever added."""
    import tomllib
    out = []
    try:
        coords = sorted(d for d in RECORDS.iterdir() if d.is_dir() and not d.is_symlink())
    except OSError:
        return out
    for d in coords:
        try:
            toml = Path((d / "project").read_text().strip())
            t = tomllib.loads(toml.read_text())
        except (OSError, ValueError):
            continue
        pt = t.get("project") if isinstance(t.get("project"), dict) else {}
        repos = pt.get("repos") if isinstance(pt.get("repos"), dict) else {}
        paths = [os.path.expanduser(v) for v in repos.values() if isinstance(v, str)]
        agents = set()
        try:
            with open(d / "registry.jsonl", "rb") as f:
                for line in f:
                    if b'"ev":"add"' in line:
                        try:
                            agents.add(json.loads(line).get("name"))
                        except ValueError:
                            pass
        except OSError:
            pass
        repos = [Path(x) for x in dict.fromkeys(paths)]
        out.append({"id": d.name, "coord": d, "repos": repos, "commons": {git_common(x) for x in repos} - {""},
                    "agents": agents - {None}})
    return out


def git_common(path):
    """The repository PATH is a worktree of, as its main worktree's folder (`git rev-parse --git-common-dir`); "" when
    PATH is no git worktree."""
    common = subprocess.run(["git", "-C", str(path), "rev-parse", "--path-format=absolute", "--git-common-dir"],
                            capture_output=True, text=True).stdout.strip()
    return os.path.dirname(common) if common.endswith("/.git") else common


def walk_roots(projects=None):
    """(kind, folder) of each folder the walk looks in: each agent's scratch folder (WALK_SCRATCH/AGENT, `scratch`),
    each worktree of WALK_REPOS and of each project's repositories (`worktree`), and each project's own coord folder
    (`coord`: its record, notes and runs; its homes and keys never walked), each once."""
    roots, seen = [], set()
    try:
        roots += [("scratch", d) for d in sorted(WALK_SCRATCH.iterdir()) if d.is_dir() and not d.is_symlink()]
    except OSError:
        pass
    projects = walk_projects() if projects is None else projects
    for pr in projects:
        if str(pr["coord"]) not in seen:
            seen.add(str(pr["coord"]))
            roots.append(("coord", pr["coord"]))
    for repo in dict.fromkeys([*WALK_REPOS, *(x for pr in projects for x in pr["repos"])]):
        out = subprocess.run(["git", "-C", str(repo), "worktree", "list", "--porcelain"], capture_output=True,
                             text=True).stdout
        for line in out.splitlines():
            if line.startswith("worktree ") and os.path.isdir(line[9:]) and line[9:] not in seen:
                seen.add(line[9:])
                roots.append(("worktree", Path(line[9:])))
    return roots


def folder_project(kind, root, owner, projects):
    """The project ROOT is of: a coord folder's own; a worktree's, a project one of whose repositories is a worktree of
    the same repository ([`git_common`]), one whose registry added OWNER first; else the first project whose registry
    added OWNER; else "". A hint: the window, which knows its projects' agents, groups by the owner first."""
    if kind == "coord":
        return next((pr["id"] for pr in projects if pr["coord"] == root), "")
    common = git_common(root) if kind == "worktree" else ""
    repo = [pr["id"] for pr in projects if common and common in pr["commons"]]
    mine = [pr["id"] for pr in projects if owner and owner in pr["agents"]]
    return next((x for x in repo if x in mine), None) or next(iter(repo), None) or next(iter(mine), "")


def folder_owner(kind, root, fixed, made):
    """The agent ROOT is whose: FIXED's (WALK_OWNERS); a scratch folder's own name; for a worktree, who had the runner's
    newest job whose files take_back linked into it (MADE: the binaries' index, folder -> who), else the `Agent:`
    trailer of its last commit; else empty."""
    if str(root) in fixed:
        return fixed[str(root)]
    if kind == "scratch":
        return root.name
    if kind == "coord":
        return ""
    if made.get(str(root)):
        return made[str(root)]
    return subprocess.run(["git", "-C", str(root), "log", "-1", "--format=%(trailers:key=Agent,valueonly,separator=%x2C)"],
                          capture_output=True, text=True).stdout.strip()


def is_target(t):
    """Folder T is cargo's build folder: it holds cargo's CACHEDIR.TAG, or sits beside a Cargo.toml (not a source
    folder that is only named `target`; docket-edge5 N-1446 p3111)."""
    return os.path.isfile(os.path.join(t, "CACHEDIR.TAG")) or os.path.isfile(os.path.join(os.path.dirname(t), "Cargo.toml"))


def walk_folder(root, roots, heads, live, blobs):
    """What ROOT holds outside the store: its items (record copies, binaries, target folders; each {what, path, bytes}),
    its size on disk outside the store (a link of a blob counts nothing) and how many files it has. A folder of ROOTS
    inside it is walked as its own; .git is not walked; a file that is a link of a blob (BLOBS, their device and
    inode) is in the store; a live record (LIVE) is no copy."""
    import stat
    items, targets, total, n = [], {}, 0, 0
    for dp, dns, fns in os.walk(root):
        dns[:] = sorted(x for x in dns if not never_walked(dp, x) and os.path.join(dp, x) not in roots)
        parts = os.path.relpath(dp, root).split(os.sep)
        target = next((t for i, x in enumerate(parts) if x == "target" and is_target(t := os.path.join(root, *parts[:i + 1]))), None)
        for fn in sorted(fns):
            if never_walked(dp, fn):
                continue
            f = os.path.join(dp, fn)
            try:
                st = os.lstat(f)
            except OSError:
                continue
            if not stat.S_ISREG(st.st_mode):
                continue
            n, size, ino = n + 1, st.st_blocks * 512, (st.st_dev, st.st_ino)
            if ino in blobs:
                continue
            total += size  # the disk the folder's owner can free: a link of a store blob uses none (docket-edge5 p3111)
            if target:
                t = targets.setdefault(target, [0, 0])
                t[0] += size
                t[1] += 1
            elif fn.endswith(".jsonl") and ino not in live and (of := record_copy_of(f, heads)):
                items.append({"what": "copy", "path": f, "of": of, "bytes": size})
            elif st.st_size >= OUTSIDE_BINARY and built_binary(f):
                items.append({"what": "binary", "path": f, "bytes": size, **({"release": True} if release_folder_of(f) else {})})
    items += [{"what": "target", "path": t, "bytes": b, "files": k} for t, (b, k) in targets.items()]
    if total > OUTSIDE_OVER:
        items.append({"what": "folder", "path": str(root), "bytes": total})
    items.sort(key=lambda x: (-x["bytes"], x["path"]))
    return items, total, n


def walk():
    """build-runner walk: the store page's walk now (the service's at most every OUTSIDE_SEC, walk_hourly), written to
    OUTSIDE whole: each folder that holds anything outside the store, with its owner, its counts and bytes, and its
    items, the largest first. Each item keeps `since`, the walk that first found it, so a new or changed finding is
    told from one found before."""
    t0 = time.time()
    heads = live_heads()
    live = {(st.st_dev, st.st_ino) for _, st in heads.values()}
    blobs = {(st.st_dev, st.st_ino) for st in blob_stats().values()}
    projects = walk_projects()
    roots = walk_roots(projects)
    under = {str(r) for _, r in roots}
    try:
        fixed = json.loads(WALK_OWNERS.read_text())
    except (OSError, ValueError):
        fixed = {}
    made = {}
    # every line oldest first, across blobs (the index is grouped by blob, and trim_index writes it so): the newest
    # job's who wins (docket-edge5 N-1446 p3111)
    for x in sorted((x for xs in binaries_index().values() for x in xs), key=lambda x: x.get("at") or 0):
        r = max((u for u in under if (x.get("dest") or "").startswith(u + "/")), key=len, default=None)
        if r and x.get("who"):
            made[r] = x["who"]
    try:
        before = {f["path"]: {(i["what"], i["path"]): i.get("since") for i in f.get("items", [])}
                  for f in json.loads(OUTSIDE.read_text()).get("folders", [])}
    except (OSError, ValueError, KeyError, TypeError):
        before = {}
    now, folders, files, counted, total = iso(t0), [], 0, set(), 0
    for kind, root in roots:
        items, size, n = walk_folder(root, under, heads, live, blobs)
        files += n
        if not items:
            continue
        was = before.get(str(root), {})
        for i in items:
            i["since"] = was.get((i["what"], i["path"])) or now
        count = lambda w: sum(1 for i in items if i["what"] == w)
        out = sum(i["bytes"] for i in items if i["what"] != "folder")
        owner = folder_owner(kind, root, fixed, made)
        folders.append({"path": str(root), "kind": kind, "owner": owner, "project": folder_project(kind, root, owner, projects),
                        "copies": count("copy"), "binaries": count("binary"), "targets": count("target"),
                        "bytes": out, "folder_bytes": size, "over": size > OUTSIDE_OVER,
                        "changed": max(i["since"] for i in items), "items": items})
        total += out
    folders.sort(key=lambda f: (-f["bytes"], -f["folder_bytes"], f["path"]))
    # each project's part, the largest first, and the folders no project names ("")
    by = {}
    for f in folders:
        b = by.setdefault(f["project"], {"id": f["project"], "bytes": 0, "folder_bytes": 0, "folders": 0})
        b["bytes"] += f["bytes"]
        b["folder_bytes"] += f["folder_bytes"]
        b["folders"] += 1
    a = {"at": now, "took_sec": round(time.time() - t0, 1), "walked": {"folders": len(roots), "files": files},
         "total_bytes": total, "folder_bytes": sum(f["folder_bytes"] for f in folders),
         "projects": sorted(by.values(), key=lambda x: (-x["folder_bytes"], x["id"])), "folders": folders}
    tmp = OUTSIDE.with_name(f".{OUTSIDE.name}.{os.getpid()}")
    HOME.mkdir(parents=True, exist_ok=True)
    tmp.write_text(json.dumps(a))
    os.replace(tmp, OUTSIDE)
    print(f"build-runner walk: {len(roots)} folders, {files} files in {a['took_sec']} s; outside the store "
          f"{total / 2**30:.1f} GB in {len(folders)} folders; {OUTSIDE}")
    return 0


def walk_hourly():
    """The service's walk: `build-runner walk` at most every OUTSIDE_SEC, as a process of its own at idle priority, its
    processor and its disk both (nice 19, ionice idle), so no build waits on it; only where the scratch folders are
    (this PC, not the build machine)."""
    while True:
        try:
            age = time.time() - OUTSIDE.stat().st_mtime
        except OSError:
            age = OUTSIDE_SEC
        if age >= OUTSIDE_SEC:
            try:
                r = subprocess.run(["/usr/bin/nice", "-n", "19", "/usr/bin/ionice", "-c", "3", sys.executable, "-I",
                                    SERVE_FILE, "walk"], capture_output=True, text=True, timeout=OUTSIDE_SEC)
                log((r.stdout or r.stderr).strip()[-300:] or f"walk: rc {r.returncode}")
            except (OSError, subprocess.TimeoutExpired) as e:
                log(f"walk: {e}")
            age = 0
        time.sleep(max(60, OUTSIDE_SEC - age))


OUTSIDE_TOLD = HOME / "outside-told.json"  # {agent: the newest `changed` of its folders its job's output last named}


def outside_note(agent):
    """The line a job of AGENT ends with when the last walk found something new or changed in AGENT's folders since its
    jobs last said so (OUTSIDE_TOLD), else None: the walk's finding where the folder's owner sees it, in nobody's name
    and waking nobody (paper-research N-1446 p3061, (2) of p2981). Told once per change."""
    import fcntl
    try:
        a = json.loads(OUTSIDE.read_text())
    except (OSError, ValueError):
        return None
    mine = [f for f in a.get("folders", []) if agent and f.get("owner") == agent]
    if not mine:
        return None
    newest = max(f.get("changed", "") for f in mine)
    try:
        with open(HOME / ".outside-told.lock", "a") as lk:
            fcntl.flock(lk, fcntl.LOCK_EX)
            try:
                told = json.loads(OUTSIDE_TOLD.read_text())
            except (OSError, ValueError):
                told = {}
            if told.get(agent, "") >= newest:
                return None
            told[agent] = newest
            tmp = OUTSIDE_TOLD.with_name(f".{OUTSIDE_TOLD.name}.{os.getpid()}")
            tmp.write_text(json.dumps(told))
            os.replace(tmp, OUTSIDE_TOLD)
    except OSError:
        return None
    n = lambda k: sum(f.get(k, 0) for f in mine)
    parts = [f"{n(k)} {w}" for k, w in (("copies", "record copies"), ("binaries", "binaries"), ("targets", "target folders")) if n(k)]
    over = sum(1 for f in mine if f.get("over"))
    parts += [f"{over} folder{'s' if over > 1 else ''} over 1 GB"] if over else []
    return (f"build-runner: your folders hold {n('bytes') / 2**30:.1f} GB outside the store ({', '.join(parts)}; in "
            f"{len(mine)} folder{'s' if len(mine) > 1 else ''}, the walk of {a.get('at')}): `build-runner store outside` "
            "lists them; look at each first: a target folder can go, a record copy is yours to judge (the store page, "
            "N-1446 p2926)")


def outside_row():

def machine():
    """(NAME, USER@HOST, SETTINGS) of the build machine named in HOME/machines, else None (this PC's own runner
    serves). A setting is a word after the host: `twice`, each miss compiled twice and stored only when both agree
    (paper-research N-412 p1342; on for yaaihh-build-1 until the host's log clears its memory)."""
    if os.environ.get("BUILD_RUNNER_TRUST_AGENT") == "1" or os.environ.get("BUILD_RUNNER_LOCAL") == "1":
        return None  # the runner on the machine itself, or a test of this PC's own
    try:
        for line in MACHINES.read_text().splitlines():
            w = line.split("#", 1)[0].split()
            if len(w) >= 2 and re.fullmatch(r"[A-Za-z0-9_.-]+", w[0]) and re.fullmatch(r"[a-z_][a-z0-9_-]*@[A-Za-z0-9_.-]+", w[1]):
                return w[0], w[1], frozenset(w[2:])
    except OSError:
        pass
    return None


def ssh_argv(host):
    over = os.environ.get("BUILD_RUNNER_SSH")  # a test's stand-in for ssh (no sshd): it is given HOST and the command
    if over:
        return [over, host]
    k = Path(os.environ.get("BUILD_RUNNER_MACHINE_DIR") or HOME)  # a test's home uses the runner's key and host key
    return ["ssh", "-F", "none", "-i", str(k / "machine-key"), "-o", "IdentitiesOnly=yes", "-o", "IdentityAgent=none",
            "-o", "ForwardAgent=no", "-o", f"UserKnownHostsFile={k / 'known_hosts'}", "-o", "StrictHostKeyChecking=yes",
            "-o", "BatchMode=yes", "-o", "ServerAliveInterval=30", "-o", "ConnectTimeout=20", host]


def rsync(host, args, out=None):
    """rsync over the machine's ssh; True when it went. Its output appended to OUT, when given."""
    e = " ".join(shlex.quote(x) for x in ssh_argv(host)[:-1])
    r = subprocess.run(["rsync", "-a", "--no-links", "--mkpath", "-e", e, *args], capture_output=True, text=True)
    if r.returncode != 0:
        sys.stderr.write(f"build-runner: rsync to the build machine: {r.stderr.strip()[-300:]}\n")
    if out is not None:
        out.append(r.stdout)
    return r.returncode == 0


def tracked(top, prefix=""):
    r = subprocess.run(["git", "-C", str(top), "ls-files", "-c", "-z"], capture_output=True)
    return [prefix + x.decode(errors="replace") for x in r.stdout.split(b"\0") if x] if r.returncode == 0 else []


def tree_list(wt):
    """What of the worktree goes: its tracked files, those of the repositories nested in it (flavor/, proxy/), and
    each .cargo/config.toml by name (the local patches); NEVER_SENT refused."""
    wt = Path(wt)
    files = tracked(wt)
    for d in sorted(wt.iterdir()):
        if d.is_dir() and not d.is_symlink() and (d / ".git").exists():
            files += tracked(d, d.name + "/")
    for c in [wt / ".cargo/config.toml", *wt.glob("*/.cargo/config.toml")]:
        if c.is_file() and not c.is_symlink():
            files.append(str(c.relative_to(wt)))
    return sorted({f for f in files if not NEVER_SENT.search(f) and ".." not in f.split("/")})


def send_tree(host, wt):
    """The worktree by content (piece B of the storage page, N-1446 p2727): what of it goes (tree_list), each plain file
    by its sha256 (`.x` when executable; a link never went, rsync's --no-links). The contents the machine's store lacks
    go once each, into a folder of this send's own there (store/incoming/ID), rsync passing over each name its src/
    holds already; nothing is written at the worktree's path there. The tree for the job's request ({files: [[path,
    sha256, executable]], incoming: ID}) with how many files and bytes went (`sent`, `bytes`), or None when the machine
    did not answer."""
    files = []
    for rel in tree_list(wt):
        q = os.path.join(wt, rel)
        try:
            st = os.lstat(q)
            if (st.st_mode & 0o170000) == 0o100000:
                files.append([rel, file_sha256(q), bool(st.st_mode & 0o111)])
        except OSError:
            continue
    HOME.mkdir(parents=True, exist_ok=True)
    stage = Path(tempfile.mkdtemp(prefix=".tree-", dir=HOME))
    try:
        for rel, sha, ex in files:  # each content once, by its name: a link to the worktree's file, else a copy
            n = sha + (".x" if ex else "")
            (stage / n[:2]).mkdir(exist_ok=True)
            if not (stage / n[:2] / n).exists():
                try:
                    os.link(os.path.join(wt, rel), stage / n[:2] / n)
                except OSError:
                    shutil.copyfile(os.path.join(wt, rel), stage / n[:2] / n)
        inc, out = f"{int(time.time())}-{os.urandom(6).hex()}", []
        if not rsync(host, ["--size-only", f"--compare-dest={REMOTE_HOME}/store/src/", "--stats", f"{stage}/",
                            f"{host}:{REMOTE_HOME}/store/incoming/{inc}/"], out):
            return None
    finally:
        shutil.rmtree(stage, ignore_errors=True)
    def num(what):  # a count rsync's --stats gave
        m = re.search(rf"{what}: ([0-9,]+)", out[0] if out else "")
        return int(m.group(1).replace(",", "")) if m else 0
    return {"files": files, "incoming": inc, "sent": num("Number of regular files transferred"),
            "bytes": num("Total transferred file size")}


def send(host, wt, cwd, req):
    """The worktree by content (send_tree), the path packages and the registry's sources to the machine: the tree for
    the job's request, or None when the machine did not answer."""
    lockd = HOME / "machine-locks"
    lockd.mkdir(parents=True, exist_ok=True)
    tree = send_tree(host, wt)
    if tree is None:
        return None
    with open(lockd / "shared.lock", "a") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        for pkg in PATH_PACKAGES:
            if os.path.isdir(pkg):
                with tempfile.NamedTemporaryFile("w", dir=lockd, suffix=".list") as inc:
                    inc.write("".join(f"/{f}\n" for f in tracked(pkg) if not NEVER_SENT.search(f)))
                    inc.flush()
                    if not rsync(host, ["--delete", "--delete-excluded", "--prune-empty-dirs", "--include=*/",
                                        f"--include-from={inc.name}", "--exclude=*", f"{pkg}/", f"{host}:{pkg}/"]):
                        return None
        for c in ("registry/cache", "registry/index", "git"):  # sources only: never credentials nor config.toml
            if (CARGO_HOME / c).is_dir() and not rsync(host, [f"{CARGO_HOME / c}/", f"{host}:/home/t/.cargo/{c}/"]):
                return None
    return tree


def unsendable(wt, cwd, req):
    """Why the worktree is not sent (a sync to the same path there deletes what is not tracked here), else None."""
    top = subprocess.run(["git", "-C", wt, "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    if top.returncode != 0 or os.path.realpath(top.stdout.strip()) != os.path.realpath(wt):
        return (f"{cwd} is in no git worktree: only a worktree's tracked files go to the build machine, so nothing of "
                "a folder outside git can build there")
    rwt = os.path.realpath(wt)
    for r in MACHINE_OWN + MACHINE_TOPS:
        if rwt == r or r.startswith(rwt + "/") or (r in MACHINE_OWN and rwt.startswith(r + "/")):
            return f"{wt} is, holds or is inside the build machine's own folder {r}: it is never synced"
    for opt in ("out", "keep"):
        if req.get(opt):
            rp = os.path.relpath(os.path.realpath(os.path.join(cwd, req[opt])), rwt)
            if rp == "." or (rp.startswith("..") and not (opt == "keep" and lsp_keep(cwd, req))):
                return f"--{opt} {req[opt]}: a folder inside the worktree, not its top (it comes back from the machine whole)"
            if opt == "keep" and not rp.startswith(".."):
                return (f"--keep {req[opt]}: a folder inside the worktree: on the build machine a job's tree is a layer of "
                        "its own that goes when it ends, so nothing is kept in it; keep under $COORD/lsp/")
    return None


def lsp_keep(cwd, req):
    """The --keep folder when it is under the caller's coord's lsp/ (hs-ls's server, the symbols kind): made there at
    the same path and brought back to it; else None."""
    k = req.get("keep") and os.path.realpath(os.path.join(cwd, req["keep"]))
    c = caller_coord(os.getpid())
    if not k or not c or not writable_for(k, "/nonexistent", c) or Path(k) == Path(os.path.realpath(c)) / "lsp":
        return None  # a folder inside lsp/, never lsp/ itself (its sockets are there)
    return k


def own_files():
    me = Path(os.path.abspath(__file__))
    return [me, me.with_name("build-store-rustc")]


def remote_files_differ(host):
    """None when the machine's runner files are this client's; else the words. None of this client goes there: the
    machine's two files are installed by the release step (`build-runner machine-install`, docket-core3 p1346)."""
    r = subprocess.run(ssh_argv(host) + [f"sha256sum {REMOTE_LIB}/build-runner {REMOTE_LIB}/build-store-rustc"],
                       capture_output=True, text=True)
    if r.returncode == 255:
        return "unreachable"
    there = {Path(l.split()[1]).name: l.split()[0] for l in r.stdout.splitlines() if len(l.split()) == 2}
    here = {p.name: hashlib.sha256(p.read_bytes()).hexdigest() for p in own_files()}
    if there != here:
        return (f"the build machine's runner files ({REMOTE_LIB}) are not this runner's ({os.path.abspath(__file__)}): "
                + ", ".join(f"{n} {here[n][:12]} here, {there.get(n, 'none')[:12]} there" for n in sorted(here)
                            if there.get(n) != here[n])
                + "; the job is not sent. yaaihh installs them with the runner's release: say so to whoever gave you "
                "the task")
    return None


def machine_install():
    """build-runner machine-install: this file and its build-store-rustc to the build machine's runner folder, then its
    runner restarted on them (once no hold runs there): the release step, as the runner is installed here."""
    # only from the installed runner, the file this PC's service runs, never a worktree's copy: a branch's
    # build-store-rustc on the machine changes the store's rules for every job (docket-core3 N-412 p1398)
    # BUILD_RUNNER_INSTALLED_FILE is for the runner's own tests only (their copy stands as the installed one); it is
    # no way past this refusal, and the release never sets it
    installed = os.environ.get("BUILD_RUNNER_INSTALLED_FILE") or str(_MAIN)
    if os.path.realpath(__file__) != os.path.realpath(installed):
        sys.exit(f"build-runner: refused: machine-install runs only from the installed runner ({installed}), not "
                 f"{os.path.realpath(__file__)}")
    mc = machine()
    if not mc:
        sys.exit("build-runner: no build machine named in " + str(MACHINES))
    name, host, _ = mc
    if not rsync(host, ["--checksum", *map(str, own_files()), f"{host}:{REMOTE_LIB}/"]):
        sys.exit(1)
    why = remote_files_differ(host)
    if why:
        sys.exit(f"build-runner: {why}")
    rc = subprocess.run(ssh_argv(host) + [Remote.env_cmd("restart")]).returncode
    print(f"build-runner: {name}'s runner files are this one's; its restart rc {rc}", file=sys.stderr)
    unit, text = Remote.boot_unit()
    d = ".config/systemd/user"  # the machine's user's own, under its home
    brc = subprocess.run(ssh_argv(host) + [f"mkdir -p {d} && cat >{d}/{unit}.new && mv {d}/{unit}.new {d}/{unit} && "
                                           f"systemctl --user daemon-reload && systemctl --user enable -q {unit}"],
                         input=text.encode()).returncode
    print(f"build-runner: {name} starts its runner at boot ({unit} enabled): rc {brc}", file=sys.stderr)
    return rc or brc


def bring_back(host, wt, cwd, req):
    """--keep's folder under $COORD/lsp/, made by the job there, into the same folder here, links refused. The files
    the job made come by content (take_back); no tree of a worktree is kept there (send_tree), so a --keep inside one
    is refused (unsendable)."""
    k = lsp_keep(cwd, req)
    return not k or rsync(host, [f"{host}:{k}/", f"{k}/"])  # the runner there made it at the job's start


class Remote:
    """A connection to the machine's runner: `build-runner relay` there, over ssh; reads and writes as the socket's
    file does."""
    @staticmethod
    def renv():
        renv = {**REMOTE_ENV, "BUILD_RUNNER_FILE": f"{REMOTE_LIB}/build-runner"}  # the machine's runner is its installed file
        for k in ("HOME", "UNIT", "TRAIN_AGENTS"):  # a test's runner there, beside the real one
            if os.environ.get(f"BUILD_RUNNER_REMOTE_{k}"):
                renv[f"BUILD_RUNNER_{k}"] = os.environ[f"BUILD_RUNNER_REMOTE_{k}"]
        return renv

    @staticmethod
    def env_cmd(verb):
        return "env " + " ".join(f"{k}={shlex.quote(v)}" for k, v in Remote.renv().items()) + \
            f" python3 -I {REMOTE_LIB}/build-runner {verb}"

    @staticmethod
    def boot_unit():
        """(NAME, TEXT): the machine's user unit that starts its runner at the machine's boot (the user `build` lingers),
        so a restart of the build machine needs nothing from this PC (paper-research N-412 p1721). A oneshot running
        `build-runner start`, which starts the runner's own unit as this PC's restart does."""
        renv = Remote.renv()
        bad = [k for k, v in renv.items() if any(c in v for c in '"\\%$\n')]
        if bad:
            sys.exit(f"build-runner: a setting for the build machine holds a character its unit file cannot carry: {bad}")
        name = f"{renv['BUILD_RUNNER_UNIT']}-boot.service"
        text = ("[Unit]\nDescription=the build runner, started at boot (build-runner machine-install)\n"
                "\n[Service]\nType=oneshot\n"
                + "".join(f'Environment="{k}={v}"\n' for k, v in renv.items())
                + f"ExecStart=/usr/bin/python3 -I {REMOTE_LIB}/build-runner start\n\n[Install]\nWantedBy=default.target\n")
        return name, text

    def __init__(self, host):
        self.p = subprocess.Popen(ssh_argv(host) + [self.env_cmd("relay")], stdin=subprocess.PIPE, stdout=subprocess.PIPE, bufsize=0)
        self.lock, self.beating = threading.Lock(), False

    def write(self, b):
        with self.lock:
            self.p.stdin.write(b)
            self.p.stdin.flush()
        if not self.beating:  # after the request: its line is the first the service reads
            self.beating = True
            threading.Thread(target=self.beat, daemon=True).start()

    def beat(self):
        """A blank line each BEAT_SEC until the link is closed: the relay there knows by them that this caller is still
        here, and ends the connection (its job stopped) when they stop coming (relay)."""
        while True:
            time.sleep(BEAT_SEC)
            try:
                with self.lock:
                    self.p.stdin.write(b"\n")
                    self.p.stdin.flush()
            except (OSError, ValueError):
                return

    def __iter__(self):
        return iter(self.p.stdout.readline, b"")

    def close(self):
        try:
            with self.lock:
                self.p.stdin.close()
        except OSError:
            pass
        self.p.wait()


def remote_req(req):
    """The request as the machine's runner takes it: the worktree and its git facts (no .git goes there) and the
    caller's agent as coordd placed it here."""
    wt = str(worktree_of(req["cwd"]))
    git_ = lambda *a: subprocess.run(["git", "-C", wt, *a], capture_output=True, text=True).stdout.strip()
    return wt, {**req, "wt": wt, "git": {"branch": git_("rev-parse", "--abbrev-ref", "HEAD"),
                                         "commit": git_("rev-parse", "--short=8", "HEAD")},
                "agent": caller_agent(os.getpid()), "coord": caller_coord(os.getpid())}


def red_needs_steps(req):
    """The words --red-of is refused with when steps are off (BUILD_RUNNER_STEPS=0): a red says itself only in its
    job's lines, which steps off writes none of, so it would run as a job that is no red (proto-window N-1446 p1565
    point 2); else None."""
    if req.get("red_of") and not req.get("steps"):
        return (f"--red-of {req['red_of']} with BUILD_RUNNER_STEPS=0: a red says what it takes out only in its job's "
                "lines, and with steps off there are none; run it with steps on")
    return None


def refused_here(job, why):
    """A job this client refuses before the machine runs it (the worktree not sendable, the machine's runner files not
    this client's): its file and line end as the service's refusals end them (`refusal`: rc 3 and the words, so the
    record says it was refused and why; proto-mind N-1446 p1502, head 2), and the caller gets 3, as from those."""
    if job is not None:
        job.end({"refused": why}, 3)
    print(f"build-runner: refused: {why}", file=sys.stderr)
    sys.exit(3)


def remote_wait(name, host, what, job=None):
    told = False
    while True:
        why = remote_files_differ(host)
        if why is None:
            return
        if why != "unreachable":
            refused_here(job, why)
        if job is not None:
            job.step("unreachable")
        if not told:
            print(f"build-runner: the build machine {name} ({host}) does not answer; {what} waits for it (nothing "
                  "compiles on this PC in its place)", file=sys.stderr)
            told = True
        time.sleep(15)


def remote_client(req, name, host, settings=frozenset()):
    to = (sys.stdout.buffer if req["args"][:1] == ["test"] or any(a.startswith("--message-format") for a in req["args"])
          else sys.stderr.buffer)
    wt, rreq = remote_req(req)
    rreq["twice"] = "twice" in settings
    rreq["by_content"] = True  # the machine copies nothing into its tree; its files come back by content (take_back)
    job = JobFile(req, wt, rreq["git"], job_agent(os.getpid()), rreq["coord"], name) if req.get("steps") else None
    if job is not None:
        stop_ends(job)
    why = red_needs_steps(req) or unsendable(wt, req["cwd"], req) or (job.red_why if job is not None else None)
    if why:
        refused_here(job, why)
    lost_again = 0  # how many times the machine said contents of the tree went from its store after the send
    while True:
        remote_wait(name, host, "the job", job)
        t0 = time.time()
        if job is not None:
            job.step("sending")
        tree = send(host, wt, req["cwd"], req)
        if tree is None:
            time.sleep(15)
            continue
        sent = time.time() - t0
        rreq["tree"] = {"files": tree["files"], "incoming": tree["incoming"]}
        f = Remote(host)
        f.write(json.dumps(rreq).encode() + b"\n")
        m = None
        for line in f:
            if line.startswith(b'{"exit"'):
                m = json.loads(line)
                break
            if line.startswith(STEP):
                if job is not None:
                    job.take(line)
                continue
            to.write(line)
            to.flush()
        f.close()
        if m is None:
            print(f"build-runner: the link to {name} ended before the job's end; it is sent again", file=sys.stderr)
            time.sleep(5)
            continue
        if m.get("again"):
            rreq["came"] = m.get("came")
            lost_again += bool(m.get("tree_lost"))
            if lost_again >= 3:  # contents of its tree gone from the machine's store each time it was sent
                print("build-runner: the tree's contents went from the build machine's store three times; not sent "
                      "again", file=sys.stderr)
                if job is not None:
                    job.end(m, 2)
                return 2
            continue
        break
    t1 = time.time()
    if job is not None:
        job.step("back")
    how, back = "", True
    if m.get("blobs"):  # the files made, by content: linked from this PC's store, fetched once each
        back, n, got, size, copied = take_back(host, m, wt, {"job": job.path.stem if job is not None else None,
                                                             "who": rreq.get("agent"), **rreq.get("git", {})})
        how = (f" ({n} files: {got} fetched, {size / 2**20:.0f} MB; linked from this PC's store"
               + (f"; copied {copied}: the worktree is on another disk than the store" if copied else "") + ")")
    # nothing of the machine's tree's target/ comes back, a failed job's neither: that folder there holds only what
    # runners before this one copied into it, older than this worktree's files
    back = back and (not req.get("keep") or bring_back(host, wt, req["cwd"], req))
    print(f"build-runner: on {name}: sent in {sent:.0f} s ({tree['sent']} of {len(tree['files'])} files, "
          f"{tree['bytes'] / 2**20:.1f} MB; the rest its store held), back in {time.time() - t1:.0f} s{how}"
          + ("" if back else "; bringing the copied files back FAILED"), file=sys.stderr)
    for p in m.get("produced") or []:
        print(f"build-runner: {p}", file=sys.stderr)
    if m.get("differ"):  # counted where the machine's crashes are (paper-research p1342)
        try:
            with open(SEGV_NOTES, "a") as n:
                n.write(f"{time.strftime('%H:%M:%S')} two compiles differ on {name} ({', '.join(m['differ'][:5])}), "
                        f"{rreq.get('agent') or '?'}: {' '.join(req['args'])[:120]}; not stored, job failed\n")
        except OSError as e:
            print(f"build-runner: not counted in {SEGV_NOTES}: {e}", file=sys.stderr)
    if job is not None:
        # binaries only from a bring-back that worked: a failed one leaves the previous build's file at the same
        # deps/NAME-HASH path, and its md5 would join a replay of that binary to this job (proto-window N-1446 p1578)
        job.end(m if back else {**m, "produced": []}, m["exit"] if back else (m["exit"] or 1))
    return m["exit"] if back else (m["exit"] or 1)


def remote_hold(cmd, name, host, settings=frozenset()):
    wt, rreq = remote_req({"cwd": os.getcwd(), "args": ["hold"]})
    rreq = {k: v for k, v in rreq.items() if k != "args"}
    rreq.update({"hold": cmd, "who": os.environ.get("AGENT_NAME") or os.environ.get("USER")})
    while True:
        remote_wait(name, host, "the hold")
        f = Remote(host)
        f.write(json.dumps(rreq).encode() + b"\n")
        m = None
        for line in f:
            if line.startswith(b"{"):
                m = json.loads(line)
                break
            sys.stderr.buffer.write(line)
            sys.stderr.flush()
        if m and m.get("again"):
            rreq["came"] = m.get("came")
            f.close()
            continue
        if not m or "held" not in m:
            f.close()
            sys.exit("build-runner: the hold was not given")
        break
    print(f"build-runner: the runner on {name} is held for: {' '.join(cmd)}", file=sys.stderr)
    try:
        rc = subprocess.run(cmd, env={**os.environ, "BUILD_RUNNER_HOLD": m["held"]}).returncode
    finally:
        f.close()
    return rc


def relay():
    """build-runner relay (on the machine, run over ssh): stdin and stdout joined to this runner's socket; the end of
    stdin (the caller here gone, a hold's end) closes the connection, and so does stdin silent for RELAY_SILENT_SEC:
    the caller says a blank line each BEAT_SEC (Remote.beat), so silence is a link that has gone without its end
    reaching this side (sshd here may hold such a session for hours; at 01:01Z 25 Nov the job of a link gone ran on
    unread to the time limit, a2h-speed N-1446 p3251). The service stops the connection's job when it ends (Gone)."""
    import select
    s = connect()

    def up():
        while select.select([0], [], [], RELAY_SILENT_SEC)[0]:
            b = os.read(0, 1 << 16)
            if not b:
                break
            s.sendall(b)
        os._exit(0)  # the connection ends with this process
    threading.Thread(target=up, daemon=True).start()
    while True:
        try:
            b = s.recv(1 << 16)
        except OSError:  # the service closed with a blank line unread: everything it wrote came first
            break
        if not b:
            break
        os.write(1, b)
    os._exit(0)


def client(req):
    mc = machine()
    if mc:
        return remote_client(req, *mc)
    # cargo's own output is stderr, as cargo has it; a test's is stdout (its results)
    to = (sys.stdout.buffer if req["args"][:1] == ["test"] or any(a.startswith("--message-format") for a in req["args"])
          else sys.stderr.buffer)
    job = None
    if why := red_needs_steps(req):
        refused_here(None, why)
    if req.get("steps"):
        wt = str(worktree_of(req["cwd"]))
        facts = {k: (git(wt, *a) or b"").decode().strip() for k, a in (("branch", ("rev-parse", "--abbrev-ref", "HEAD")),
                                                                       ("commit", ("rev-parse", "--short=8", "HEAD")))}
        job = JobFile(req, wt, facts, job_agent(os.getpid()), caller_coord(os.getpid()))
        stop_ends(job)
        if job.red_why:
            refused_here(job, job.red_why)
    while True:
        f = connect().makefile("rwb", buffering=0)
        f.write(json.dumps(req).encode() + b"\n")
        m = {"exit": 2}
        for line in f:
            if line.startswith(b'{"exit"'):
                m = json.loads(line)
                break
            if line.startswith(STEP):
                if job is not None:
                    job.take(line)
                continue
            to.write(line)
            to.flush()
        if not m.get("again"):
            break
        req["came"] = m.get("came")
        print("build-runner: the runner restarts; this request goes to the new one", file=sys.stderr)
    for p in m.get("produced") or []:
        print(f"build-runner: {p}", file=sys.stderr)
    if job is not None:
        job.end(m, m["exit"])
    return m["exit"]



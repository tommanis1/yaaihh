                f["takes_out_beyond"] = json.dumps(d["takes_out_beyond"][:TAKES_OUT_MAX])
            f.update({"red_of": d["red_of"], "red_of_tree": d.get("red_of_tree") or "", "takes_out": json.dumps(out[:TAKES_OUT_MAX]),
                      "takes_out_more": str(len(out) - TAKES_OUT_MAX) if len(out) > TAKES_OUT_MAX else ""})
        if test:  # which tests it named, or whole (`tests_named`; proto-mind N-1446 p1502, head 2)
            f.update({"tests": json.dumps(d.get("tests") or []), "whole": "1" if d.get("whole") else "",
                      "targets": json.dumps(d["targets"]) if d.get("targets") else "",
                      "skip": json.dumps(d["skip"]) if d.get("skip") else "", "exact": "1" if d.get("exact") else "",
                      "ignored": d.get("ignored") or "", "no_run": "1" if d.get("no_run") else ""})
        if phase == "start":
            text = f"job start: {work}"
        elif phase == "runs":  # out of the queue: it compiles, tests or replays now (RUNS_STEPS)
            text = f"job runs: {work}"
        elif end.get("gone"):  # its caller gone or stopped: no counts it could not have (`end_gone`, `stop_ends`)
            secs = int((getattr(self, "t1", None) or time.time()) - self.t0)
            f.update({"gone": end["gone"], "rc": "" if end.get("rc") is None else str(end["rc"]), "secs": str(secs),
                      **({"job_agent": end["job_agent"]} if end.get("job_agent") else {})})
            text = f"job end: {work}: {end['gone']}, {secs} s"
        else:
            secs = int(time.time() - self.t0)
            tests = {k: end[k] for k in ("passed", "failed") if isinstance(end.get(k), int)}
            refused = end.get("refused") or ""
            if test and not refused and not d.get("no_run"):
                # a test job that came back says its counts whatever they are: 0 and 0 is "no tests run" (a build that
                # failed, a name that matched none), told apart from a refusal, which ran nothing and says why
                tests = {"passed": tests.get("passed", 0), "failed": tests.get("failed", 0)}
            failing = [str(x) for x in end.get("failing") or []]
            # each name a word of coordc's one argument, which Linux holds to 128 KiB (MAX_ARG_STRLEN): past FAILING_MAX
            # names the rest are counted, and `failed` is the whole count
            if failing:
                f.update({"failing": json.dumps(failing[:FAILING_MAX]),
                          "failing_more": str(len(failing) - FAILING_MAX) if len(failing) > FAILING_MAX else ""})
            if refused:
                f["refused"] = refused
            # the binaries that died, each with its signal (p1563): a crash or a kill at the memory cap, not "no tests run"
            died = [x for x in end.get("died") or [] if isinstance(x, dict)]
            if died:
                f["died"] = json.dumps(died)
            if end.get("binaries"):  # the programs it brought back, each with its md5 (p1564 point 3)
                f["binaries"] = json.dumps(end["binaries"])
            logs = []
            for fd in (1, 2):
                try:
                    t = os.readlink(f"/proc/self/fd/{fd}")
                    if t.startswith("/") and os.path.isfile(t) and t not in logs:
                        logs.append(t)
                except OSError:
                    pass
            f.update({"rc": "" if end.get("rc") is None else str(end["rc"]), **{k: str(v) for k, v in tests.items()},
                      "secs": str(secs), "logs": json.dumps(logs)})
            said = (f", refused: {refused}" if refused else
                    ", no tests run" if len(tests) == 2 and not tests["passed"] and not tests["failed"] and not died else
                    f", {tests['passed']} passed, {tests['failed']} failed" if len(tests) == 2 else "")
            if failing:
                said += f" ({', '.join(failing[:3])}{', …' if len(failing) > 3 else ''})"
            said += "".join(f", {x.get('binary') or '?'} died (signal {x.get('signal')}, {x.get('name') or '?'})" for x in died)
            counts = {k: end[k] for k in REPLAY_COUNTS if isinstance(end.get(k), int)}
            if counts:  # a replay's three counts, as its test printed them
                f.update({k: str(v) for k, v in counts.items()})
                said += "".join(f", {v} {k.replace('_', ' ')}" for k, v in counts.items())
            if d.get("unchecked"):  # a replay whose binary the store's check did not see (consult-lead N-1446 p2949)
                said += f", its binary not checked against the store: {d['unchecked']}"
            text = f"job end: {work}: rc {end.get('rc')}{said}, {secs} s"
        self.send([str(cc), "act", "job", text, *(f"{k}={v}" for k, v in f.items() if v != "")], phase)

    def send(self, argv, phase):
        """ARGV, the job's line PHASE, run by a child of its own, handed off (in a session of its own, its output
        nowhere): the job goes on at once and nothing waits on coordd, with no time limit of ours (paper-research N-1446
        p1542's rule for release.sh; proto-window p1565). A coord's lines land in the order they were made, the job's
        own (a reader takes a start that lands after its end for a job still running, graph_git.rs `job()`) and the
        jobs' one after another (p1872), also when coordd was down for a while (`ACT_PY`): each line has a lock file of
        its own (JOBS_DIR/ID.PHASE.NS.act), taken here and held by its child until coordc is done, and its child first
        waits for the coord's line before it, which JOBS_DIR/lines-SOCK.tail names (read and set under lines-SOCK.order's
        lock); the coord is the socket coordc goes to (COORDD_SOCK, client.rs `connect`), one record. A line coordd does
        not take goes to the journal (`logger -t build-runner-act`) with coordc's words, never to the job's output."""
        key = "lines-" + re.sub(r"[^\w.-]", "_", os.environ.get("COORDD_SOCK") or "/run/coordd.sock")
        mine, order, tail = (JOBS_DIR / f"{self.path.stem}.{phase}.{time.time_ns()}.act", JOBS_DIR / f"{key}.order",
                             JOBS_DIR / f"{key}.tail")
        try:
            fd = os.open(mine, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC, 0o600)
        except OSError:
            return
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)  # its own, new: held from here until the line is sent
            o = os.open(order, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC, 0o600)
            try:
                fcntl.flock(o, fcntl.LOCK_EX)
                try:
                    prev = tail.read_text()
                except OSError:
                    prev = ""
                tail.write_text(str(mine))
            finally:
                os.close(o)
            cmd = [sys.executable, "-I", "-c", ACT_PY, f"job {self.path.stem}'s {phase}", str(mine), prev, str(tail),
                   str(order), *argv]
            ACT_SENT.append(subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                             stderr=subprocess.DEVNULL, start_new_session=True, pass_fds=(fd,)))
            self.sent += 1
        except OSError:
            pass
        finally:
            os.close(fd)

    def take(self, line):
        """A STEP line of the job's stream, taken into the file."""
        try:
            d = json.loads(line)["build-runner-step"]
            self.step(str(d.pop("step")), **{k: v for k, v in d.items() if k in ("what", "done", "of", "failed", "ahead")})
        except (ValueError, KeyError, TypeError, AttributeError):
            pass

    def end(self, m, rc):
        """The job's end from its last line M (the service's, `Steps.ended` and `refusal`): rc, counts, the failing
        tests' names, a refusal's words, the binaries that died; and `binaries`, each program it built and brought back
        (M's `produced`, a `test --no-run`'s test binaries among them) with the md5 a replay's `binary_md5` gives, so a
        replay joins to the job and tree that built its binary (proto-window N-1446 p1564 point 3)."""
        binaries = []
        for p in (m.get("produced") or [])[:BINARIES_MAX]:
            try:
                h = hashlib.md5()
                with open(p, "rb") as b:
                    for chunk in iter(lambda: b.read(1 << 20), b""):
                        h.update(chunk)
                binaries.append({"path": str(p), "md5": h.hexdigest()[:8]})
            except OSError:
                pass  # not brought back: not named
        self.step("ended", rc=rc, **{k: m[k] for k in ("passed", "failed", *REPLAY_COUNTS) if isinstance(m.get(k), int)},
                  **{k: m[k] for k in ("failing", "refused", "died") if m.get(k)}, **({"binaries": binaries} if binaries else {}))


def git(top, *args):
    facts = GIT_FACTS.get(str(top))
    if facts is not None and args[:1] == ("rev-parse",) and args[-1] == "HEAD":
        return (facts.get("branch" if "--abbrev-ref" in args else "commit") or "").encode()
    r = subprocess.run(["git", "-C", str(top), *args], capture_output=True)
    return r.stdout if r.returncode == 0 else None


def snapshot(wt, dirs):
    """The content of every file our crates can read inside the worktree WT, by path relative to it: what git tracks in
    each repository holding a crate folder of DIRS (git's blob ids, as git hashes content), with modified and untracked
    files under the crate folders hashed the same way. Paths relative to WT."""
    out, wt = {}, Path(wt)
    tops = {}
    for d in dirs:
        t = git(d, "rev-parse", "--show-toplevel")
        if t:
            tops.setdefault(Path(t.decode().strip()), []).append(d)
    for top, ds in tops.items():
        pre = top.relative_to(wt) if top.is_relative_to(wt) else None
        if pre is None:
            continue
        rel = lambda p: str(pre / p) if str(pre) != "." else p
        for e in (git(top, "ls-files", "-s", "-z") or b"").split(b"\0"):
            if b"\t" in e:
                meta, path = e.split(b"\t", 1)
                out[rel(path.decode())] = meta.split()[1].decode()
        local = [os.path.relpath(d, top) for d in ds]
        changed = (git(top, "ls-files", "-m", "-z") or b"").split(b"\0") + \
                  (git(top, "ls-files", "-o", "--exclude-standard", "-z", "--", *local) or b"").split(b"\0")
        paths = sorted({c.decode() for c in changed if c})
        present = [p for p in paths if (top / p).is_file()]
        for p in set(paths) - set(present):
            out.pop(rel(p), None)
        if present:
            h = subprocess.run(["git", "-C", str(top), "hash-object", "--stdin-paths"], input="\n".join(present) + "\n",
                               capture_output=True, text=True)
            for p, x in zip(present, h.stdout.split()):
                out[rel(p)] = x
    return out


def snap_id(wt, files):
    return hashlib.sha1(json.dumps([wt, files], sort_keys=True).encode()).hexdigest()[:16]


def save_built(key, wt, ours, files, kinds=None):
    """The folder KEY's record: the worktree and content its last build was made from, and for each variant of our
    crates in it (a crate's test build, its check, its library with other features: one dep-info file each) the content
    it was last compiled from, kept once per distinct content (`snaps`); KINDS, when given, replaces the variants'."""
    try:
        old = load_built(key) or {}
        snaps = old.get("snaps") or {}
        variants_ = (old.get("variants") or {}) if kinds is None else kinds
        if old.get("ours") != ours:
            variants_ = {} if kinds is None else kinds  # after our crates were taken out, nothing of the old is left
        sid = snap_id(wt, files)
        snaps[sid] = {"wt": wt, "files": files}
        keep = set(variants_.values()) | {sid}
        snaps = {k: v for k, v in snaps.items() if k in keep}
        BUILT.mkdir(parents=True, exist_ok=True)
        tmp = BUILT / f"{key}.json.tmp"
        tmp.write_text(json.dumps({"wt": wt, "ours": ours, "files": files, "snaps": snaps, "variants": variants_}))
        tmp.replace(BUILT / f"{key}.json")
    except OSError as e:
        log(f"built/{key}.json: {e}")


def load_built(key):
    try:
        return json.loads((BUILT / f"{key}.json").read_text())
    except (OSError, ValueError):
        return None


def note_variants(key, wt, files, tdir, prof, target, ours, used, t0):
    """After a build in KEY from WT: each variant of our crates it compiled (dep-info written since T0) or found fresh
    (USED, from cargo's artifact lines) is now WT's content FILES; the rest keep theirs; a variant gone from the folder
    is forgotten."""
    built = load_built(key) or {}
    kinds = built.get("variants") or {}
    sid = snap_id(wt, files)
    now = {}
    for v, d in variants(tdir, prof, target, ours).items():
        try:
            fresh = d.stat().st_mtime >= t0
        except OSError:
            continue
        if fresh or v in used:
            now[v] = sid
        elif v in kinds:
            now[v] = kinds[v]
    save_built(key, wt, ours, files, now)


def variants(tdir, prof, target, ours):
    """The variants of OUR crates in the folder, each with its dep-info file: `deps/NAME-HASH` for a crate's library,
    test or binary, `build/NAME-HASH` for its build script."""
    base = Path(tdir) / (target or "") / ("debug" if prof == "debug" else prof)
    libs = {n.replace("-", "_") for n in ours}
    out = {f"deps/{d.stem}": d for d in (base / "deps").glob("*.d") if d.name.rsplit("-", 1)[0] in libs}
    for n in ours:
        out.update({f"build/{d.parent.name}": d for d in (base / "build").glob(f"{n}-*/*.d")})
    return out


def variant_of(path):
    """The variant a file of cargo's artifact line belongs to (as variants() names it), or None."""
    p = Path(path)
    if p.parent.name == "deps":
        stem = p.name.split(".", 1)[0]
        return "deps/" + (stem[3:] if stem.startswith("lib") else stem)
    if p.parent.parent.name == "build":
        return "build/" + p.parent.name
    return None


def drop_variant(tdir, prof, target, v):
    """Take out one variant: its files in deps (cargo then finds its output missing and compiles it again), or its
    build script's folder."""
    base = Path(tdir) / (target or "") / ("debug" if prof == "debug" else prof)
    kind, name = v.split("/", 1)
    if kind == "build":
        shutil.rmtree(base / "build" / name, ignore_errors=True)
        return
    crate, h = name.rsplit("-", 1)
    for x in list((base / "deps").glob(f"{crate}-{h}*")) + list((base / "deps").glob(f"lib{crate}-{h}.*")):
        try:
            x.unlink()
        except OSError:
            pass


def dep_info(d):
    """Every file the dep-info file D says its crate read, as written there: relative to the workspace root, or
    absolute."""
    try:
        text = Path(d).read_text()
    except OSError:
        return
    seen = set()
    for line in text.splitlines():
        if ":" not in line or line.startswith("#"):
            continue
        _target, _, deps = line.partition(": ")
        for x in re.split(r"(?<!\\) ", deps.strip()):
            x = x.replace("\\ ", " ")
            if x and x not in seen:
                seen.add(x)
                yield x


STORE_CAP_GB = float(os.environ.get("BUILD_RUNNER_STORE_CAP_GB", "60"))
KEEP_HANDED_SEC = 3600  # a job's handed folder is kept this long: its caller fetches from it (handed_folder)
# this PC's part of the store, the files jobs on the build machine made and the callers here link (take_back)
BACK_CAP_GB = float(os.environ.get("BUILD_RUNNER_BACK_CAP_GB", "20"))
# a job's tree on the build machine (piece B of the storage page, N-1446 p2727): no copy of a worktree is kept there.
# Each content is held once, in the store's src/ by its sha256 (`.x` when executable), writable as it is in the
# worktree (cargo rewrites Cargo.lock there); a tree is a base of links to them, BASES/ID, shared by every job of the
# same files and seen by each under a layer of the job's own (TreeBase, _in_place). A base no job holds and unused for
# KEEP_BASE_SEC goes, and a content no base links, KEEP_SRC_SEC after its last base went (sweep_bases).
SRC_DIR = STORE_DIR / "src"
BASES = HOME / "bases"
KEEP_BASE_SEC = 3600
KEEP_SRC_SEC = 86400


def tree_refused(tree):
    """Why the build machine does not take TREE, a job's tree by content ({files: [[path, sha256, executable]],
    incoming}), else None: a path that is absolute, climbs out, is no plain name or comes twice, a content that is no
    sha256, a send's folder that is no name of the runner's."""
    files = tree.get("files") if isinstance(tree, dict) else None
    if not isinstance(files, list) or not re.fullmatch(r"[0-9]+-[0-9a-f]{12}", str(tree.get("incoming") or "")):
        return "the tree's request is not in the runner's shape"
    seen = set()
    for x in files:
        if not (isinstance(x, list) and len(x) == 3 and isinstance(x[0], str) and isinstance(x[1], str)
                and isinstance(x[2], bool)):
            return "the tree's request is not in the runner's shape"
        rel, sha, _ = x
        if (not rel or rel.startswith("/") or "\0" in rel or "\n" in rel or rel in seen
                or any(q in ("", ".", "..") for q in rel.split("/")) or not re.fullmatch(r"[0-9a-f]{64}", sha)):
            return f"the tree names {rel!r} ({sha[:12]}): no path inside a worktree, or no content's name"
        seen.add(rel)
    return None


def in_tree(v, wt, tree):
    """V, a value a caller passes on (--env), with each path at or under the worktree WT, anywhere in it (CFLAGS'
    `-include WT/…`), as the same path under TREE, where a job sees its tree: a job runs in a view of its tree, not at
    the worktree's path (piece B, his N-1104 p1054; docket-core N-1446 p3118: windows-speech/env.sh's header)."""
    return re.sub(re.escape(wt.rstrip("/")) + r"(?=/|$|[\s:;,'\"=])", lambda _: tree, v) if isinstance(v, str) and wt else v


def in_base(q, frm, to):
    """Q, a path at or under FRM, as the same path under TO (a worktree's path and its tree's base, either way); else Q."""
    return to + q[len(frm):] if to and frm and q and (q == frm or q.startswith(frm + "/")) else q


def tree_lock(path):
    """PATH's lock opened and held shared (a job's use of its base), and its time set (its last use); one that
    sweep_bases removed meanwhile (holding it exclusive) is opened again, so a job never holds a lock no sweep sees."""
    while True:
        fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
        fcntl.flock(fd, fcntl.LOCK_SH)
        try:
            if os.fstat(fd).st_ino == os.stat(path).st_ino:
                os.utime(path)
                return fd
        except FileNotFoundError:
            pass
        os.close(fd)


def sweep_bases():
    """At most every ten minutes: the bases no job holds and unused for KEEP_BASE_SEC, the contents no base links whose
    last link went KEEP_SRC_SEC ago (a link's removal sets its ctime), and the sends no job took within the hour."""
    stamp, now = BASES / ".swept-at", time.time()
    try:
        if now - stamp.stat().st_mtime < 600:
            return
    except OSError:
        pass
    stamp.touch()
    for lk in BASES.glob("*.lock"):
        try:
            if now - lk.stat().st_mtime < KEEP_BASE_SEC:
                continue
            fd = os.open(lk, os.O_RDWR)
        except OSError:
            continue
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            move_out(lk.with_suffix(""))
            lk.unlink(missing_ok=True)
        except OSError:
            pass  # a job holds it
        finally:
            os.close(fd)
    for b in SRC_DIR.glob("*/*"):
        try:
            st = b.stat()
            if st.st_nlink == 1 and now - st.st_ctime >= KEEP_SRC_SEC:
                b.unlink()
        except OSError:
            pass
    for d in (STORE_DIR / "incoming").glob("*"):
        try:
            if now - d.stat().st_mtime >= 3600:
                move_out(d)
        except OSError:
            pass


class TreeBase:
    """A job's tree on the build machine, by content (piece B): what its send brought (store/incoming/ID) put into the
    store's src/, each content checked against its name; then BASES/ID, the tree as links to them, made once and shared
    by every job of the same files, held (its lock shared) from here to the job's end. `path` the base; `why` the words
    the job is refused with; `lost`, how many contents went between the send and now (the client sends again)."""

    def __init__(self, tree):
        self.tree, self.fd, self.path, self.why, self.lost = tree, None, None, None, 0

    def __enter__(self):
        files, inc = self.tree["files"], STORE_DIR / "incoming" / self.tree["incoming"]
        try:
            for d in (SRC_DIR, BASES):
                d.mkdir(parents=True, exist_ok=True)
            sweep_bases()
            self.why = self.put(inc, files)
            if self.why:
                return self
            name = hashlib.sha256(json.dumps(sorted(files)).encode()).hexdigest()[:32]
            self.fd = tree_lock(BASES / f"{name}.lock")
            base = BASES / name
            if not base.is_dir():
                self.lost = self.make(base, files)
                if self.lost:
                    self.why = f"{self.lost} contents of the tree went from the build machine's store since it was sent"
                    return self
            self.path = str(base)
        except OSError as e:
            self.why = f"the tree could not be made on the build machine: {e}"
        finally:
            shutil.rmtree(inc, ignore_errors=True)
        return self

    def __exit__(self, *_):
        if self.fd is not None:
            os.close(self.fd)

    @staticmethod
    def put(inc, files):
        """INC's contents into src/, each by its name once checked; the words when one is not what its name says."""
        ex_of = {sha + (".x" if ex else ""): ex for _, sha, ex in files}
        for got in inc.glob("*/*"):
            n = got.name
            if n not in ex_of or got.parent.name != n[:2] or got.is_symlink() or not got.is_file():
                continue  # nothing this tree names: it goes with the folder
            if file_sha256(got) != n[:64]:
                return f"{n[:12]}: a file of the tree changed while it was sent; send the job again"
            os.chmod(got, 0o755 if ex_of[n] else 0o644)
            (SRC_DIR / n[:2]).mkdir(exist_ok=True)
            try:
                os.link(got, SRC_DIR / n[:2] / n)
            except FileExistsError:
                pass
        return None

    @staticmethod
    def make(base, files):
        """BASE made from FILES: its folders new, each file a link to its content in src/; made beside and renamed in, so
        a base is whole or not there. How many contents src/ lacks (0: made)."""
        tmp = Path(tempfile.mkdtemp(prefix=f".{base.name}-", dir=BASES))
        try:
            lost = 0
            for rel, sha, ex in files:
                dst = tmp / rel
                dst.parent.mkdir(parents=True, exist_ok=True)
                try:
                    os.link(SRC_DIR / sha[:2] / (sha + (".x" if ex else "")), dst)
                except FileNotFoundError:
                    lost += 1
            if lost:
                return lost
            try:
                os.rename(tmp, base)
            except OSError:
                if not base.is_dir():
                    raise
            return 0  # made, or another job of the same files made it first
        finally:
            if tmp.exists():
                move_out(tmp)


def handed_folder():
    """A folder of its own for one job's files handed to its caller: store/handed/ID, each file in it a link to its blob,
    so the caller fetching from it gets the file though the gc took the blob's own name meanwhile (no entry names a
    linked binary's blob). The folders older than KEEP_HANDED_SEC go first, and the inodes with them."""
    root = STORE_DIR / "handed"
    root.mkdir(parents=True, exist_ok=True)
    for d in root.iterdir():
        try:
            if time.time() - d.stat().st_mtime >= KEEP_HANDED_SEC:
                shutil.rmtree(d, ignore_errors=True)
        except OSError:
            pass
    return Path(tempfile.mkdtemp(prefix=f"{int(time.time())}-", dir=root))


def store_blob(real, handed):
    """REAL as a blob of the store (by its sha256, `.x` when executable: build-store-rustc's names), put in if it is not
    there yet (a copy, read-only), and linked into HANDED (handed_folder). Held under the store's lock shared, as a put
    is, so the gc (exclusive) never sweeps it between write and link. The blob's name."""
    import fcntl
    ex = bool(os.stat(real).st_mode & 0o111)
    sha = file_sha256(real)
    b = STORE_DIR / "blobs" / sha[:2] / (sha + (".x" if ex else ""))
    with open(STORE_DIR / ".lock", "a") as lk:
        fcntl.flock(lk, fcntl.LOCK_SH)
        if not b.exists():
            b.parent.mkdir(parents=True, exist_ok=True)
            tmp = b.with_name(f".{b.name}.{os.getpid()}-{threading.get_ident()}")
            shutil.copyfile(real, tmp)
            os.chmod(tmp, 0o555 if ex else 0o444)
            os.replace(tmp, b)
        if not (handed / b.name).exists():
            os.link(b, handed / b.name)
    return b.name


def file_sha256(p):
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for blk in iter(lambda: f.read(1 << 20), b""):
            h.update(blk)
    return h.hexdigest()


def take_back(host, m, wt, made_by=None):
    """What a job on the build machine made, by content (step 1 of the storage page, N-1446 p2726, p2727): each file is
    a blob of the machine's store. One this PC's store holds already is linked in where cargo would have put it (or
    --out), read-only; one it lacks is fetched once, checked against its hash, made read-only, then linked. So a
    binary forty worktrees hold is one file here, and nothing is copied into a worktree. A file outside the worktree is
    refused. A worktree on another disk than the store can't link, so it gets a copy, counted (consult-lead N-1446
    p2792). Each file linked goes into this PC's binaries index with MADE_BY (index_binaries). (ok, how many files, how
    many fetched, bytes fetched, how many copied)"""
    blobs = STORE_DIR / "blobs"
    wants, was_fetched = [], set()
    for dest, name in m.get("blobs") or []:
        sha = name.split(".")[0]
        if not re.fullmatch(r"[0-9a-f]{64}(\.x)?", name) or not os.path.realpath(dest).startswith(os.path.realpath(wt) + "/"):
            print(f"build-runner: {dest} ({name}) is not a file of this worktree's: not taken", file=sys.stderr)
            return False, 0, 0, 0, 0
        wants.append((Path(dest), name, sha))
    fetched, size, copied = 0, 0, 0
    if not re.fullmatch(r"/[^\0\n]*/store/handed/[0-9]+-[A-Za-z0-9_]+", str(m.get("store") or "/")) and wants:
        print(f"build-runner: the build machine named no folder of handed files ({m.get('store')}): not taken",
              file=sys.stderr)
        return False, len(wants), 0, 0, 0
    for attempt in (1, 2):  # a second time for a blob trimmed between its check and its link (trim_back)
        missing = sorted({name for _, name, _ in wants if not (blobs / name[:2] / name).exists()})
        if missing:
            STORE_DIR.mkdir(parents=True, exist_ok=True)
            inc = Path(tempfile.mkdtemp(prefix=".back-", dir=STORE_DIR))
            try:
                lst = inc / "list"
                lst.write_text("".join(f"{n}\n" for n in missing))
                if not rsync(host, [f"--files-from={lst}", f"{host}:{m['store']}/", f"{inc}/in/"]):
                    return False, len(wants), fetched, size, copied
                for n in missing:
                    got = inc / "in" / n
                    if file_sha256(got) != n.split(".")[0]:
                        print(f"build-runner: {n} came from the build machine with other content: not taken", file=sys.stderr)
                        return False, len(wants), fetched, size, copied
                    os.chmod(got, 0o555 if n.endswith(".x") else 0o444)
                    (blobs / n[:2]).mkdir(parents=True, exist_ok=True)
                    size += got.stat().st_size
                    os.replace(got, blobs / n[:2] / n)
                    fetched += 1
                    was_fetched.add(n)
            finally:
                shutil.rmtree(inc, ignore_errors=True)
        lost = []
        for dest, name, sha in wants:
            b = blobs / name[:2] / name
            dest.parent.mkdir(parents=True, exist_ok=True)
            tmp = dest.with_name(f".{dest.name}.build-runner-back-{os.getpid()}")
            try:
                os.utime(b)  # used now: trim_back keeps it
                try:
                    os.link(b, tmp)
                except FileNotFoundError:
                    raise
                except OSError:
                    shutil.copy2(b, tmp)  # the worktree on another disk than the store
                    copied += 1
            except FileNotFoundError:
                lost.append(name)
                continue
            tmp.replace(dest)  # a running copy of the old one keeps its file
        if not lost:
            break
        if attempt == 2:
            print(f"build-runner: {len(lost)} files could not be linked from this PC's store", file=sys.stderr)
            return False, len(wants), fetched, size, copied
    index_binaries([(dest, name, name in was_fetched) for dest, name, _ in wants], made_by or {})
    trim_back()
    return True, len(wants), fetched, size, copied


def trim_back():
    """This PC's part of the store under BUILD_RUNNER_BACK_CAP_GB: the blobs nothing else links (a worktree or a
    release holds its own link to the one it uses) go, used longest ago first, and none used within the hour."""
    files, total = [], 0
    for b in (STORE_DIR / "blobs").glob("*/*"):
        try:
            st = b.stat()
        except OSError:
            continue
        total += st.st_size
        if st.st_nlink == 1 and time.time() - st.st_mtime >= KEEP_HANDED_SEC:
            files.append((st.st_mtime, st.st_size, b))
    for _, sz, b in sorted(files):
        if total <= BACK_CAP_GB * 2**30:
            break
        b.unlink(missing_ok=True)
        total -= sz
    trim_index()


# Home's Store (docket-edge8 N-1446 p2810, p2904; a2h-speed p2815, p2927): what the store holds, a row for each part, every
# field optional to its reader; a press on a row gives its entries, STORE_PAGE at a time, newest use first
STORE_PAGE = 200
STORE_HOLDS = 10  # the binaries row names its most-linked programs, this many
MACHINE_STORE = HOME / "machine-store.json"  # the build machine's rows as last read (machine_rows)
MACHINE_STORE_SEC = 60  # they are read again when older than this
MACHINE_STORE_LOCK = threading.Lock()
MACHINE_READING = []  # the service reading the build machine's rows behind the last ones (machine_rows): one at a time
SERVING = False  # this process is the service (serve): Home's Store answers the last rows at once, read again behind
BINARIES_INDEX = STORE_DIR / "binaries.jsonl"  # each file take_back linked from this PC's store, and the job it came from
INDEX_KEEP_SEC = 2 * 86400  # every line this young is kept (today's counts); older ones, the newest of each blob and place


def iso(t):
    return time.strftime("%FT%TZ", time.gmtime(t))


def day_start():
    """Midnight today on this PC's clock: where a row's `today` starts (the build machine keeps UTC)."""
    lt = time.localtime()
    return int(time.mktime((lt.tm_year, lt.tm_mon, lt.tm_mday, 0, 0, 0, 0, 0, -1)))


def index_binaries(linked, made_by):
    """LINKED, (where, blob, fetched) for each file take_back linked, as lines of BINARIES_INDEX with the job that made
    it (MADE_BY: job, who, branch, commit), under the index's lock: the binaries row's names and a press on it."""
    import fcntl
    now = int(time.time())
    data = "".join(json.dumps({"at": now, "blob": name, "dest": str(dest), "fetched": fetched,
                               **{k: v for k, v in made_by.items() if v}}) + "\n" for dest, name, fetched in linked)
    if not data:
        return
    try:
        with open(STORE_DIR / ".binaries.lock", "a") as lk:
            fcntl.flock(lk, fcntl.LOCK_EX)
            with open(BINARIES_INDEX, "a") as f:
                f.write(data)
    except OSError:
        pass


def binaries_index():
    """BINARIES_INDEX read: each blob's lines, oldest first."""
    out = {}
    try:
        with open(BINARIES_INDEX) as f:
            for line in f:
                try:
                    x = json.loads(line)
                    out.setdefault(x["blob"], []).append(x)
                except (ValueError, KeyError, TypeError):
                    continue
    except OSError:
        pass
    return out


def trim_index():
    """BINARIES_INDEX down to the blobs the store holds: of the older lines, the newest for each blob and place."""
    import fcntl
    try:
        with open(STORE_DIR / ".binaries.lock", "a") as lk:
            fcntl.flock(lk, fcntl.LOCK_EX)
            idx, old = binaries_index(), time.time() - INDEX_KEEP_SEC
            keep = []
            for name, xs in idx.items():
                if not (STORE_DIR / "blobs" / name[:2] / name).exists():
                    continue
                newest = {}
                for x in xs:
                    if x.get("at", 0) >= newest.get(x.get("dest"), {}).get("at", -1):
                        newest[x.get("dest")] = x
                keep += [x for x in xs if x.get("at", 0) >= old or newest.get(x.get("dest")) is x]
            keep.sort(key=lambda x: x.get("at", 0))
            tmp = BINARIES_INDEX.with_name(f".{BINARIES_INDEX.name}.{os.getpid()}")
            tmp.write_text("".join(json.dumps(x) + "\n" for x in keep))
            os.replace(tmp, BINARIES_INDEX)
    except OSError:
        pass


def blob_stats():
    """Each blob of this machine's store: name -> its stat (size, links, last use)."""
    out = {}
    for b in (STORE_DIR / "blobs").glob("*/*"):
        if not b.name.startswith("."):
            try:
                out[b.name] = b.stat()
            except OSError:
                pass
    return out


def store_entries():
    """This machine's compiled crates: each version of each entry build-store-rustc put, with the entry's last use (its
    file's time, the gc's clock) and its kind (rustc, script)."""
    out = []
    for e in (STORE_DIR / "entries").glob("*/*/*.json"):
        try:
            used = e.stat().st_mtime
            vs = json.loads(e.read_text())
        except (OSError, ValueError):
            continue
        out += [(used, e.parent.parent.name, v) for v in (vs if isinstance(vs, list) else [])
                if isinstance(v, dict) and isinstance(v.get("out"), dict)]
    return out


REGISTRY_SRC = re.compile(r"/registry/src/[^/]+/([A-Za-z0-9_.+-]+?)-(\d+\.\d+\.\d+[A-Za-z0-9_.+-]*)/")


def made_from(v):
    """What a version of an entry was compiled from: a registry crate's name and version, off its inputs' paths; else
    the crate its outputs name (`libNAME-HASH.rlib`)."""
    for p in v.get("inputs") or {}:
        if m := REGISTRY_SRC.search(p):
            return f"{m.group(1)} {m.group(2)}"
    for n in sorted(v["out"]):
        if m := re.match(r"(?:lib)?([A-Za-z0-9_]+?)-[0-9a-f]{16}", n):
            return m.group(1)
    return next(iter(sorted(v["out"])), "?")


def entry_bytes(v, blobs):
    try:
        return sum(blobs[h + (".x" if ex else "")].st_size for h, ex in v["out"].values() if h + (".x" if ex else "") in blobs)
    except (TypeError, ValueError):
        return 0


def crates_row(since):
    """The compiled crates' row of this machine's store, else None (no entries: a PC whose builds run elsewhere). Its
    `today`, from runs.jsonl since SINCE: jobs, compiles (each a hit, a miss or one passed by) and those from the store."""
    import datetime
    ents = store_entries()
    if not ents:
        return None
    jobs = compiles = hits = 0
    try:
        with open(STORE_DIR / "runs.jsonl", "rb") as r:
            r.seek(max(0, os.fstat(r.fileno()).st_size - (16 << 20)))  # a day's lines are at its end
            for line in r:
                try:
                    x = json.loads(line)
                    at = datetime.datetime.strptime(x["at"], "%Y-%m-%dT%H:%M:%S%z").timestamp()
                except (ValueError, KeyError, TypeError):
                    continue
                if at >= since:
                    jobs += 1
                    compiles += sum(int(x.get(k) or 0) for k in ("hit", "miss", "pass"))
                    hits += int(x.get("hit") or 0)
    except OSError:
        pass
    return {"id": "crates", "what": "Compiled crates", "held_bytes": sum(st.st_size for st in blob_stats().values()),
            "cap_bytes": int(STORE_CAP_GB * 2**30), "count": len(ents), "count_of": "entries",
            "today": {"jobs": jobs, "compiles": compiles, "from_store": hits}}


def crates_page(start):
    """A press on the crates' row: entries from START, newest use first. Who made each is kept in it; how often it was
    taken is not (it would rewrite the entry at each hit, under the store's lock; p2815)."""
    blobs, rows = blob_stats(), []
    for used, kind, v in store_entries():
        by = v.get("by") if isinstance(v.get("by"), dict) else {}
        rows.append((used, {"made_from": made_from(v), "kind": kind,
                            "by": {k: by[k] for k in ("who", "branch", "commit") if by.get(k)},
                            **({"made_at": iso(v["at"])} if isinstance(v.get("at"), (int, float)) else {}),
                            "used_at": iso(used), "bytes": entry_bytes(v, blobs)}))
    rows.sort(key=lambda r: -r[0])
    return {"entries": [r for _, r in rows[start:start + STORE_PAGE]], "total": len(rows)}


def program_name(dest):
    """A linked file's program: its name without cargo's -HASH (deps/coordd-1a2b3c4d5e6f7a8b: coordd)."""
    return re.sub(r"-[0-9a-f]{16}$", "", Path(dest).name)


def binaries_row(since):
    """This PC's part of the store (take_back's): held against BACK_CAP_GB, its blobs, today's files handed back and how
    many of them were fetched, and its most-linked programs (a link each place that holds one has)."""
    blobs, idx = blob_stats(), binaries_index()
    today = [x for xs in idx.values() for x in xs if x.get("at", 0) >= since]
    most = sorted(((st.st_nlink - 1, n) for n, st in blobs.items() if n.endswith(".x") and n in idx), reverse=True)
    return {"id": "binaries", "what": "Binaries", "held_bytes": sum(st.st_size for st in blobs.values()),
            "cap_bytes": int(BACK_CAP_GB * 2**30), "count": len(blobs), "count_of": "blobs",
            "today": {"handed": len(today), "fetched": sum(1 for x in today if x.get("fetched"))},
            "holds": [{"name": program_name(idx[n][-1]["dest"]), "hash8": n[:8], "links": k} for k, n in most[:STORE_HOLDS]]}


def binaries_page(start):
    """A press on the binaries' row: each blob from START, newest use first: where it is linked, the job that first
    had it handed, its links and size."""
    blobs, idx, rows = blob_stats(), binaries_index(), []
    for n, st in blobs.items():
        xs = idx.get(n, [])
        rows.append((st.st_mtime, {"names": sorted({x["dest"] for x in xs if x.get("dest")}), "hash8": n[:8],
                                   "made_by": {k: xs[0][k] for k in ("job", "who", "branch", "commit") if xs and xs[0].get(k)},
                                   "links": st.st_nlink - 1, "used_at": iso(st.st_mtime), "bytes": st.st_size}))
    rows.sort(key=lambda r: -r[0])
    return {"entries": [r for _, r in rows[start:start + STORE_PAGE]], "total": len(rows)}


def machine_store(mc, args):
    """`build-runner store --here ARGS` on the build machine MC, over its ssh: its answer, else (None, why)."""
    env = {**REMOTE_ENV, "BUILD_RUNNER_HOME": REMOTE_HOME}
    cmd = shlex.join(["env", *(f"{k}={v}" for k, v in env.items()), "python3", "-I", f"{REMOTE_LIB}/build-runner",
                      "store", "--here", *args])
    try:
        r = subprocess.run(ssh_argv(mc[1]) + [cmd], capture_output=True, text=True, timeout=60)
    except subprocess.TimeoutExpired:
        return None, f"{mc[0]} did not answer within 60 s"
    if r.returncode != 0:
        return None, f"{mc[0]} does not answer" if r.returncode == 255 else f"{mc[0]}: {r.stderr.strip()[-200:]}"
    try:
        return json.loads(r.stdout), None
    except ValueError:
        return None, f"{mc[0]} answered no JSON"


def machine_rows(mc, since):
    """The build machine's rows, read at most every MACHINE_STORE_SEC (one ssh a minute while Home asks), each with its
    `device` (the machine's name, as Devices and a job's `machine` say it) and `as_of`, when they were read. When it
    does not answer: the rows last read, with `unread`, why; or its crates' row with only that. In the service, rows
    of the same day older than that are answered at once as they are, and read again behind them (one read at a time),
    so a page waits on the build machine only for the day's first read (consult-lead N-1446 p2980)."""
    with MACHINE_STORE_LOCK:
        try:
            last = json.loads(MACHINE_STORE.read_text())
        except (OSError, ValueError):
            last = {}
        kept = [{**r, **({"unread": last["unread"]} if last.get("unread") else {})} for r in last.get("rows") or []]
        if last.get("since") == since and time.time() - max(last.get("at", 0), last.get("tried", 0)) < MACHINE_STORE_SEC:
            return kept
        behind = SERVING and last.get("since") == since and bool(kept)
        if behind and MACHINE_READING:
            return kept
        if behind:
            MACHINE_READING.append(threading.get_ident())
        else:
            return read_machine_rows(mc, since, last)

    def again():
        try:
            read_machine_rows(mc, since, last, lock=True)
        finally:
            MACHINE_READING.clear()
    threading.Thread(target=again, daemon=True).start()
    return kept


def read_machine_rows(mc, since, last, lock=False):
    """The build machine's rows read now over its ssh (machine_store), kept in MACHINE_STORE. When it does not answer:
    LAST's rows with `unread`, kept so with when it was tried (so it is tried again only MACHINE_STORE_SEC on); with no
    rows before, its crates' row with only that. LOCK: take MACHINE_STORE_LOCK to keep them (a read behind)."""
    got, why = machine_store(mc, ["--since", str(since)])
    now = time.time()
    if got is not None:
        rows = [{**r, "device": mc[0], "as_of": iso(now)} for r in got.get("rows") or []]
        keep = {"at": now, "since": since, "rows": rows}
    elif last.get("rows"):
        rows = [{**r, "unread": why} for r in last["rows"]]
        keep = {**last, "tried": now, "unread": why}
    else:
        return [{"id": "crates", "what": "Compiled crates", "device": mc[0], "unread": why}]
    try:
        if lock:
            MACHINE_STORE_LOCK.acquire()
        tmp = MACHINE_STORE.with_name(f".{MACHINE_STORE.name}.{os.getpid()}-{threading.get_ident()}")
        tmp.write_text(json.dumps(keep))
        os.replace(tmp, MACHINE_STORE)
    except OSError:
        pass
    finally:
        if lock:
            MACHINE_STORE_LOCK.release()
    return rows


def store_answer(row=None, start=0, here=False, since=None):
    """Home's Store (`Request::Store`, N-1446 p2815): with no ROW, the rows; with ROW, a page of its entries from START.
    HERE: this machine's own rows (what the build machine answers over ssh). Else, with a build machine named, its
    crates' row (machine_rows) and this PC's binaries' row; with none, this PC's crates' row."""
    since = day_start() if since is None else since
    mc = None if here else machine()
    if row is None:
        outside = [] if here else [r for r in [outside_row()] if r]
        if mc:
            return {"rows": [*machine_rows(mc, since), binaries_row(since), *outside]}
        return {"rows": [r for r in [crates_row(since)] if r] + outside}
    if row == "crates":
        if not mc:
            return crates_page(start)
        got, why = machine_store(mc, ["crates", "--from", str(start)])
        return got if got is not None else {"error": why}
    if row == "binaries" and mc:
        return binaries_page(start)
    if row == "outside" and not here:
        return outside_page(start)
    return {"error": f"no row {row!r} here: {'crates, binaries, outside' if mc else 'crates' if here else 'crates, outside'}"}


def store_cli(argv):
    """build-runner store [ROW] [--from N] (and --here [--since T], the build machine's side)."""
    row, start, here, since = None, 0, False, None
    while argv:
        if argv[0] == "--here":
            here, argv = True, argv[1:]
        elif argv[0] in ("--from", "--since") and len(argv) > 1 and argv[1].isdigit():
            start, since = (int(argv[1]), since) if argv[0] == "--from" else (start, int(argv[1]))
            argv = argv[2:]
        elif row is None and re.fullmatch(r"[a-z]+", argv[0]):
            row, argv = argv[0], argv[1:]
        else:
            return "build-runner store [ROW] [--from N]: the store's rows as JSON; with ROW, its entries from N"
    a = store_answer(row, start, here, since)
    print(json.dumps(a))
    return 1 if "error" in a else 0


def store_gc(force=False):
    """The store under its cap (N-412 p927 C): at most every ten minutes, under the store's lock taken exclusive (a put
    holds it shared from its first blob to its entry). First the blobs no entry names go, then the entries used
    longest ago, each followed by the blobs it alone named, until the store is under its cap."""
    import fcntl
    stamp = STORE_DIR / ".gc-at"
    try:
        if not force and time.time() - stamp.stat().st_mtime < 600:
            return
    except OSError:
        pass
    if not STORE_DIR.is_dir():
        return
    stamp.touch()
    with open(STORE_DIR / ".lock", "a") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        blobs = {}
        for b in (STORE_DIR / "blobs").glob("*/*"):
            if b.name.startswith("."):  # a blob moved aside as bad, or a write of a put that died: a live put holds the
                b.unlink(missing_ok=True)  # lock shared from its first blob to its entry, so none is under way now
            else:
                try:
                    blobs[b.name] = (b, b.stat().st_size)
                except OSError:
                    pass
        total = sum(sz for _, sz in blobs.values())
        cap = STORE_CAP_GB * 2**30
        if total <= cap and not force:
            return
        entries = []  # (last use, path, the blob names it holds)
        named = {}
        for e in (STORE_DIR / "entries").glob("*/*/*.json"):
            try:
                vs = json.loads(e.read_text())
                names = {h + (".x" if ex else "") for v in vs for h, ex in v["out"].values()}
                entries.append((e.stat().st_mtime, e, names))
                for n in names:
                    named[n] = named.get(n, 0) + 1
            except (OSError, ValueError, KeyError):
                continue
        swept = 0
        for n, (b, sz) in list(blobs.items()):
            if n not in named:
                b.unlink(missing_ok=True)
                total -= sz
                swept += 1
                del blobs[n]
        dropped = 0
        for _, e, names in sorted(entries, key=lambda x: x[0]):
            if total <= cap:
                break
            e.unlink(missing_ok=True)
            dropped += 1
            for n in names:
                named[n] -= 1
                if named[n] == 0 and n in blobs:
                    b, sz = blobs.pop(n)
                    b.unlink(missing_ok=True)
                    total -= sz
        log(f"store gc: {swept} blobs no entry named, {dropped} entries used longest ago; {total / 2**30:.1f} GB "
            f"(cap {STORE_CAP_GB:g})")


NO_COPY = "\0no-copy"  # out_to of a job run with --no-copy: nothing is copied out


TRUST_AGENT = os.environ.get("BUILD_RUNNER_TRUST_AGENT") == "1"
# the engine's trains, and the window's releases by rule 1 (docket-edge8 from p2851; paper-research N-1446 p2873)
TRAIN_AGENTS = set(filter(None, os.environ.get("BUILD_RUNNER_TRAIN_AGENTS", "docket-core,docket-edge8").split(",")))


def caller_agent(pid):
    """The caller's agent, as coordd placed it: the NAME of its cgroup .../agents/NAME/... (docket-core3 N-412 p1133:
    --train from docket-core only, by name). The cgroup is coordd's, not the caller's environment; its limit is
    coordd's own (identify_path reads the same). None when the caller is in no agent's cgroup."""
    try:
        return agent_of_cgroup(Path(f"/proc/{pid}/cgroup").read_text())
    except OSError:
        return None


# production's agents only: a scratch coord's agent of the same name is in no train (docket-core3 N-412 p1272)
AGENTS_CGROUP = os.environ.get("BUILD_RUNNER_AGENTS_CGROUP") or \
    f"/user.slice/user-{os.getuid()}.slice/user@{os.getuid()}.service/app.slice/coordd-research.service/agents"


def agent_of_cgroup(text):
    """NAME from the cgroup v2 line (`0::PATH`) when PATH is directly under production's agents root, else None."""
    for line in text.splitlines():
        if line.startswith("0::"):
            m = re.fullmatch(re.escape(AGENTS_CGROUP) + r"/([^/]+)/.*", line[3:])
            return m and m.group(1)
    return None


def job_agent(pid):
    """The agent a job file names: the NAME of the caller's cgroup .../agents/NAME/..., under whichever coordd placed
    it (the file names its coord beside it; `caller_agent` is production's alone, for the trains). None: in none."""
    try:
        for line in Path(f"/proc/{pid}/cgroup").read_text().splitlines():
            m = line.startswith("0::") and re.search(r"/agents/([^/]+)/", line[3:] + "/")
            if m:
                return m.group(1)
    except OSError:
        pass
    return None


def refusal(f, why):
    """A refused job's two lines to its caller: the words, and its end, `{"exit": 3, "refused": WHY}`, so the job's own
    line in the record says it was refused and why, not only rc 3 (proto-mind N-1446 p1502, head 2)."""
    f.write(f"build-runner: refused: {why}\n".encode())
    f.write(json.dumps({"exit": 3, "refused": why}).encode() + b"\n")


def train_refused(req):
    """Words for a --train request or a hold from a caller that is not a train's (store mode only; a hold's own
    steps are the train's already), else None."""
    if not STORE_MODE or req.get("in_hold") or req.get("agent") in TRAIN_AGENTS:
        return None
    return (f"{'a hold' if req.get('hold') else '--train'} is a train's: only {', '.join(sorted(TRAIN_AGENTS))} "
            f"sends one (you are {req.get('agent') or 'in no agent'}); for a piece: --front if it is on the list, else "
            "the queue (docket-core3 N-412 p1133)")


def caller_coord(pid):
    """The caller's coord, found by the service itself (docket-core3 N-412 p949): COORD in the environment of the
    outermost ancestor of the socket's peer that carries it (the agent's session, started by coord-pty). The caller can
    set its own COORD, not its ancestors'. None when no ancestor carries one. Its limit (docket-core3 p951): a caller
    that detaches (double fork, setsid) so that its parent is pid 1 has no ancestor left, and its own COORD counts;
    closing that would take the cgroup, as coordd does. tovrin-dev's lsp/ is refused whatever is found."""
    found, seen = None, set()
    while pid > 1 and pid not in seen:
        seen.add(pid)
        try:
            env = Path(f"/proc/{pid}/environ").read_bytes().split(b"\0")
            for kv in env:
                if kv.startswith(b"COORD="):
                    found = kv[6:].decode(errors="replace")
            st = Path(f"/proc/{pid}/stat").read_text()
            pid = int(st[st.rindex(")") + 2:].split()[1])
        except (OSError, ValueError, IndexError):
            break
    return found


def writable_for(path, wt, coord=None):
    """Whether the runner may write at PATH for a caller in worktree WT (docket-core3 N-412 p945 point 1, p947): resolved
    past links, inside WT, or (COORD, for --keep: the caller's own coord as its request names it) under COORD/lsp/,
    hs-ls's place; never under tovrin-dev's coord."""
    rp = Path(os.path.realpath(path))
    roots = [Path(os.path.realpath(wt))]
    if coord:
        c = Path(os.path.realpath(coord))
        ac = Path(os.path.realpath(Path.home() / "agent-coord"))
        if c.parent == ac and c.name != "tovrin-dev":
            roots.append(c / "lsp")
    return any(rp == r or rp.is_relative_to(r) for r in roots)


def mkdirs_within(d, root):
    """D made one folder at a time below ROOT, each checked (resolved past links) to stay inside ROOT before the next is
    made (p947); False, and nothing made past the first that leads out, when one does."""
    root, d = Path(os.path.realpath(root)), Path(d)
    if not root.exists():
        root.mkdir(parents=True)
    if not Path(os.path.abspath(d)).is_relative_to(root):
        return False
    rel = Path(os.path.abspath(d)).relative_to(root)
    cur = root
    for part in rel.parts:
        cur = cur / part
        if not cur.exists() and not cur.is_symlink():
            cur.mkdir()
        if not Path(os.path.realpath(cur)).is_relative_to(root):
            return False
    return True


def kept(line, place, keep):
    """A raw JSON line of a job run with --keep DIR (hs-ls, N-412 p940, p941): the proc-macro libraries it names and the
    OUT_DIR a build script filled are copied out of the place (which is emptied when the job ends) to DIR/so/ and
    DIR/out/<the script's folder>/, and the line is given back naming them there, for rust-analyzer's
    cargo.buildScripts.overrideCommand. A copy replaces the one before it whole."""
    try:
        m = json.loads(line)
    except ValueError:
        return line
    swaps = []
    real = lambda p: str(p).replace(str(AT_PLACE), str(place), 1)
    inside = lambda p: Path(os.path.realpath(real(p))).is_relative_to(os.path.realpath(place))
    keep_real = os.path.realpath(keep)
    def dest_ok(d):  # the folder written into, resolved past links, is still the one checked when the job came
        return Path(os.path.realpath(d)).is_relative_to(keep_real)
    try:
        if m.get("reason") == "compiler-artifact" and "proc-macro" in (m.get("target") or {}).get("kind", []):
            for fn in m.get("filenames") or []:
                if fn.endswith((".so", ".dylib", ".dll")):
                    if not inside(fn) or os.path.islink(real(fn)):
                        log(f"--keep {keep}: {fn} is not a file in the job's place: not copied")
                        continue
                    dst = Path(keep_real) / "so" / Path(fn).name
                    if not mkdirs_within(dst.parent, keep_real) or not dest_ok(dst.parent):
                        log(f"--keep {keep}: {dst.parent} leads outside it: not copied")
                        continue
                    tmp = dst.with_name(f".{dst.name}.{os.getpid()}-{threading.get_ident()}")
                    shutil.copy2(real(fn), tmp)
                    os.replace(tmp, dst)
                    swaps.append((fn, str(dst)))
        elif m.get("reason") == "build-script-executed" and m.get("out_dir"):
            od = m["out_dir"]
            links = [os.path.join(r, n) for r, ds, fs in os.walk(real(od)) for n in ds + fs
                     if os.path.islink(os.path.join(r, n))] if inside(od) else []
            if not inside(od) or os.path.islink(real(od)) or links:
                log(f"--keep {keep}: OUT_DIR {od} is outside the job's place or holds a link: not copied")
                return line
            dst = Path(keep_real) / "out" / Path(od).parent.name
            if not mkdirs_within(dst.parent, keep_real) or not dest_ok(dst.parent):
                log(f"--keep {keep}: {dst.parent} leads outside it: not copied")
                return line
            tmp = dst.with_name(f".{dst.name}.{os.getpid()}-{threading.get_ident()}")
            shutil.copytree(real(od), tmp)
            if dst.exists():
                old = dst.with_name(f".old-{dst.name}.{os.getpid()}-{threading.get_ident()}")
                os.replace(dst, old)
                os.replace(tmp, dst)
                shutil.rmtree(old, ignore_errors=True)
            else:
                os.replace(tmp, dst)
            swaps.append((od, str(dst)))
    except OSError as e:
        log(f"--keep {keep}: not copied: {e}")
        return line
    text = line.decode()
    for a, b in swaps:
        text = text.replace(json.dumps(a)[1:-1], json.dumps(b)[1:-1])
    return text.encode()


def prof_dir(tdir, prof, target):
    return Path(tdir) / (target or "") / ("debug" if prof == "debug" else prof)


UNIT_DIRS = ("deps", "build", ".fingerprint")
MANIFEST = "manifest.jsonl"  # per base folder: each file added, its size, time and hash (docket-core3 N-412 p897 point 4)
BAD = "bad.json"  # per base folder: the units found changed, taken out of every worktree folder at its next job


def unit_hash(name):
    """The hash of a unit's entry in deps/, build/ or .fingerprint/ (NAME-HASH, libNAME-HASH.rlib, NAME-HASH.d), or None."""
    m = re.search(r"-([0-9a-f]{16})(?:\.[A-Za-z0-9_.]+)?$", name)
    return m and m.group(1)


def read_manifest(base):
    out = {}
    try:
        for line in (Path(base) / MANIFEST).read_text().splitlines():
            try:
                e = json.loads(line)
                out[e["p"]] = e
            except (ValueError, KeyError):
                pass
    except OSError:
        pass
    return out


def read_bad(base):
    try:
        return set(json.loads((Path(base) / BAD).read_text()))
    except (OSError, ValueError):
        return set()


def sha1_file(p):
    h = hashlib.sha1()
    with open(p, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def check_base(base, prof, target, full):
    """The base's files as the manifest has them: size, time and read-only (every job), and the hash too when FULL (a
    train's job). A unit with a file that differs is taken out of the base and listed as bad, with a line in the log;
    never used silently. The bad units' hashes."""
    bdir = prof_dir(base, prof, target)
    man, bad = read_manifest(base), read_bad(base)
    found = set()
    for rel, e in man.items():
        h = unit_hash(Path(rel).parts[1]) if len(Path(rel).parts) > 1 else None
        if not h or h in bad:
            continue
        p = bdir / rel
        try:
            st = p.lstat()
        except FileNotFoundError:
            continue  # taken out by an emptying
        ok = (not p.is_symlink() and st.st_size == e["s"] and st.st_mtime_ns == e["m"] and not st.st_mode & 0o222
              and (not full or sha1_file(p) == e["h"]))
        if not ok:
            found.add(h)
            log(f"base {Path(base).name}: {rel} differs from what was added (size, time, mode or content); its unit is "
                "taken out of the base and of each worktree folder at its next job")
    if found:
        bad |= found
        tmp = Path(base) / (BAD + ".tmp")
        tmp.write_text(json.dumps(sorted(bad)))
        tmp.replace(Path(base) / BAD)
        for sub in UNIT_DIRS:
            for x in (bdir / sub).glob("*") if (bdir / sub).is_dir() else []:
                if unit_hash(x.name) in found:
                    move_out(x)
    return bad


def move_out(x):
    """Take X out: moved aside first, then removed, so a job starting meanwhile sees it whole or not at all."""
    aside = x.with_name(f".gone-{x.name}-{os.getpid()}-{threading.get_ident()}")
    try:
        os.rename(x, aside)
    except OSError:
        return
    if aside.is_dir() and not aside.is_symlink():
        shutil.rmtree(aside, ignore_errors=True)
        if aside.exists():  # a folder overlay left unreadable (a layer's work/work, mode 000): its folders opened first
            for root, dirs, _ in os.walk(aside):
                for d in dirs:
                    try:
                        os.chmod(os.path.join(root, d), 0o700)
                    except OSError:
                        pass
            shutil.rmtree(aside, ignore_errors=True)
    else:
        aside.unlink(missing_ok=True)


def link_tree(src, dst):
    """DST made as SRC: its folders new, its files hard links to SRC's; made beside and renamed in, so nothing half."""
    tmp = dst.with_name(f".new-{dst.name}-{os.getpid()}-{threading.get_ident()}")
    shutil.rmtree(tmp, ignore_errors=True)
    shutil.copytree(src, tmp, symlinks=True, copy_function=os.link)
    try:
        os.rename(tmp, dst)
    except OSError:
        shutil.rmtree(tmp, ignore_errors=True)  # another job made it meanwhile


def prepare_folder(tdir, base, prof, target, full):
    """The worktree's folder before a job: the base checked (FULL for a train), the units listed bad taken out of the
    folder, and every unit of the base the folder does not have linked in (the dependencies others built since). The
    folder's own files (cargo's locks, its top level) are its own; only units are linked."""
    bdir, wdir = prof_dir(base, prof, target), prof_dir(tdir, prof, target)
    wdir.mkdir(parents=True, exist_ok=True)
    tag = Path(tdir) / "CACHEDIR.TAG"
    if not tag.exists():
        tag.write_text("Signature: 8a477f597d28d172789f06886806bc55\n# This file is a cache directory tag created by cargo.\n"
                       "# For information about cache directory tags see https://bford.info/cachedir/\n")
    if not bdir.is_dir():
        return
    bad = check_base(base, prof, target, full)
    for sub in UNIT_DIRS:
        (wdir / sub).mkdir(exist_ok=True)
        have = set(os.listdir(wdir / sub))
        for x in have:
            if unit_hash(x) in bad:
                move_out(wdir / sub / x)
        if not (bdir / sub).is_dir():
            continue
        for x in os.listdir(bdir / sub):
            if x in have or x.startswith(".") or unit_hash(x) in bad:
                continue
            src, dst = bdir / sub / x, wdir / sub / x
            try:
                if src.is_dir() and not src.is_symlink():
                    link_tree(src, dst)
                elif src.is_file() and not src.is_symlink():
                    os.link(src, dst)
            except FileExistsError:
                pass


def registry_only(dfile, tdir):
    """Whether every source a dep-info file names lies in cargo's registry or git checkouts (or the build folder's
    own generated files): a dependency, not ours nor a path package (rune, wgpu-hal: docket-core3 N-412 p897 point 2)."""
    try:
        text = Path(dfile).read_text()
    except OSError:
        return False
    srcs = [str(CARGO_HOME / "registry") + "/", str(CARGO_HOME / "git") + "/", str(tdir) + "/"]
    any_ = False
    for line in text.splitlines():
        if ":" not in line or line.startswith("#"):
            continue
        _t, _, deps = line.partition(": ")
        for x in re.split(r"(?<!\\) ", deps.strip()):
            x = x.replace("\\ ", " ")
            if not x:
                continue
            if not x.startswith("/") or not any(x.startswith(r) for r in srcs):
                return False
            any_ = True
    return any_


def harvest(tdir, base, prof, target):
    """After a job: each dependency's build in the worktree's folder that the base lacks is added to it, as hard links,
    made read-only and listed with its size, time and hash. A unit is added only when its dep-info names registry or
    git sources alone; a build script's run by its package's name, when that name is a registry package's here and no
    other of its units is not. The number of units added."""
    wdir, bdir = prof_dir(tdir, prof, target), prof_dir(base, prof, target)
    if not (wdir / "deps").is_dir():
        return 0
    good, names, badnames = set(), set(), set()
    norm = lambda n: n.replace("-", "_")
    for d in (wdir / "deps").glob("*.d"):
        h = unit_hash(d.name)
        if not h:
            continue
        name = norm(d.name.rsplit("-", 1)[0])
        if registry_only(d, tdir):
            good.add(h)
            names.add(name)
        else:
            badnames.add(name)
    runs = []
    for b in (wdir / "build").glob("*") if (wdir / "build").is_dir() else []:
        h = unit_hash(b.name)
        if not h or not b.is_dir():
            continue
        ds = list(b.glob("*.d"))
        name = norm(b.name.rsplit("-", 1)[0])
        if ds:
            if all(registry_only(d, tdir) for d in ds):
                good.add(h)
                names.add(name)
            else:
                badnames.add(name)
        else:
            runs.append((h, name))
    for h, name in runs:
        if name in names and name not in badnames:
            good.add(h)
    bad = read_bad(base)
    added, lines = 0, []
    for sub in UNIT_DIRS:
        if not (wdir / sub).is_dir():
            continue
        (bdir / sub).mkdir(parents=True, exist_ok=True)
        have = set(os.listdir(bdir / sub))
        for x in os.listdir(wdir / sub):
            h = unit_hash(x)
            if x in have or x.startswith(".") or h not in good or h in bad:
                continue
            src, dst = wdir / sub / x, bdir / sub / x
            if src.is_symlink():
                continue
            if src.is_dir():
                link_tree(src, dst)
            else:
                try:
                    os.link(src, dst)
                except FileExistsError:
                    continue
            added += 1
            files = [dst] if dst.is_file() else [Path(r) / n for r, _, ns in os.walk(dst) for n in ns]
            for q in files:
                if q.is_symlink():
                    continue
                os.chmod(q, q.stat().st_mode & ~0o222)
                st = q.stat()
                lines.append(json.dumps({"p": str(q.relative_to(bdir)), "s": st.st_size, "m": st.st_mtime_ns,
                                         "h": sha1_file(q)}))
    if lines:
        with open(Path(base) / MANIFEST, "a") as m:
            m.write("\n".join(lines) + "\n")
    return added


def unlink_units(tdir, prof, target, paths):
    """The units holding PATHS in the worktree's folder get copies of their own files in place of the links (all of the
    folder's linked files, when no path names a unit). The number of files copied."""
    wdir = prof_dir(tdir, prof, target)
    hs = {unit_hash(Path(p).name) for p in paths} | {unit_hash(part) for p in paths for part in Path(p).parts}
    hs.discard(None)
    n = 0
    for sub in UNIT_DIRS:
        if not (wdir / sub).is_dir():
            continue
        for x in os.listdir(wdir / sub):
            if hs and unit_hash(x) not in hs:
                continue
            q0 = wdir / sub / x
            files = [q0] if q0.is_file() else [Path(r) / nm for r, _, ns in os.walk(q0) for nm in ns]
            for q in files:
                try:
                    st = q.lstat()
                except OSError:
                    continue
                if st.st_nlink > 1 and not q.is_symlink():
                    tmp = q.with_name(q.name + ".own")
                    shutil.copy2(q, tmp)
                    os.chmod(tmp, st.st_mode | 0o200)
                    os.replace(tmp, q)
                    n += 1
    return n


KINDS = ("engine", "window", "flavour", "proxy")


# cargo test's options that take a value (the next word is no test's name), for the rules and a job's line
CARGO_VALUED = frozenset({"-p", "--package", "--profile", "--features", "-F", "--target", "--manifest-path", "--test",
                          "--bin", "--example", "--bench", "-j", "--jobs", "--config", "--color", "--message-format",
                          "--exclude", "-Z"})
# the test harness's (libtest's) options after `--` that take a value
LIBTEST_VALUED = frozenset({"--skip", "--test-threads", "--logfile", "--format", "--color", "-Z", "--shuffle-seed"})


def tests_named(args):
    """What a test job ARGS names, for its line in the record (proto-mind N-1446 p1502, head 2: which tests it named,
    or whole), each as given and read as the rules read it (`refused_by_rules`): `tests`, the names (cargo's TESTNAME
    and the words after `--` that are neither an option nor an option's value); `targets`, the test binaries it picks
    (`--lib`, `--bin NAME`, `--test NAME`, `--doc`, ...); `skip`, what `--skip` leaves out; `exact`, `--exact`;
    `ignored`, "only" for `--ignored` and "too" for `--include-ignored`; `no_run`, a test build that runs nothing;
    `whole`, none of those narrowing it, so each named package's tests run whole, as a train's hold runs them
    (dev.eflint's JOB-WHOLE). {} for another verb."""
    if not args or args[0] not in ("test", "replay"):  # a replay's ARGS: `replay -- ` and the test binary's own
        return {}
    rest = args[1:]
    cut = rest.index("--") if "--" in rest else len(rest)
    opts, after = rest[:cut], rest[cut + 1:]
    tests, targets, skip = [], [], []
    i = 0
    while i < len(opts):
        a = opts[i]
        if a in ("--bin", "--test", "--example", "--bench") and i + 1 < len(opts):
            targets.append(f"{a} {opts[i + 1]}")
        elif a.startswith(("--bin=", "--test=", "--example=", "--bench=")):
            targets.append(a.replace("=", " ", 1))
        elif a in ("--lib", "--bins", "--tests", "--doc", "--examples", "--benches", "--all-targets"):
            targets.append(a)
        if a in CARGO_VALUED:
            i += 2
            continue
        if not a.startswith("-"):
            tests.append(a)
        i += 1
    i = 0
    while i < len(after):
        a = after[i]
        if a in LIBTEST_VALUED:
            if a == "--skip" and i + 1 < len(after):
                skip.append(after[i + 1])
            i += 2
            continue
        if a.startswith("--skip="):
            skip.append(a.split("=", 1)[1])
        elif not a.startswith("-"):
            tests.append(a)
        i += 1
    ignored = "only" if "--ignored" in after else "too" if "--include-ignored" in after else ""
    no_run = "--no-run" in opts
    return {"tests": tests, "targets": targets, "skip": skip, "exact": "--exact" in after, "ignored": ignored,
            "no_run": no_run, "whole": not (tests or targets or skip or ignored == "only" or no_run)}


def refused_by_rules(args, folder, prof, cwd, wt, cenv, front):
    """Why a builder's job is refused (N-412 p888, test 6), with the command to use instead; None when it keeps them."""
    verb, rest = args[0], args[1:]
    cut = rest.index("--") if "--" in rest else len(rest)
    opts, after = rest[:cut], rest[cut + 1:]
    if not folder:
        return ("a job names its kind: build-runner cargo --folder engine|window|flavour|proxy|symbols " + " ".join(args)
                + " (the kind names the job in status and the log; every job's compiles come from the one store)")
    if prof == "release" and not front:
        return ("a release build is a train's or an install's (--train, --front); for a piece: "
                f"build-runner cargo --folder {folder} {verb} --profile quick ...")
    for i, a in enumerate(opts):
        v = a.split("=", 1)[1] if a.startswith("--config=") else (opts[i + 1] if a == "--config" and i + 1 < len(opts) else "")
        if "target-dir" in v:
            return "the runner chooses the target folder: drop the --config that sets target-dir"
    for c in [Path(cwd)] + list(Path(cwd).parents):
        cfg = c / ".cargo" / "config.toml"
        try:
            if re.search(r"(?m)^\s*target-dir\s*=", cfg.read_text()):
                return f"{cfg} sets target-dir: take that line out; the runner chooses the target folder"
        except OSError:
            pass
        if str(c) == "/" or not str(c).startswith(wt):
            break
    if verb == "test":
        named = filt = False
        i = 0
        while i < len(opts):
            a = opts[i]
            if a in ("-p", "--package") or a.startswith("--package=") or (a.startswith("-p") and len(a) > 2):
                named = True
            if a in ("--test", "--bin") or a.startswith("--test=") or a.startswith("--bin="):
                filt = True
            if a in CARGO_VALUED:
                i += 2
                continue
            if not a.startswith("-"):
                filt = True  # cargo test's TESTNAME
            i += 1
        filt = filt or any(not a.startswith("-") for a in after)
        if "--no-run" not in opts and (not named or not filt):
            return ("a piece's test job names its package and its tests: build-runner cargo --folder "
                    f"{folder} test --profile quick -p PACKAGE -- TEST_NAME... (a whole crate's tests are a train's)")
    return None


def order(e):
    """A waiting request's place: --train ones first, then --front ones, each in the order they first came."""
    return (not e[8], not e[3], e[5])


def carried_order(x):
    """The same for a request a restart carried, [front, came, pid, train] (train absent from an older service's)."""
    return (not (len(x) > 3 and x[3]), not x[0], x[1])


def verb_of(args):
    return args[0] if args else "build"


def descends(pid, root):
    """PID is ROOT or one of its descendants (by /proc's parent links)."""
    for _ in range(64):
        if pid == root:
            return True
        if pid <= 1:
            return False
        try:
            with open(f"/proc/{pid}/stat") as f:
                pid = int(f.read().rsplit(")", 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            return False
    return False


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


GONE_KEPT = 7 * 86400  # how long a dead caller's job that never ended waits for its coord's next job to end it


def unended(path):
    """PATH, a job's file, does not say it ended (nor is it being ended by another caller, JOBS_DIR/ID.gone)."""
    if path.suffix != ".json" or path.with_suffix(".gone").exists():
        return False
    try:
        return json.loads(path.read_text()).get("step") != "ended"
    except (OSError, ValueError, AttributeError):
        return False


def stop_ends(job):
    """JOB's end said when its caller is stopped by SIGTERM, SIGHUP or SIGINT (an agent's turn stopped, its shell
    closed, ^C), then the signal's own way: rc minus the signal, `gone` with its name (docket-edge5 H-1651 p1). A
    signal already handled (a replay's SIGTERM, `replay`) keeps its handler. SIGKILL can't be caught: `end_gone`."""
    def stopped(sig, _frame):
        job.step("ended", rc=-sig, gone=f"its caller was stopped ({signal.Signals(sig).name})")
        signal.signal(sig, signal.SIG_DFL)
        os.kill(os.getpid(), sig)
    for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        try:
            if signal.getsignal(sig) in (signal.SIG_DFL, signal.default_int_handler):
                signal.signal(sig, stopped)
        except (ValueError, OSError):  # not the main thread
            pass


def held(path):
    """PATH is locked (`flock`) by a process: a job's line still waiting to be sent (`ACT_PY`), whose caller may be long
    gone when coordd was down for hours, so the day-old sweep leaves it."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC)
    except OSError:
        return False
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return False
    except OSError:
        return True
    finally:
        os.close(fd)


def size_gb(d):
    if not d.exists():
        return 0.0
    r = subprocess.run(["du", "-s", "--block-size=1", str(d)], capture_output=True, text=True)
    return int(r.stdout.split()[0]) / 2**30 if r.stdout else 0.0


def start():
    try:
        socket.socket(socket.AF_UNIX).connect(str(SOCK))
        return  # it runs
    except OSError:
        pass
    HOME.mkdir(parents=True, exist_ok=True)
    env = [f"BUILD_RUNNER_{k}={os.environ[f'BUILD_RUNNER_{k}']}" for k in ("JOBS", "SCOPE", "MIN_FREE_GB", "CAP_GB", "PARALLEL",
                                                                                     "PER_WORKTREE", "RULES", "STORE", "STORE_CAP_GB", "FRONT_KEPT", "PATH_EXTRA", "GIT_IDENTITY",
                                                                                     "TRAIN_AGENTS", "TRUST_AGENT", "FILE")
           if f"BUILD_RUNNER_{k}" in os.environ] + [f"BUILD_RUNNER_HOME={HOME}"] + (
        [f"HOME={os.environ['BUILD_RUNNER_USER_HOME']}"] if os.environ.get("BUILD_RUNNER_USER_HOME") else [])  # the machine's: /home/t's paths
    # not checked: a second caller starting it at the same moment is refused the unit's name, and finds the first's
    # socket below
    subprocess.run(["/usr/bin/systemd-run", "--user", "--collect", "--quiet", f"--unit={UNIT}",
                    "--slice=app.slice", "-p", f"WorkingDirectory={HOME}"] + [x for e in env for x in ("-E", e)]
                   + [sys.executable, "-I", SERVE_FILE, "serve"])
    for _ in range(50):
        try:
            socket.socket(socket.AF_UNIX).connect(str(SOCK))
            return
        except OSError:
            time.sleep(0.1)
    sys.exit(f"build-runner: started, but nothing answers on {SOCK}; its journal: journalctl --user -u {UNIT}")


def unit_active():
    return subprocess.run(["systemctl", "--user", "is-active", "-q", UNIT]).returncode == 0


def connect():
    """A connection to the service. No socket while the unit is active is a restart: the old service ends its running
    build, then the new one answers (started by restart, or by whichever caller first finds no unit). Waited for
    while the unit lives, the new one's socket being what ends the wait (the new one has the old one's unit name)."""
    told = False
    while True:
        s = socket.socket(socket.AF_UNIX)
        try:
            s.connect(str(SOCK))
            return s
        except OSError:
            pass
        if not unit_active():
            start()
            continue
        if not told:
            print("build-runner: the runner restarts after its running build; waiting for it", file=sys.stderr)
            told = True
        time.sleep(1)



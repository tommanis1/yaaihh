FREEABLE = ("target", "copy")  # what a press on Home may delete: cargo's build folders, made again by the next build,
# and copies of a live record, which he judges by looking (the walk's own words: "a target folder can go, a record
# copy is yours to judge")


def free(path):
    """Delete PATH, one item of the last walk that is FREEABLE (the owner's walk, item 20: "a way to deal with it"):
    a target folder (still cargo's: is_target) or a record copy (still a copy of a live record), named by the walk
    exactly, no link in its path, nothing never walked on the way. The walk's row is written again without it, its
    bytes taken off its folder, its project and the whole. {"freed": BYTES, "path"} or {"error": WHY}."""
    try:
        a = json.loads(OUTSIDE.read_text())
    except (OSError, ValueError):
        return {"error": f"no walk yet ({OUTSIDE})"}
    hit = next(((f, i) for f in a.get("folders", []) for i in f.get("items", []) if i.get("path") == path), None)
    if not hit:
        return {"error": f"{path} is not one of the last walk's findings; walk again first"}
    f, item = hit
    if item.get("what") not in FREEABLE:
        return {"error": f"{path} is a {item.get('what')}, which is not deleted from here ({' or '.join(FREEABLE)} only)"}
    p = os.path.abspath(path)
    rel = os.path.relpath(p, f["path"])
    if p != path or rel.startswith("..") or os.path.realpath(p) != p or any(never_walked(f["path"], x) for x in rel.split(os.sep)):
        return {"error": f"{path} is not a plain path inside {f['path']}"}
    if item["what"] == "target":
        if not (os.path.isdir(p) and is_target(p)):
            return {"error": f"{path} is no cargo build folder now"}
        shutil.rmtree(p)
    else:
        if not (os.path.isfile(p) and record_copy_of(p, live_heads())):
            return {"error": f"{path} is no copy of a live record now"}
        os.unlink(p)
    b = item.get("bytes", 0)
    f["items"].remove(item)
    f["bytes"] -= b
    f["folder_bytes"] = max(0, f.get("folder_bytes", 0) - b)
    f[{"target": "targets", "copy": "copies"}[item["what"]]] -= 1
    a["total_bytes"] = a.get("total_bytes", 0) - b
    if a.get("folder_bytes") is not None:
        a["folder_bytes"] -= b
    for x in a.get("projects", []):
        if x.get("id") == f.get("project", ""):
            x["bytes"] -= b
            x["folder_bytes"] -= b
            x["folders"] -= 0 if f["items"] else 1
    if not f["items"]:
        a["folders"].remove(f)
    tmp = OUTSIDE.with_name(f".{OUTSIDE.name}.{os.getpid()}.free")
    tmp.write_text(json.dumps(a))
    os.replace(tmp, OUTSIDE)
    log(f"freed {b} bytes: {path} ({item['what']}, {f.get('owner') or f.get('project') or f['path']}'s)")
    return {"freed": b, "path": path}


def outside_page(start):
    """A press on the walk's row: its items from START, folder by folder as the row lists them, each with its folder
    and owner."""
    try:

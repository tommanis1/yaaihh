#!/usr/bin/env bash
# build-runner-test DIR: the build runner's own test, in DIR (made empty first; nothing outside it is touched).
# Two worktrees of one workspace (crate `shared_name` at the same version, a binary printing its constant) differ only
# in that constant, as main and the edge worktree differ in docket_machine (N-412 p11). Through one service and one
# shared folder:
#   1. plain cargo on one target folder shows the fault the runner exists for (worktree b's build is taken as fresh
#      after a's, or links a's crate): printed, not required, since it depends on cargo's fingerprints;
#   2. through the runner, a, then b, then a again each print their own constant;
#   3. the executable is copied to <worktree>/target/debug/, and the worktree holds no compiled library;
#   4. a second request while one runs is queued and told behind whom; status names both.
# (and the later steps, each with its own heading; 21: at most two at once and the train's job, N-808)
set -euo pipefail
D=$(realpath -m "${1:?build-runner-test DIR}")
BR=$(dirname "$(readlink -f "$0")")/build-runner
rm -rf "$D"; mkdir -p "$D"
export BUILD_RUNNER_STORE=0 BUILD_RUNNER_RULES=0 BUILD_RUNNER_HOME=$D/home BUILD_RUNNER_JOBS=2 BUILD_RUNNER_UNIT=build-runner-test CARGO_NET_OFFLINE=true BUILD_RUNNER_FILE=$BR
mk() {  # mk NAME CONST: a git worktree with a workspace: crate shared_name (lib) and app (bin)
  local w=$D/$1
  mkdir -p "$w/shared/src" "$w/app/src"
  printf '[workspace]\nmembers = ["shared", "app"]\nresolver = "2"\n' >"$w/Cargo.toml"
  printf '[package]\nname = "shared_name"\nversion = "0.1.0"\nedition = "2021"\n' >"$w/shared/Cargo.toml"
  printf 'pub const WHO: &str = "%s";\n' "$2" >"$w/shared/src/lib.rs"
  printf '[package]\nname = "app"\nversion = "0.1.0"\nedition = "2021"\n[dependencies]\nshared_name = { path = "../shared" }\n' >"$w/app/Cargo.toml"
  printf 'fn main() { println!("{}", shared_name::WHO); }\n' >"$w/app/src/main.rs"
  git -C "$w" init -q && git -C "$w" add -A && git -C "$w" -c core.hooksPath=/dev/null -c user.name=t -c user.email=t@t commit -qm "$2"
  # the same mtimes in both, as two checkouts made in the same second have
  find "$w" -path "$w/.git" -prune -o -type f -exec touch -d '2026-11-17 12:00:00' {} +
}
mk a from-a; mk b from-b
fail() { echo "FAIL: $*"; exit 1; }

echo "== 1. plain cargo, one target folder for both"
(cd "$D/a" && cargo build -q --offline --target-dir "$D/plain" 2>&1 && "$D/plain/debug/app")
(cd "$D/b" && cargo build -q --offline --target-dir "$D/plain" 2>&1 && "$D/plain/debug/app") | sed 's/^/b prints: /'

echo "== 2. through the runner"
python3 -I "$BR" start
trap 'systemctl --user stop build-runner-test' EXIT
for w in a b a; do
  (cd "$D/$w" && python3 -I "$BR" cargo build -q >"$D/err-$w" 2>&1) || { cat "$D/err-$w"; fail "$w build"; }
  got=$("$D/$w/target/debug/app")
  echo "$w prints: $got"
  [ "$got" = "from-$w" ] || fail "$w printed $got"
done

echo "== 2b. the same in release: the clean takes out the release profile's crates"
for w in a b a; do
  (cd "$D/$w" && python3 -I "$BR" cargo build --release -q >"$D/err-$w" 2>&1) || { cat "$D/err-$w"; fail "$w release build"; }
  got=$("$D/$w/target/release/app"); echo "$w prints: $got"; [ "$got" = "from-$w" ] || fail "$w (release) printed $got"
done

echo "== 3. what the worktree holds"
find "$D/a/target" -type f | sed "s|$D/||"
[ "$(find "$D/a/target" -type f | wc -l)" = 2 ] || fail "a/target holds more than the two executables"
grep -q "build-runner: $D/a/target/release/app" "$D/err-a" || fail "the copied path was not said"
(cd "$D/b" && python3 -I "$BR" cargo --out o build -q 2>/dev/null)
[ "$("$D/b/o/app")" = from-b ] || fail "--out o: b's executable is not in b/o"

echo "== 3b. a --target build (the Windows exe's way, here with the host's triple): a folder of its own, its clean"
T=$(rustc -vV | sed -n 's/^host: //p')
for w in a b a; do
  (cd "$D/$w" && python3 -I "$BR" cargo build --release --target "$T" -q >"$D/err-$w" 2>&1) || { cat "$D/err-$w"; fail "$w --target build"; }
  got=$("$D/$w/target/$T/release/app"); echo "$w prints: $got"; [ "$got" = "from-$w" ] || fail "$w (--target) printed $got"
done
[ -d "$D/home/target/release-$T/$T/release" ] || fail "no folder release-$T"

echo "== 4. the queue"
# b's crate gets a build script that takes 3 s, so a's request comes while b's build runs
printf 'fn main() { std::thread::sleep(std::time::Duration::from_secs(3)); }\n' >"$D/b/shared/build.rs"
(cd "$D/b" && python3 -I "$BR" cargo build >"$D/q1" 2>&1) &
for _ in $(seq 100); do python3 -I "$BR" status | grep -q '^running: ' && ! python3 -I "$BR" status | grep -q 'running: nothing' && break; sleep 0.05; done
(cd "$D/a" && python3 -I "$BR" cargo build >"$D/q2" 2>&1) &
sleep 0.5; python3 -I "$BR" status
wait
head -3 "$D/q2"
grep -q '^build-runner: queued behind' "$D/q2" || fail "a's request was not queued behind b's"
"$D/a/target/debug/app" | grep -qx from-a || fail "a after the queue"; "$D/b/target/debug/app" | grep -qx from-b || fail "b after the queue"
echo "== 5. a test run: its results on stdout, its exit code back"
printf '#[test] fn who() { assert_eq!(WHO, "from-b"); }\n' >>"$D/a/shared/src/lib.rs"
if (cd "$D/a" && python3 -I "$BR" cargo test -q -p shared_name >"$D/t-out" 2>"$D/t-err"); then fail "a's failing test passed"; fi
grep -q 'test result: FAILED' "$D/t-out" || { cat "$D/t-out" "$D/t-err"; fail "no FAILED result on stdout"; }
(cd "$D/b" && printf '#[test] fn who() { assert_eq!(WHO, "from-b"); }\n' >>shared/src/lib.rs && python3 -I "$BR" cargo test -q -p shared_name >"$D/t-out" 2>/dev/null) || fail "b's test"
grep -q 'test result: ok. 1 passed' "$D/t-out" || fail "b's result"
echo "a's test fails and b's passes, each on its own code"
echo "== 6. raw JSON for rust-analyzer"
(cd "$D/b" && python3 -I "$BR" cargo check --message-format=json >"$D/j" 2>/dev/null) || fail "b's check"
grep -q '"reason":"build-finished","success":true' "$D/j" || fail "no raw build-finished line"
restart() { systemctl --user stop build-runner-test; env "$@" python3 -I "$BR" start; }  # the service with other limits

echo "== 7. --env and REPLAY_* reach a test; --folder takes a folder of its own"
printf '#[test] fn env() { assert_eq!(std::env::var("REPLAY_X").as_deref(), Ok("1")); assert_eq!(std::env::var("MINE").as_deref(), Ok("2")); }\n' >>"$D/b/shared/src/lib.rs"
(cd "$D/b" && REPLAY_X=1 MINE=2 python3 -I "$BR" cargo --env MINE test -q -p shared_name >"$D/t-out" 2>&1) || { cat "$D/t-out"; fail "env test"; }
(cd "$D/b" && REPLAY_X=1 python3 -I "$BR" cargo test -q -p shared_name >"$D/t-out" 2>&1) && fail "MINE reached cargo without --env"
(cd "$D/b" && python3 -I "$BR" cargo --folder ra check -q 2>/dev/null) || fail "--folder ra"
[ -d "$D/home/target/ra-debug" ] || fail "no folder ra-debug"
echo "MINE only with --env; REPLAY_X always; ra-debug made"

echo "== 8. the disk floor"
restart BUILD_RUNNER_MIN_FREE_GB=100000
rc=0; (cd "$D/a" && python3 -I "$BR" cargo build -q >"$D/d-out" 2>&1) || rc=$?
grep '^build-runner: refused' "$D/d-out"; [ $rc = 3 ] || fail "below the floor: rc $rc"

echo "== 9. the cap"
restart BUILD_RUNNER_CAP_GB=0.000001
(cd "$D/a" && python3 -I "$BR" cargo build -q >"$D/c-out" 2>&1) || fail "build after the cap"
grep '^build-runner: the folder debug' "$D/c-out" || fail "the folder over its cap was not emptied"
[ "$("$D/a/target/debug/app")" = from-a ] || fail "a after the cap"

running() {  # running WHO-DIR: until the service runs a build from that worktree
  for _ in $(seq 200); do python3 -I "$BR" status | grep -q "^running: .* in $D/$1:" && return; sleep 0.05; done; fail "$1 never ran"
}
echo "== 10. no time limit per job (the owner's rule of 14 Nov); a build whose caller is killed is stopped then, while
#   its build script prints nothing, not at its next line (a2h-speed N-1446 p3251, paper-research p3253)"
restart
printf 'fn main() { std::thread::sleep(std::time::Duration::from_secs(30)); }\n' >"$D/a/shared/build.rs"
(cd "$D/a" && exec python3 -I "$BR" cargo build -q >"$D/m-out" 2>&1) & p1=$!
running a
t0=$(date +%s); kill -9 $p1; wait $p1 2>/dev/null
for _ in $(seq 200); do grep -q "stopped (caller gone: its connection ended) $D/a" "$D/home/build-runner.log" && break; sleep 0.05; done
grep -q "stopped (caller gone: its connection ended) $D/a" "$D/home/build-runner.log" || fail "the killed caller's build was not stopped"
echo "stopped $(( $(date +%s) - t0 )) s after its caller was killed"; [ $(( $(date +%s) - t0 )) -lt 10 ] || fail "not stopped at once"
rm "$D/a/shared/build.rs"

echo "== 11. --front: behind the --front ones waiting, ahead of the rest"
printf 'fn main() { std::thread::sleep(std::time::Duration::from_secs(15)); }\n' >"$D/b/shared/build.rs"
(cd "$D/b" && python3 -I "$BR" cargo build -q >"$D/f1" 2>&1) & p1=$!
running b
(cd "$D/a" && python3 -I "$BR" cargo build -q >"$D/f2" 2>&1) & p2=$!
for _ in $(seq 400); do python3 -I "$BR" status | grep -q '^waiting: ' && break; sleep 0.05; done
(cd "$D/a" && python3 -I "$BR" cargo --front check -q >"$D/f3" 2>&1) & p3=$!
for _ in $(seq 400); do [ "$(python3 -I "$BR" status | grep -c '^waiting')" = 2 ] && break; sleep 0.05; done
python3 -I "$BR" status | grep '^waiting' | tee "$D/f-status"
head -1 "$D/f-status" | grep -q '^waiting (front): .*cargo check' || fail "the --front check is not first in the queue"
wait $p1 $p2 $p3 || fail "a build of step 11"

echo "== 12. restart while one build runs and one waits: neither is stopped, and the service becomes this file in place"
printf 'fn main() { std::thread::sleep(std::time::Duration::from_secs(5)); }\n' >"$D/b/shared/build.rs"
old=$(systemctl --user show -p MainPID --value build-runner-test)
(cd "$D/b" && python3 -I "$BR" cargo build -q >"$D/r1" 2>&1) & p1=$!
running b
printf 'pub const WHO: &str = "from-a2";\n' >"$D/a/shared/src/lib.rs"
# the waiting caller runs another copy of the runner, as an agent's worktree has: it must not start one of its own
mkdir -p "$D/copy" && cp "$BR" "$D/copy/build-runner"
(cd "$D/a" && python3 -I "$D/copy/build-runner" cargo build -q >"$D/r2" 2>&1) & p2=$!
for _ in $(seq 100); do python3 -I "$BR" status | grep -q '^waiting: ' && break; sleep 0.05; done
python3 -I "$BR" restart | tee "$D/r-out"
wait $p1 || { cat "$D/r1"; fail "the running build was stopped by the restart"; }
wait $p2 || { cat "$D/r2"; fail "the waiting build failed after the restart"; }
grep -q 'goes to the new one' "$D/r2" || fail "the waiting request was not sent again"
[ "$("$D/b/target/debug/app")" = from-b ] && [ "$("$D/a/target/debug/app")" = from-a2 ] || fail "after the restart"
new=$(systemctl --user show -p MainPID --value build-runner-test)
echo "service pid $old, then $new: $(tr '\0' ' ' </proc/$new/cmdline)"
[ "$new" = "$old" ] || fail "the restart did not happen in place"
tr '\0' ' ' </proc/$new/cmdline | grep -qF -- " -I $BR serve " || fail "the service does not run this file"
grep -q "this service becomes $BR" "$D/home/build-runner.log" || fail "no exec in the log"

echo "== 13. a worktree switch onto a manifest with a Windows-only dependency never downloaded"
# as flavor/app's `arbitrary` (docket-core N-412 p142): the Linux build needs no download, cargo's full metadata does,
# and offline fails; the switch reads only --no-deps metadata. Uses this machine's registry: arbitrary 1.5.0 indexed,
# not downloaded (when it is downloaded, the step still runs but no longer shows the fault)
rm "$D/b/shared/build.rs"
printf "[target.'cfg(windows)'.dependencies]\narbitrary = \"=1.5.0\"\n" >>"$D/b/app/Cargo.toml"
(cd "$D/b" && cargo metadata --offline --format-version 1 >/dev/null 2>&1) && echo "(arbitrary is downloaded here: the fault is not shown)"
for w in a b; do
  (cd "$D/$w" && python3 -I "$BR" cargo build -q >"$D/err-$w" 2>&1) || { cat "$D/err-$w"; fail "$w build after the switch"; }
done
grep -q 'taking out our crates (2) before building' "$D/err-b" || { cat "$D/err-b"; fail "b's switch did not take out our 2 crates"; }
[ "$("$D/b/target/debug/app")" = from-b ] || fail "b after the switch"
echo "b built after the switch, its 2 crates taken out"

echo "== 14. two folders side by side; a third request in a busy folder waits, and does not hold up a free one"
printf 'fn main() { std::thread::sleep(std::time::Duration::from_secs(5)); }\n' >"$D/b/shared/build.rs"
printf 'fn main() { std::thread::sleep(std::time::Duration::from_secs(6)); }\n' >"$D/a/shared/build.rs"  # so a's runs are seen
(cd "$D/b" && python3 -I "$BR" cargo build -q >"$D/p1" 2>&1) & p1=$!
running b
(cd "$D/a" && python3 -I "$BR" cargo build -q >"$D/p2" 2>&1) & p2=$!   # debug is busy: waits
for _ in $(seq 100); do python3 -I "$BR" status | grep -q '^waiting: ' && break; sleep 0.05; done
(cd "$D/a" && python3 -I "$BR" cargo --folder side check -q >"$D/p3" 2>&1) & p3=$!  # a free folder: starts
for _ in $(seq 200); do [ "$(python3 -I "$BR" status | grep -c '^running: ')" = 2 ] && break; sleep 0.05; done
python3 -I "$BR" status | grep -E '^(running|waiting)' | tee "$D/p-status"
[ "$(grep -c '^running: ' "$D/p-status")" = 2 ] || fail "two folders did not run side by side"
grep -q '^running: .*folder side-debug' "$D/p-status" || fail "the free folder's check did not start"
grep -q '^waiting: .*folder debug[,)]' "$D/p-status" || fail "a's build in the busy debug folder did not wait"
wait $p1 && wait $p2 && wait $p3 || fail "a build of step 14"

echo "== 15. a switch onto a second workspace that reaches the first through a path dependency"
# as the proxy reaches crates/usage/prices: of the first workspace only shared_name is in its graph, not app, and
# `cargo clean -p app` would refuse the name
rm -f "$D/a/shared/build.rs" "$D/b/shared/build.rs"
for w in a b; do
  mkdir -p "$D/$w/tool/src"
  printf '[workspace]\n[package]\nname = "tool"\nversion = "0.1.0"\nedition = "2021"\n[dependencies]\nshared_name = { path = "../shared" }\n' >"$D/$w/tool/Cargo.toml"
  printf 'fn main() { println!("tool {}", shared_name::WHO); }\n' >"$D/$w/tool/src/main.rs"
  sed -i 's/^members = \["shared", "app"\]$/members = ["shared", "app"]\nexclude = ["tool"]/' "$D/$w/Cargo.toml"
done
for w in a b; do
  (cd "$D/$w" && python3 -I "$BR" cargo build -q --manifest-path tool/Cargo.toml >"$D/err-$w" 2>&1) || { cat "$D/err-$w"; fail "$w's tool build"; }
done
grep -q 'taking out our crates (2) before building' "$D/err-b" || { cat "$D/err-b"; fail "b's switch did not take out tool and shared_name only"; }
[ "$("$D/b/tool/target/debug/tool")" = "tool from-b" ] || fail "b's tool after the switch"
echo "b's tool built after the switch, 2 crates taken out (tool, shared_name; not app)"

echo "== 16. test --no-run: the test binary is copied out and runs again after another worktree's build"
(cd "$D/b" && python3 -I "$BR" cargo test --no-run -q -p shared_name >"$D/n-out" 2>"$D/n-err") || { cat "$D/n-err"; fail "b's test --no-run"; }
tb=$(sed -n "s|^build-runner: \($D/b/target/debug/deps/shared_name-[0-9a-f]*\)$|\1|p" "$D/n-err" | head -1)
[ -x "$tb" ] || { cat "$D/n-err"; fail "no test binary copied to b/target/debug/deps"; }
(cd "$D/a" && python3 -I "$BR" cargo build -q 2>/dev/null) || fail "a's build"
"$tb" who -q 2>&1 | grep -q 'test result: ok. 1 passed' || fail "b's copied test binary after a's build"
echo "b's test binary ${tb#$D/} ran after a's build"

echo "== 17. a restart keeps the waiting in their order"
printf 'fn main() { std::thread::sleep(std::time::Duration::from_secs(5)); }\n' >"$D/b/shared/build.rs"
(cd "$D/b" && python3 -I "$BR" cargo build -q >/dev/null 2>&1) & p1=$!
running b
printf 'pub const WHO: &str = "from-a3";\n' >"$D/a/shared/src/lib.rs"
(cd "$D/a" && python3 -I "$BR" cargo build -q >"$D/o1" 2>&1) & p2=$!
for _ in $(seq 100); do [ "$(python3 -I "$BR" status | grep -c '^waiting')" = 1 ] && break; sleep 0.05; done
(cd "$D/a" && python3 -I "$BR" cargo check -q >"$D/o2" 2>&1) & p3=$!
for _ in $(seq 100); do [ "$(python3 -I "$BR" status | grep -c '^waiting')" = 2 ] && break; sleep 0.05; done
n=$(wc -l <"$D/home/build-runner.log")
python3 -I "$BR" restart >/dev/null
wait $p1 && wait $p2 && wait $p3 || fail "a build of step 17"
tail -n +$((n + 1)) "$D/home/build-runner.log" | grep -E '^[0-9-]+ [0-9:]+ start ' | grep -oE '(build|check) -q$' | tr '\n' ' ' | tee "$D/o-order"; echo
[ "$(cat "$D/o-order")" = "build -q check -q " ] || fail "the waiting did not keep their order"
echo "== 18. a caller from before ed07606 (it sends no first time when it comes again) holds nobody after a restart"
# the old caller is the runner's client as it was: the line that sends the first time again taken out (N-480)
grep -v 'req\["came"\] = m.get("came")' "$BR" >"$D/old-runner"
cmp -s "$BR" "$D/old-runner" && fail "step 18's old caller is the same as the runner"
(cd "$D/b" && python3 -I "$BR" cargo build -q >/dev/null 2>&1) & p1=$!
running b
printf 'pub const WHO: &str = "from-a4";\n' >"$D/a/shared/src/lib.rs"
(cd "$D/a" && python3 -I "$D/old-runner" cargo build -q >"$D/o1" 2>&1) & p2=$!
for _ in $(seq 100); do [ "$(python3 -I "$BR" status | grep -c '^waiting')" = 1 ] && break; sleep 0.05; done
n=$(wc -l <"$D/home/build-runner.log")
python3 -I "$BR" restart >/dev/null
(cd "$D/a" && python3 -I "$BR" cargo --folder side check -q >"$D/o2" 2>&1) & p3=$!
for _ in $(seq 400); do [ "$(tail -n +$((n + 1)) "$D/home/build-runner.log" | grep -cE '^[0-9-]+ [0-9:]+ start ')" = 2 ] && break; sleep 0.1; done
[ "$(tail -n +$((n + 1)) "$D/home/build-runner.log" | grep -cE '^[0-9-]+ [0-9:]+ start ')" = 2 ] || fail "after the restart the old caller's build and the later one did not both start (held as expected)"
wait $p1 && wait $p2 && wait $p3 || fail "a build of step 18"
echo "both started after the restart"
echo "== 19. a caller that goes while it waits leaves the queue; its build does not run later"
(cd "$D/b" && python3 -I "$BR" cargo build -q >/dev/null 2>&1) & p1=$!
running b
printf 'pub const WHO: &str = "from-a5";\n' >"$D/a/shared/src/lib.rs"
(cd "$D/a" && exec python3 -I "$BR" cargo build -q >/dev/null 2>&1) & p2=$!
for _ in $(seq 100); do [ "$(python3 -I "$BR" status | grep -c '^waiting')" = 1 ] && break; sleep 0.05; done
kill "$p2"; wait "$p2" 2>/dev/null || true
for _ in $(seq 50); do [ "$(python3 -I "$BR" status | grep -c '^waiting')" = 0 ] && break; sleep 0.1; done
[ "$(python3 -I "$BR" status | grep -c '^waiting')" = 0 ] || fail "the gone caller's request still waits"
grep -q 'left the queue, its caller gone' "$D/home/build-runner.log" || fail "no log line for the gone caller"
wait $p1 || fail "b's build of step 19"
echo "the gone caller left the queue"
echo "== 20. a cold build takes at most PARALLEL - 1 places: a second cold one waits, a warm one takes the free place"
restart BUILD_RUNNER_PARALLEL=2
n=$(wc -l <"$D/home/build-runner.log")
(cd "$D/b" && python3 -I "$BR" cargo --folder cold1 build -q >/dev/null 2>&1) & p1=$!
for _ in $(seq 200); do python3 -I "$BR" status | grep -q "^running: .* in $D/b: .*folder cold1-debug, cold" && break; sleep 0.05; done
(cd "$D/a" && python3 -I "$BR" cargo --folder cold2 build -q >/dev/null 2>&1) & p2=$!
for _ in $(seq 100); do python3 -I "$BR" status | grep -q "^waiting: .*folder cold2-debug, cold" && break; sleep 0.05; done
(cd "$D/b" && python3 -I "$BR" cargo check -q >/dev/null 2>&1) & p3=$!
wait $p1 && wait $p2 && wait $p3 || fail "a build of step 20"
# from the log, in order: the cold build in b starts, the warm check in b starts and ends beside it, and only after the
# cold build in b ends does the cold one in a start
tail -n +$((n + 1)) "$D/home/build-runner.log" | grep -E ' (start|end rc) ' | sed -E "s#.*(start|end rc).* $D/(a|b)[ :].*(build -q|check -q).*#\1 \2 \3#" | tr '\n' ';' >"$D/o20"; echo >>"$D/o20"
cat "$D/o20"
[ "$(cat "$D/o20")" = "start b build -q;start b check -q;end rc b check -q;end rc b build -q;start a build -q;end rc a build -q;" ] || fail "the warm check did not run beside the cold build, or the second cold one did not wait"
echo "the warm check ran beside the cold build; the second cold one waited"
echo "== 21. at most two at once across all folders, read from the file beside the state (it wins over the environment);
#   a --train job goes to the head, waits for the running ones to end, runs alone, and the rest waits behind it (N-808)"
restart BUILD_RUNNER_PARALLEL=4
echo 2 >"$D/home/parallel"
printf 'fn main() { std::thread::sleep(std::time::Duration::from_secs(6)); }\n' >"$D/b/shared/build.rs"
printf 'fn main() { std::thread::sleep(std::time::Duration::from_secs(6)); }\n' >"$D/a/shared/build.rs"
n=$(wc -l <"$D/home/build-runner.log")
# three asked at once, each warm in a folder of its own
(cd "$D/b" && python3 -I "$BR" cargo --folder cold1 build -q >/dev/null 2>&1) & p1=$!
sleep 0.3
(cd "$D/a" && python3 -I "$BR" cargo --folder cold2 build -q >/dev/null 2>&1) & p2=$!
sleep 0.3
(cd "$D/b" && python3 -I "$BR" cargo check -q >"$D/w3" 2>&1) & p3=$!

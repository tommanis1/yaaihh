// Not stated, because the text read does not confirm it; an arm that needs one is not let on Claude Code:
//   before_model_call, any power     it has no hook before each request to the provider; the moment is not reached
//   compacting, modify               PreCompact is reached; what its answer may change was not read
//   overloaded, suspend              StopFailure is reached; taking the turn up again is our own delivery of words

// ===== Delivery: pushed ==========================================================================================
// What std.delivery holds for an agent reaches a Claude Code session by being pushed into it: the turns driver
// types it into the session's terminal, and words typed into an idle session begin its turn.
//   idle               whatever waits is pushed at once, as one word
//   in a turn          nothing is pushed but an interrupting word, which goes in at once: Claude Code reads words
//                      typed during a turn at its next step
//   the turn's end     (Stop) what that turn was handed is read, and whatever came during it is pushed as one word
//   a failed turn      (StopFailure) what it was handed waits again, and goes with the next word
// Only an agent the project delivers to by "claude-code" (D.Agent) is pushed to.
Effect Push-Channel(agent: H.Party, envelope: String) -> Unit      // the turns driver's: typed when idle, held in a turn
Effect Push-Channel-Now(agent: H.Party, msg: String) -> Unit       // the turns driver's: typed at once, in a turn too

+H.Party("std.bridges.claude_code"). +D.Carrier("std.bridges.claude_code").

// One word with all that waits: the directive to put first, the others, the items, then each message on a line.
fn envelope(w: D.Waiting) -> Program<String> {
  ds <- do D.joined(w.directives, "; ");
  is <- do D.joined(w.items, ", ");
  ls <- do D.joined(w.lines, "\n");
  head <- if w.top != "" { return "First: {{ w.top }}\n" } else { return "" };
  dirs <- if ds != "" { return "Directives: {{ ds }}\n" } else { return "" };
  items <- if is != "" { return "Assigned: {{ is }}\n" } else { return "" };
  return "[coord delivery]\n{{ head }}{{ dirs }}{{ items }}{{ ls }}"
}

fn push(agent: H.Party) -> Program<Unit> {
  w <- do D.waiting(agent);
  text <- do envelope(w);
  perform Push-Channel(agent, text);
  do D.hand(agent, w);
  D.Wake(self, agent)
}

on D.Post(by, to, msg, text, "Normal") where D.Agent(to, "claude-code", r) && D.Idle(to) do {
  do push(to)
}
// only into a running session: one not running is given what waits when it starts (below)
on D.Post(by, to, msg, text, "Interrupt") where D.Agent(to, "claude-code", r) && H.Running-On(to, "claude-code", v) do {
  perform Push-Channel-Now(to, "[coord delivery, interrupting] [{{ msg }} from {{ by }}] {{ text }}");
  D.Hand(self, to, msg);
  if Not(Holds(D.Woken(to))) { D.Wake(self, to) }
}
on D.Direct(by, agent, text, p) where D.Agent(agent, "claude-code", r) && D.Idle(agent) do {
  do push(agent)
}
on R.Assign(giver, agent, item) where D.Agent(agent, "claude-code", r) && D.Idle(agent) do {
  do push(agent)
}
// a session started (again): what a session before it was handed and never read is handed back, and what waits is
// pushed (N-1978 p5, point 2)
on H.Session-Started(agent, "claude-code", v) where D.Agent(agent, "claude-code", r) do {
  if Holds(D.Woken(agent)) || (Exists m : D.In-Flight(agent, m)) { D.Unwake(self, agent) };
  if Exists x : D.Needs-Agent(agent, x) { do push(agent) }
}
on H.Reach(agent, "turn_end") where D.Agent(agent, "claude-code", r)
   && (D.Woken(agent) || (Exists m : D.In-Flight(agent, m)) || (Exists x : D.Needs-Agent(agent, x))) do {
  D.Settle(self, agent);
  if Exists x : D.Needs-Agent(agent, x) { do push(agent) }
}
on H.Reach(agent, "overloaded") where D.Agent(agent, "claude-code", r)
   && (D.Woken(agent) || (Exists m : D.In-Flight(agent, m))) do {
  D.Unwake(self, agent)
}

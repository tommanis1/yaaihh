stand-in: Tool-Use(b1, edit-4) -> ToolUse { tool: edit, command: "", changes: [FileChange { kind: edit, path: crates/coordd/src/core.rs, from: "", patch: "", added: "    let n = 3;" }, FileChange { kind: edit, path: agent-base/renderings/words/posts.tmpl, from: "", patch: "", added: "    pub bare: bool," }] }

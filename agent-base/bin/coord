#!/usr/bin/env bash
# coord: the agents' commands in one box.
#
#   coord msg [--esc] [--re ID] NAME[,NAME...] TEXT...   a message; first line = subject (--esc: agents below me; --re: in ID's thread)
#   coord msg --thread ID TEXT...     a reply in ID's thread to everyone in it
#   coord mail [ID]                   my recent mail, or one mail in full
#   coord ask [--on QID] SUBJECT...   (run by the agent) a question to the owner, explanation on stdin; does not wait
#   coord ask --drop QID [WHY...]     withdraw my question
#   coord ask --list                  my questions: open, answered or dropped, each thread with the answers in full
#   coord ls                          each agent: name, id, state, parent
#   coord log NAME [LAST]             the session of an agent below me, as text
#   coord item start ID | open TITLE | close ID WHY...
#   coord ack RULING                  (run by the agent) record its ruling base
#   coord ready [--item I] [--also WORKTREE]... [--with BRANCH]...  (run by the agent) queue its branch at HEAD
#   coord queue                       each queue entry and the runner's state for it
#   coord attach NAME                 NAME's terminal in this one (Ctrl-\ detaches; from the host, through the box)
#
# msg, mail, ask, ls (state), log and item are coordd's (bin/coordc): it knows the caller by its process's cgroup, never by
# a name it gives, and keeps the agents, their mail and the project's items. A host session (hosts/NAME: the resume id
# of a Claude Code session on the host) sends as itself through the owner side: from the host, these commands run
# inside the box, with COORD_AS=NAME. There is no stop or lock: pausing an agent is Escape in its terminal (owner,
# 5 Nov 2026). attach is coordc's too, but needs no coordd: it speaks to the agent's terminal holder (bin/coord-pty).
# The build queue (a project's runner, until the project file owns it): agents
# never build; `coord ready` writes queue/AGENT.json {agent, branch, commit, item, with, at, also}, one file per agent, a
# newer ready replacing the older. Only the runner writes queue/state/AGENT.json
# {commit, state: waiting|batch|landed|rejected, batch, reason, at}; a state whose commit is
# not the entry's commit is stale and shows as waiting. A ready that conflicts with dev is
# refused; one that conflicts with another queued entry is refused and recorded in
# queue/blocked/AGENT.json {agent, branch, commit, clashes: [{agent, files}], at}, which the
# runner clears when the other entry lands; a later successful ready removes it.
set -euo pipefail
: "${COORD:?COORD is not set}"
me=${AGENT_NAME:-owner}
feed() { jq -nc --arg at "$(date -Is)" --arg from "$me" "$@" >>"$COORD/feed.jsonl"; }
usage() { sed -n '4,15p' "$0" | sed 's/^# //'; exit 2; }

# On the host, a box's coord folder (~/agent-coord/BOX, the same path inside the box) belongs to the box, and coordd's
# socket lives in the box VM: coordd's commands run inside the box (a stopped box has no coordd, so they fail), and so
# does attach, whose holders' sockets are the box's too. A project without a box has its coordd on the host, at
# COORDD_SOCK (bin/host-coordd sh sets it): no box is reached then.
box=${COORD#"$HOME/agent-coord/"}
case ${1:-} in msg | mail | ask | ls | state | log | item | attach)
  if [ -z "${COORDD_SOCK:-}" ] && [ ! -S /run/coordd.sock ] && [ "$box" != "$COORD" ] && [ "${box%/*}" = "$box" ] && [ -x "$(dirname "$0")/../box/box.sh" ]; then
    as=(); [ "$me" = owner ] || as=(COORD_AS="$me")
    exec "$(dirname "$0")/../box/box.sh" sh "$box" env "${as[@]}" coord "$@"
  fi ;;
esac

case ${1:-} in
msg) shift; exec "$(dirname "$0")/coordc" msg ${COORD_AS:+--as "$COORD_AS"} "$@" ;;
mail|ask|ls|state|log|item) exec "$(dirname "$0")/coordc" "$@" ;;
attach) [ $# -eq 2 ] || usage; exec "$(dirname "$0")/coordc" attach "$2" ;;
ack)
  [ $# -eq 2 ] && [ "$me" != owner ] || { echo "coord ack RULING runs inside an agent session (AGENT_NAME set)" >&2; exit 2; }
  mkdir -p "$COORD/agents/$me" && echo "$2" >"$COORD/agents/$me/ruling"
  feed --arg ruling "$2" '{kind: "ack", at: $at, from: $from, ruling: $ruling}'
  echo "acknowledged ruling #$2"
  ;;
ready)
  [ "$me" != owner ] || { echo "coord ready runs inside an agent session (AGENT_NAME set)" >&2; exit 2; }
  shift; item= with=() alsos=()
  while [ $# -gt 0 ]; do
    case $1 in
      --item) item=${2:?--item needs an item}; shift 2 ;;
      --with) with+=("${2:?--with needs a branch}"); shift 2 ;;
      --also) alsos+=("${2:?--also needs a worktree folder name}"); shift 2 ;;
      *) usage ;;
    esac
  done
  branch=$(git symbolic-ref --short -q HEAD) || { echo "coord ready: HEAD is detached; run it on your branch" >&2; exit 1; }
  [ -z "$(git status --porcelain --untracked-files=no)" ] || { echo "coord ready: uncommitted changes to tracked files; commit first" >&2; exit 1; }
  commit=$(git rev-parse HEAD) top=$(git rev-parse --show-toplevel) also='[]'
  udirs=("$top") ucommits=("$commit")
  # Only the worktrees named with --also (folder names beside this one in .wt/NAME, e.g. the agent's
  # P4 worktree) ride along as one unit.
  for n in "${alsos[@]}"; do
    d=$(dirname "$top")/$n
    [ "$d" != "$top" ] && [ -e "$d/.git" ] ||
      { echo "coord ready: --also $n: no worktree $d (worktrees here: $(cd "$(dirname "$top")" && ls -d */ | tr -d / | tr '\n' ' '))" >&2; exit 1; }
    b=$(git -C "$d" symbolic-ref --short -q HEAD) || { echo "coord ready: --also $n: HEAD is detached" >&2; exit 1; }
    c=$(git -C "$d" rev-parse HEAD)
    ! git -C "$d" merge-base --is-ancestor "$c" dev 2>/dev/null ||
      { echo "coord ready: --also $n: $b has nothing that dev lacks" >&2; exit 1; }
    [ -z "$(git -C "$d" status --porcelain --untracked-files=no)" ] ||
      { echo "coord ready: uncommitted changes to tracked files in $d; commit first" >&2; exit 1; }
    also=$(jq -c --arg branch "$b" --arg commit "$c" '. + [{branch: $branch, commit: $commit}]' <<<"$also")
    udirs+=("$d") ucommits+=("$c")
  done
  # Clashes at submit time (orch, owner-agreed 5 Nov): each of this entry's commits must merge with
  # dev and with every commit still queued in its repository (not landed or rejected), except this
  # agent's own entry and its --with partners.
  for i in "${!udirs[@]}"; do
    rc=0; git -C "${udirs[i]}" merge-tree --write-tree dev "${ucommits[i]}" >/dev/null || rc=$?
    [ $rc -eq 0 ] || { [ $rc -eq 1 ] && echo "coord ready: ${ucommits[i]:0:9} in ${udirs[i]} conflicts with dev; merge dev" >&2 ||
      echo "coord ready: git merge-tree failed ($rc) in ${udirs[i]}" >&2; exit 1; }
  done
  mine=$(jq -c --arg b "$branch" '[$b] + map(.branch)' <<<"$also") clashes='[]'
  for q in "$COORD"/queue/*.json; do
    [ -f "$q" ] || continue; a=$(basename "$q" .json); [ "$a" != "$me" ] || continue
    jq -e --argjson mine "$mine" --args '([.branch] + ((.also // []) | map(.branch))) as $theirs
      | (($theirs - $ARGS.positional | length) < ($theirs | length)) or (((.with // []) - $mine | length) < ((.with // []) | length))' \
      "${with[@]}" <"$q" >/dev/null && continue
    st=$COORD/queue/state/$a.json
    [ -f "$st" ] && [ "$(jq -r .commit "$st")" = "$(jq -r .commit "$q")" ] &&
      jq -e '.state == "landed" or .state == "rejected"' "$st" >/dev/null && continue
    files=()
    for oc in $(jq -r '.commit, (.also // [])[].commit' "$q"); do
      for i in "${!udirs[@]}"; do
        git -C "${udirs[i]}" cat-file -e "$oc^{commit}" 2>/dev/null || continue
        rc=0; out=$(git -C "${udirs[i]}" merge-tree --write-tree --name-only "${ucommits[i]}" "$oc") || rc=$?
        [ $rc -ne 1 ] || mapfile -t -O "${#files[@]}" files < <(sed -n '2,/^$/p' <<<"$out" | sed '/^$/d')
      done
    done
    [ ${#files[@]} -eq 0 ] || clashes=$(jq -c --arg a "$a" '. + [{agent: $a, files: $ARGS.positional}]' --args "${files[@]}" <<<"$clashes")
  done
  mkdir -p "$COORD/queue/blocked"
  if [ "$clashes" != '[]' ]; then
    jq -nc --arg agent "$me" --arg branch "$branch" --arg commit "$commit" --argjson clashes "$clashes" --arg at "$(date -Is)" \
      '{agent: $agent, branch: $branch, commit: $commit, clashes: $clashes, at: $at}' >"$COORD/queue/blocked/$me.json"
    echo "coord ready: refused, clashes with queued work:" >&2
    jq -r '.[] | "  \(.agent): \(.files | join(", "))"' <<<"$clashes" >&2
    echo "Merge that agent's branch and resolve, then coord ready --with its branch (one unit); or wait: the runner tells you when it lands." >&2
    exit 1
  fi
  rm -f "$COORD/queue/blocked/$me.json"
  mkdir -p "$COORD/queue"
  jq -nc --arg agent "$me" --arg branch "$branch" --arg commit "$commit" --arg item "$item" \
     --arg at "$(date -Is)" --argjson also "$also" --args '{agent: $agent, branch: $branch, commit: $commit,
       item: (if $item == "" then null else $item end), with: $ARGS.positional, at: $at, also: $also}' "${with[@]}" \
     >"$COORD/queue/$me.json.tmp" && mv "$COORD/queue/$me.json.tmp" "$COORD/queue/$me.json"
  feed --arg branch "$branch" --arg commit "$commit" --argjson also "$also" \
    '{kind: "ready", at: $at, from: $from, branch: $branch, commit: $commit, also: $also}'
  echo "queued $branch at ${commit:0:9} for the runner$(jq -r 'map(" + \(.branch) at \(.commit[:9])") | join("")' <<<"$also")"
  ;;
queue)
  printf '%-10s %-24s %-10s %-9s %-8s %s\n' AGENT BRANCH COMMIT STATE BATCH SINCE/REASON
  for q in "$COORD"/queue/*.json; do
    [ -f "$q" ] || continue
    a=$(basename "$q" .json)
    commit=$(jq -r .commit "$q")
    st="$COORD/queue/state/$a.json" state=waiting batch=- note=$(jq -r .at "$q")
    if [ -f "$st" ] && [ "$(jq -r .commit "$st")" = "$commit" ]; then
      state=$(jq -r .state "$st"); batch=$(jq -r '.batch // "-"' "$st"); note=$(jq -r '.reason // .at' "$st")
    fi
    printf '%-10s %-24s %-10s %-9s %-8s %s\n' "$a" "$(jq -r .branch "$q")" "${commit:0:9}" "$state" "$batch" "$note"
  done
  ;;
*) usage ;;
esac

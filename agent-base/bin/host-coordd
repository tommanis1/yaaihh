#!/usr/bin/env bash
# host-coordd: the coordd of a project without a box (vault designs/yaaihh-2026-11-07.md, amendments of 7 Nov evening),
# on the host as the owner's user: the systemd user unit coordd-NAME, with a delegated cgroup for the agents.
#
#   host-coordd start NAME        start coordd-NAME unless it runs; then resume the agents that ran when it last went
#                                 down (roster resume); one start of NAME at a time (RUN/NAME.start.lock)
#   host-coordd stop NAME         stop coordd (the agents keep running, as in a box where coordd restarts alone)
#   host-coordd status NAME       the unit's state and the socket
#   host-coordd sh NAME [CMD...]  a shell (or CMD) with the project's environment: roster, coord, `coordc bridge` (yaaihh)
#
# The project's environment, as box.sh gives a box's: COORD=~/agent-coord/NAME, COORDD_SOCK=$XDG_RUNTIME_DIR/coordd/
# NAME.sock, AGENT_BASE (this checkout) and agent-base's bin first on PATH; the agents' terminals are their holders'
# (coord-pty, $COORD/pty), as in a box. coordd also gets COORDD_CGROUP (the unit's cgroup; systemd starts coordd in its
# leaf ROOT/coordd, DelegateSubgroup, since a cgroup that enables controllers for its children may hold no processes)
# and COORDD_LIVE; COORD_ACCOUNTS and COORD_CONVERSATIONS, when the caller has them, go on to coordd (the owner's
# accounts kept elsewhere than ~/agent-coord/accounts, and conversations elsewhere than ~/.claude/projects: a try's
# own, coordd's accounts/mod.rs); so does OPENCODE_CONFIG_CONTENT, opencode's own last word on its config, which reaches
# every opencode coordd and roster run (a try's stand-in of a provider's API on loopback, agent-base/tests/opencode-try.sh).
# KillMode=process: stopping the unit stops coordd alone; a new start finds the agents in their cgroups (coordd's
# recover).
set -euo pipefail
# the agent-base this script is in, its real path: a release's own copy (releases/NAME/agent-base, release.sh build)
# stays the one coordd reads even when `current` later points at another release
AB=$(cd "$(dirname "$0")/.." && pwd -P)
# what the unit runs: a release's agent-base by way of releases/current, resolved at each start, so a restart takes the
# release `current` names then (coordd pins itself to the agent-base beside its binary: main.rs agent_base); a checkout's
# own agent-base as it is (paper-research m889)
UAB=$AB
case $AB in */releases/*/agent-base) [ -L "${AB%/releases/*}/releases/current" ] && UAB=${AB%/releases/*}/releases/current/agent-base ;; esac
cmd=${1:-}; NAME=${2:-}
usage() { sed -n '5,9p' "$0" | sed 's/^# //'; exit 2; }
[ -n "$NAME" ] || usage
[[ $NAME =~ ^[A-Za-z0-9_-]+$ ]] || { echo "host-coordd: not a project name: $NAME (letters, digits, - and _)" >&2; exit 2; }
run=${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is not set}/coordd
unit=coordd-$NAME
export COORD=$HOME/agent-coord/$NAME AGENT_BASE=$AB COORDD_SOCK=$run/$NAME.sock
export PATH=$AB/bin:$PATH
. "$AB/lib/route.sh"

# resumed: the agents that ran when coordd last went down (coordd's $COORD/resume.json, owner m172), then done; the
# start's lock let go first (exec 9>&-): what roster resume waits for may wait for coordd, and a switch's start, waiting
# on the lock meanwhile, for it (paper-research N-1446 p2135). Two resumes at once are as before the lock
resumed() { exec 9>&-; "$AB/bin/roster" resume; exit 0; }
# wait_up: resume once coordd's socket is there, waited for while its unit runs, with no time limit (the owner, N-68:
# 5 s was too short at a host boot, 14 Nov 10:26, cav-paper's coordd took 9 s with every project starting, the start
# gave up and CAV stayed down); a unit that is no longer running will not make it: its log's last lines, then the caller
# says so
wait_up() {
  while :; do
    [ -S "$COORDD_SOCK" ] && resumed
    case $(systemctl --user is-active "$unit") in active | activating | reloading) ;; *) break ;; esac
    sleep 0.1
  done
  [ -S "$COORDD_SOCK" ] && resumed
  tail -n 10 "$COORD/coordd.log" >&2 2>/dev/null || true
}

# switching: release.sh's coord-switch of this project is under way (its mark SOCK.d/switching: the pid and start time
# of the switching process; switch_pid is that pid). A mark whose process is gone is passed over; the switch's own start
# (YAAIHH_SWITCH_OWNER, its pid) is not another's
switch_pid=
switching() {
  local mark=$run/$NAME.sock.d/switching start st
  [ -f "$mark" ] && read -r switch_pid start <"$mark" 2>/dev/null && [ "$switch_pid" != "${YAAIHH_SWITCH_OWNER:-}" ] || return 1
  st=$(cat "/proc/$switch_pid/stat" 2>/dev/null) || return 1
  st=${st##*) }; read -ra st <<<"$st"
  [ "${st[19]}" = "$start" ]
}
# switch_wait: while a switch is under way, wait for it, with no time limit. A start meanwhile replaces the switch's stop
# job and cancels it, and coordd comes up again before the switch's copy aside (19 Nov 20:38, research: a window's start
# runs `host-coordd start` for every project, projects.rs bring_up)
switch_wait() {
  local told=
  while switching; do
    [ -n "$told" ] || { echo "host-coordd: $NAME's coordd is being switched (release.sh, pid $switch_pid); waiting for it" >&2; told=1; }
    sleep 0.2
  done
}

case $cmd in
start)
  route_write_key
  # one start of a project at a time (paper-research N-1446 p2119): his window's start runs this for every project
  # (projects.rs bring_up) and WSL's may too (team-up.service); two at once would both find the unit inactive, and the
  # second's `rm -f "$COORDD_SOCK"` below could remove the socket the first's new coordd had just made, leaving it
  # unreachable. The second waits, with no time limit, then finds the unit active and only resumes. Held from the
  # check to the socket (resumed lets it go) and closed (9>&-) in the pins, which outlive this script. Taken after
  # the switch's wait, so a start waiting on a switch holds nothing the switch's own start needs; and a switch that began
  # while this start waited for the lock goes first: the lock is let go, the switch waited for, and the lock taken again
  mkdir -p "$run"
  exec 9>"$run/$NAME.start.lock"
  while :; do
    switch_wait
    flock 9
    switching || break
    flock -u 9
  done
  # the pinned opencode for the coord's opencode accounts and agents, as every project has Claude Code (opencode-pin;
  # the owner, N-1104 p780): in the background, so the machine's first fetch holds up no start; once the coord has it,
  # this says so and does nothing
  mkdir -p "$COORD"
  setsid -f "$AB/bin/opencode-pin" "$COORD" >>"$COORD/opencode-pin.log" 2>&1 </dev/null 9>&-
  # and, the same way, the pinned t3code and agy for its agy accounts (agy-pin; the owner, N-1104 p880 and p886)
  setsid -f "$AB/bin/agy-pin" "$COORD" >>"$COORD/agy-pin.log" 2>&1 </dev/null 9>&-
  # and the pinned Codex, so a new project's New agent lists its models too (codex-pin; the owner, N-2002)
  setsid -f "$AB/bin/codex-pin" "$COORD" >>"$COORD/codex-pin.log" 2>&1 </dev/null 9>&-
  systemctl --user is-active -q "$unit" && resumed
  [ -x "$AB/bin/coordd" ] || { echo "host-coordd: no $AB/bin/coordd (release.sh build, then release.sh live)" >&2; exit 1; }
  mkdir -p "$COORD" "$run"
  rm -f "$COORDD_SOCK"  # a stale socket would pass the wait below before coordd is up
  systemctl --user reset-failed "$unit" 2>/dev/null || true
  # the drop-in below, written by an earlier start of a loaded unit, outlives that unit: one naming another release
  # would override this start's --setenv, and coordd would run the old release (11 Nov, docket-play; m1166)
  drop=$XDG_RUNTIME_DIR/systemd/user.control/$unit.service.d/90-agent-base.conf
  if [ -f "$drop" ] && ! grep -qxF "Environment=AGENT_BASE=$UAB" "$drop"; then
    echo "host-coordd: removed $drop: it named $(sed -n 's/^Environment=AGENT_BASE=//p' "$drop"), not $UAB" >&2
    rm -f "$drop"
    rmdir "$(dirname "$drop")" 2>/dev/null || true
    systemctl --user daemon-reload
  fi
  # a stopped unit whose agents still run in it stays loaded (KillMode=process): start it again as it is, except that one
  # made with a fixed release's agent-base (before m889) gets UAB by a drop-in, so it starts on the release `current`
  # names; the agents in it go on
  if [ "$(systemctl --user show "$unit" -p LoadState --value)" = loaded ]; then
    if ! systemctl --user show "$unit" -p Environment --value | tr ' ' '\n' | grep -qxF "AGENT_BASE=$UAB"; then
      d=$XDG_RUNTIME_DIR/systemd/user.control/$unit.service.d
      mkdir -p "$d"
      printf '[Service]\nEnvironment=AGENT_BASE=%s\nEnvironment=PATH=%s\n' "$UAB" "$UAB/bin:${PATH#"$AB/bin:"}" >"$d/90-agent-base.conf"
      systemctl --user daemon-reload
    fi
    systemctl --user start "$unit"
    wait_up
    echo "host-coordd: coordd did not start; see $COORD/coordd.log" >&2; exit 1
  fi
  # the system's systemd-run (command -p): a same-named wrapper earlier on the owner's PATH may route elsewhere
  # shellcheck disable=SC2016  # expanded by the unit's shell
  command -p systemd-run --user --quiet --unit "$unit" -p Delegate=yes -p DelegateSubgroup=coordd -p KillMode=process \
    -p StandardOutput="append:$COORD/coordd.log" -p StandardError="append:$COORD/coordd.log" \
    --setenv=COORD="$COORD" --setenv=AGENT_BASE="$UAB" --setenv=COORDD_SOCK="$COORDD_SOCK" \
    --setenv=COORDD_LIVE="$run/$NAME.live.json" --setenv=PATH="$UAB/bin:${PATH#"$AB/bin:"}" \
    ${COORD_ACCOUNTS:+--setenv=COORD_ACCOUNTS="$COORD_ACCOUNTS"} \
    ${COORD_CONVERSATIONS:+--setenv=COORD_CONVERSATIONS="$COORD_CONVERSATIONS"} \
    ${OPENCODE_CONFIG_CONTENT:+--setenv=OPENCODE_CONFIG_CONTENT="$OPENCODE_CONFIG_CONTENT"} \
    /bin/sh -c 'COORDD_CGROUP=$(dirname "/sys/fs/cgroup$(sed -n "s/^0:://p" /proc/self/cgroup)") exec "$AGENT_BASE/bin/coordd"'
  wait_up
  echo "host-coordd: coordd did not start; see $COORD/coordd.log and systemctl --user status $unit" >&2; exit 1
  ;;
stop) systemctl --user stop "$unit" ;;
status) echo "$unit: $(systemctl --user is-active "$unit" || true); socket $COORDD_SOCK" ;;
sh) shift 2; [ $# -gt 0 ] || set -- bash; exec "$@" ;;
*) usage ;;
esac

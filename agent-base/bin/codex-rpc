#!/usr/bin/env python3
"""codex-rpc: a Codex agent's app-server, from roster and coord (owner 6 Nov: Codex roster agents).

  codex-rpc new-thread CWD MODEL PROMPT  start a thread with its first turn, print its id (a thread gets its
                                         rollout with its first turn, and one without cannot be resumed once this
                                         connection closes, so the two go together)
  codex-rpc send THREAD PRIORITY TEXT    deliver TEXT as a user message: `next` steers it into the running turn
                                         (owner and orch), else it starts a turn; `later` only starts one when no
                                         turn runs (exit 3 if one does: the caller keeps it held); a turn it
                                         starts runs at $CODEX_EFFORT, if set (coord effort)
  codex-rpc trust-hooks CWD              trust the hooks Codex lists for CWD that are not trusted at their hash
  codex-rpc status THREAD                idle, or the running turn's id
  codex-rpc loaded                       the threads its app-server holds, one id a line
  codex-rpc interrupt THREAD             cut the running turn off (coord esc); nothing when idle
  codex-rpc wait-idle THREAD             return once no turn runs (waits for the app-server's turn/completed)
  codex-rpc serve -- APP-SERVER...       run the agent's app-server (the command after --) and follow it while it
                                         runs; its exit is this one's. roster runs this under `coordc run NAME --`,
                                         so the app-server and its follower are the agent's process for coordd

$CODEX_SOCK is the agent's app-server, `codex app-server --listen unix://$CODEX_SOCK` (bin/roster starts one per
agent; no daemon manager, so no self-update: the box runs the version copied into $COORD/opt/codex). Its protocol is
JSON-RPC over a WebSocket on that unix socket, the transport `codex --remote unix://` uses too.

The follower (`serve`; the owner's "do it", N-1104 p792; paper-research N-1446 p1500) tells coordd what Codex says
only to a connection and never writes to the thread's rollout (Codex 0.160, tried against a fake provider on 22 Nov):
  - a turn that ends `failed` (turn/completed, after the `error` that Codex will not retry): the `failed` hook in
    the words of Claude Code's StopFailure ([`failure`]), so coordd ends the turn and reads the limit as it reads
    Claude Code's and opencode's;
  - a retry under way (`error` with willRetry), a reroute (model/rerouted) and the account's windows
    (account/rateLimits/updated): each an act line of the agent's (`coordc act retrying|rerouted|limits`), facts on
    the record that the graph and the agent's row read.
A connection hears of every thread's start and status (thread/started, thread/status/changed), but of a thread's
turns and errors only once it resumed that thread; and a thread can be resumed only once its first turn made its
rollout. So each thread is resumed at its first status change after that, and the threads already loaded at once.
The token counts, the context window and the windows Codex had at each request are the rollout's already
(token_count), which coordd reads. The follower's own faults go to the agent's log only.
"""
import atexit, base64, json, os, queue, signal, socket, struct, subprocess, sys, threading, time, traceback


def connect(s, path):
    """Connect S to the app-server at PATH. Codex listens in a folder of its own under its /tmp and leaves a link at
    PATH. A boxed one's /tmp is its box's tmp ($COORD/box/NAME/tmp, box-enter), so outside the box (no AGENT_BOX) the
    link is followed there; that folder is the agent's uid's (PermissionError: boxed_again), and its path is longer
    than a socket's name may be, so it is reached from inside it."""
    at = path.find('/home/.codex/app/')
    target = os.readlink(path) if at >= 0 and os.path.islink(path) else ''
    if not target.startswith('/tmp/') or os.environ.get('AGENT_BOX'):
        s.connect(path)
        return
    real = path[:at] + '/tmp/' + target[len('/tmp/'):]
    here = os.open('.', os.O_RDONLY)
    try:
        os.chdir(os.path.dirname(real))
        s.connect(os.path.basename(real))
    finally:
        os.fchdir(here)
        os.close(here)


class Server:
    def __init__(self, path):
        self.s = socket.socket(socket.AF_UNIX)
        connect(self.s, path)
        key = base64.b64encode(os.urandom(16)).decode()
        self.s.sendall((f'GET / HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n'
                        f'Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n').encode())
        head = b''
        while b'\r\n\r\n' not in head:
            head += self.s.recv(1)
        if b' 101 ' not in head.split(b'\r\n')[0]:
            raise ConnectionError(head.decode(errors='replace'))
        self.n, self.replies, self.wlock, self.events = 0, {}, threading.Lock(), queue.Queue()
        self.reader = threading.Thread(target=self.read, daemon=True)
        self.reader.start()
        self.call('initialize', {'clientInfo': {'name': 'codex-rpc', 'version': '1'}})
        self.send({'jsonrpc': '2.0', 'method': 'initialized'})

    def exact(self, n):
        b = b''
        while len(b) < n:
            c = self.s.recv(n - len(b))
            if not c:
                raise EOFError
            b += c
        return b

    def frame(self, op, data):  # a client frame is masked (RFC 6455)
        n, mask = len(data), os.urandom(4)
        size = bytes([0x80 | n]) if n < 126 else (
            bytes([0x80 | 126]) + struct.pack('>H', n) if n < 65536 else bytes([0x80 | 127]) + struct.pack('>Q', n))
        with self.wlock:
            self.s.sendall(bytes([0x80 | op]) + size + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(data)))

    def read(self):
        buf = b''
        try:
            while True:
                b0, b1 = self.exact(2)
                n = b1 & 0x7f
                if n == 126:
                    n = struct.unpack('>H', self.exact(2))[0]
                elif n == 127:
                    n = struct.unpack('>Q', self.exact(8))[0]
                data, op = self.exact(n), b0 & 0x0f
                if op == 9:
                    self.frame(10, data)
                    continue
                if op == 8:
                    return
                buf += data
                if b0 & 0x80:
                    m = json.loads(buf)
                    buf = b''
                    if 'id' in m and ('result' in m or 'error' in m):
                        self.replies[m['id']] = m
                    elif 'method' in m and 'id' not in m:
                        self.events.put(m)
        except (EOFError, OSError):
            return

    def send(self, m):
        self.frame(1, json.dumps(m).encode())

    def call(self, method, params):
        # the reply is waited for while the app-server's socket is open: the reader ends when it closes (no time
        # limit, the owner N-68)
        self.n += 1
        i = self.n
        self.send({'jsonrpc': '2.0', 'id': i, 'method': method, 'params': params})
        while i not in self.replies:
            if not self.reader.is_alive() and i not in self.replies:
                raise ConnectionError(f'{method}: the app-server closed its socket')
            time.sleep(0.02)
        r = self.replies.pop(i)
        if 'error' in r:
            raise RuntimeError(f'{method}: {r["error"].get("message", r["error"])}')
        return r['result']


def running_turn(srv, thread):
    """The id of the thread's running turn, or None. A thread its app-server has not loaded since it started is
    resumed first (its settings are the app-server's: bin/roster)."""
    if thread not in srv.call('thread/loaded/list', {'limit': 1000})['data']:
        srv.call('thread/resume', {'threadId': thread, 'excludeTurns': True})
    try:
        turns = srv.call('thread/read', {'threadId': thread, 'includeTurns': True})['thread'].get('turns', [])
    except RuntimeError:
        # a thread with no turn yet (a New agent with no first words) has no rollout to list turns from (Codex
        # 0.160.0: "list_turns is not supported yet"): idle, it has none running
        if srv.call('thread/read', {'threadId': thread, 'includeTurns': False})['thread'].get('status', {}).get('type') != 'idle':
            raise
        return None
    last = turns[-1] if turns else None
    return last['id'] if last and last.get('status') == 'inProgress' else None


def boxed_again(argv):
    """A boxed agent's app-server runs as its own user (coordd's sandbox.rs), its socket in its home, its uid's: the
    owner's connection is refused there. Run again as root of a user namespace with the box's map (the owner's
    subordinate range, as sandbox.rs `map_args`), which may open the agent's files; once only (CODEX_RPC_NS)."""
    if os.environ.get('CODEX_RPC_NS'):
        return
    me, uid = os.environ.get('USER') or '', str(os.getuid())
    def rng(f):
        for line in open(f):
            p = line.strip().split(':')
            if len(p) == 3 and p[0] in (me, uid):
                return p[1], p[2]
        raise SystemExit(f'codex-rpc: no range for {me or uid} in {f}')
    (us, uc), (gs, gc) = rng('/etc/subuid'), rng('/etc/subgid')
    os.environ['CODEX_RPC_NS'] = '1'
    os.execvp('unshare', ['unshare', '--user', '--map-root-user', f'--map-users=1:{us}:{uc}', f'--map-groups=1:{gs}:{gc}', '--',
                          sys.executable, os.path.abspath(__file__)] + argv[1:])


# Codex's error codes (codexErrorInfo) that are the account's, in the words of Claude Code's StopFailure that coordd's
# limits.rs `from_failed` and core.rs `limit_of` read: the plan's usage limit and the account's request rate (a 429)
# are a rate limit; a refused login is a failed authentication. Every other code is named by Codex's own name.
ACCOUNT_ERRORS = {'usageLimitExceeded': 'rate_limit', 'rateLimitExceeded': 'rate_limit', 'unauthorized': 'authentication_failed'}

# Codex's codes for the provider's passing failures, which Codex ends a turn on once its own retries are spent, in the
# words of Claude Code's StopFailure that core.rs `limit_of` waits out and gives the turn again on (the owner's walk
# item 14 and N-1793: a turn stopped on one stayed stopped till he typed): its overload, and a server error, which a
# connection or stream code is too when the server's status that ended it was a 5xx ([`passing`]).
PASSING_ERRORS = {'serverOverloaded': 'overloaded', 'internalServerError': 'server_error'}
STATUS_CODES = ('httpConnectionFailed', 'responseStreamConnectionFailed', 'responseStreamDisconnected', 'responseTooManyFailedAttempts')


def passing(err):
    """`overloaded` or `server_error` when Codex's turn error ERR is the provider's passing failure, else None: by its
    code ([`PASSING_ERRORS`]), or by the status a connection or stream code carries (529 an overload, another 5xx a
    server error)."""
    code = error_code(err)
    if code in PASSING_ERRORS:
        return PASSING_ERRORS[code]
    info = err.get('codexErrorInfo')
    status = (info.get(code) or {}).get('httpStatusCode') if isinstance(info, dict) and code in STATUS_CODES else None
    if isinstance(status, int) and 500 <= status <= 599:
        return 'overloaded' if status == 529 else 'server_error'
    return None


def error_code(err):
    """The code of Codex's turn error ERR: its codexErrorInfo, a word or a one-key object
    (`{"responseStreamDisconnected": {...}}`); '' when it has none."""
    info = err.get('codexErrorInfo')
    if isinstance(info, str):
        return info
    return next(iter(info), '') if isinstance(info, dict) else ''


def failure(err, windows):
    """What a turn's final error ERR says, as `failed`'s input: StopFailure's `error` word ([`ACCOUNT_ERRORS`]) and
    `error_details` (Codex's message and its additional details; with Codex's own code in front when its word is a
    passing failure's, [`passing`]). On a rate limit, `resets_at` (seconds) is the latest
    reset of a window the last limits said is used up (WINDOWS, [`Follower.limits`]), when one is."""
    code = error_code(err)
    word = ACCOUNT_ERRORS.get(code) or passing(err) or code or 'unknown'
    details = ' · '.join(str(x) for x in (err.get('message'), err.get('additionalDetails')) if x)
    if word in ('overloaded', 'server_error'):
        details = ' · '.join(x for x in (code, details) if x)
    out = {'error': word, 'error_details': details[:300]}
    full = [w['resetsAt'] for w in windows.values() if isinstance(w, dict) and w.get('usedPercent', 0) >= 100 and w.get('resetsAt')]
    if word == 'rate_limit' and full:
        out['resets_at'] = max(full)
    return out


def window_words(w):
    """Window W of Codex's limits in words: its length, how much of it is used and when it resets (UTC)."""
    mins = w.get('windowDurationMins')
    name = {300: '5-hour', 10080: 'weekly'}.get(mins, f'{mins}-minute' if mins else 'a window')
    at = time.strftime(' until %Y-%m-%d %H:%M UTC', time.gmtime(w['resetsAt'])) if w.get('resetsAt') else ''
    return f'{name} {w.get("usedPercent", 0)}%{at}'


def hook(event, data):
    """Tell coordd EVENT as the agent's hook does (claude/hook), from inside the agent's cgroup."""
    base = os.environ.get('AGENT_BASE', '')
    if base:
        subprocess.run([f'{base}/claude/hook', event], input=json.dumps(data), capture_output=True, text=True)


def act(is_, text, **fields):
    """An act line of the agent's on the coord's record (`coordc act IS TEXT FIELD=VALUE...`), from inside its cgroup;
    a value that is not a string goes as JSON. coordc's refusal goes to the agent's log."""
    base = os.environ.get('AGENT_BASE', '')
    if not base:
        return
    args = [f'{k}={v if isinstance(v, str) else json.dumps(v)}' for k, v in fields.items() if v is not None]
    r = subprocess.run([f'{base}/bin/coordc', 'act', is_, text, *args], capture_output=True, text=True)
    if r.returncode != 0:
        sys.stderr.write(f'codex-rpc: coordc act {is_}: {r.stderr.strip() or r.stdout.strip()}\n')


class Follower:
    """What one connection to the agent's app-server hears, told to coordd (see the head of this file)."""

    def __init__(self, srv, limits):
        # LIMITS: the windows as last told, kept across connections, since an update gives only what changed
        self.srv, self.followed, self.limits = srv, set(), limits

    def follow(self, thread):
        """Resume THREAD on this connection, so its turns and errors are heard; one with no rollout yet is followed at
        its next status change."""
        if thread in self.followed:
            return
        try:
            self.srv.call('thread/resume', {'threadId': thread, 'excludeTurns': True})
        except RuntimeError:
            return
        self.followed.add(thread)

    def event(self, m):
        method, p = m.get('method'), m.get('params') or {}
        if method == 'thread/started':
            self.follow((p.get('thread') or {}).get('id', ''))
        elif method == 'thread/status/changed':
            self.follow(p.get('threadId', ''))
        elif method == 'error' and p.get('willRetry'):
            err = p.get('error') or {}
            act('retrying', str(err.get('message') or 'retrying'), thread=p.get('threadId'), turn=p.get('turnId'),
                error=error_code(err) or None, details=err.get('additionalDetails'))
        elif method == 'turn/completed' and (p.get('turn') or {}).get('status') == 'failed':
            turn = p['turn']
            hook('failed', dict({'session_id': p.get('threadId', ''), 'turn_id': turn.get('id', '')}, **failure(turn.get('error') or {}, self.limits)))
        elif method == 'model/rerouted':
            act('rerouted', f'{p.get("fromModel")} to {p.get("toModel")}', thread=p.get('threadId'), turn=p.get('turnId'),
                **{'from': p.get('fromModel'), 'to': p.get('toModel'), 'reason': p.get('reason')})
        elif method == 'account/rateLimits/updated':
            self.rate_limits(p.get('rateLimits') or {})

    def rate_limits(self, snap):
        """An update of the account's limits, merged into the last ("Sparse rolling rate-limit update … merge available
        values"): a `limits` act line when its windows or its reached limit changed; nothing for one that names none."""
        merged = dict(self.limits)
        merged.update({k: v for k, v in snap.items() if k in ('primary', 'secondary', 'rateLimitReachedType', 'planType', 'credits') and v is not None})
        if merged == self.limits or not any(merged.get(k) for k in ('primary', 'secondary', 'rateLimitReachedType')):
            return
        self.limits.clear()
        self.limits.update(merged)
        words = ' · '.join(window_words(merged[k]) for k in ('primary', 'secondary') if isinstance(merged.get(k), dict))
        reached = merged.get('rateLimitReachedType')
        act('limits', words + (f' · reached: {reached}' if reached else ''), primary=merged.get('primary'),
            secondary=merged.get('secondary'), reached=reached, plan=merged.get('planType'), credits=merged.get('credits'))

    def run(self, alive):
        """Follow the threads loaded now and every one started later, until the connection or the app-server ends."""
        for t in self.srv.call('thread/loaded/list', {'limit': 1000})['data']:
            self.follow(t)
        while alive() and self.srv.reader.is_alive():
            try:
                m = self.srv.events.get(timeout=1)
            except queue.Empty:
                continue
            self.event(m)


def serve(cmd):
    """Run the app-server CMD and follow it on $CODEX_SOCK while it runs; exit as it exits. A connection that ends
    is made again; a fault of the follower's own is written to the agent's log once for each kind and the follower
    connects again, and neither touches the app-server."""
    proc = subprocess.Popen(cmd)
    atexit.register(lambda: proc.poll() is None and proc.terminate())
    # a stop is passed on, and the app-server's end ends this (the wait below): a wait in the handler would wait for
    # the one it interrupted, and never end
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, lambda n, _: proc.send_signal(n))
    alive = lambda: proc.poll() is None

    def follow():
        limits, faults = {}, set()
        while alive():
            try:
                Follower(Server(os.environ['CODEX_SOCK']), limits).run(alive)
            except (FileNotFoundError, ConnectionRefusedError, ConnectionError, EOFError):
                pass  # not listening yet, or gone: connected again while it runs
            except Exception as e:
                tb = traceback.extract_tb(e.__traceback__)
                kind = (type(e).__name__, tb[-1].lineno if tb else 0)
                if kind not in faults:
                    faults.add(kind)
                    sys.stderr.write('codex-rpc: the follower met something it does not know; it connects again\n'
                                     + ''.join(traceback.format_exception(type(e), e, e.__traceback__)))
            if alive():
                time.sleep(0.2)
    threading.Thread(target=follow, daemon=True).start()
    sys.exit(proc.wait())


def main(argv):
    if len(argv) > 2 and argv[1:3] == ['serve', '--']:
        serve(argv[3:])
    try:
        srv = Server(os.environ['CODEX_SOCK'])
    except PermissionError:
        boxed_again(argv)
        raise
    cmd = argv[1] if len(argv) > 1 else ''
    if cmd == 'new-thread' and len(argv) == 5:
        cwd, model, prompt = argv[2:5]
        t = srv.call('thread/start', {'cwd': cwd, 'model': model})['thread']['id']
        srv.call('turn/start', {'threadId': t, 'input': [{'type': 'text', 'text': prompt}]})
        print(t)
    elif cmd == 'send' and len(argv) == 5:
        thread, prio, text = argv[2:5]
        msg = [{'type': 'text', 'text': text}]
        turn = running_turn(srv, thread)
        if turn and prio in ('now', 'next'):
            srv.call('turn/steer', {'threadId': thread, 'expectedTurnId': turn, 'input': msg})
        elif turn:
            return 3
        else:
            # $CODEX_EFFORT (coordd, from the agent's record: coord effort): the effort this turn and the thread's later
            # turns run at (turn/start's `effort`); a steer into a running turn leaves its effort as it is
            effort = os.environ.get('CODEX_EFFORT')
            srv.call('turn/start', {'threadId': thread, 'input': msg, **({'effort': effort} if effort else {})})
    elif cmd == 'loaded' and len(argv) == 2:
        print('\n'.join(srv.call('thread/loaded/list', {'limit': 1000})['data']))
    elif cmd == 'interrupt' and len(argv) == 3:
        turn = running_turn(srv, argv[2])
        if turn:
            srv.call('turn/interrupt', {'threadId': argv[2], 'turnId': turn})
    elif cmd == 'wait-idle' and len(argv) == 3:
        # resume rejoins a running thread (app-server protocol), so this connection gets its turn/completed; checked
        # after that, so a turn that ends in between is not waited for
        srv.call('thread/resume', {'threadId': argv[2], 'excludeTurns': True})
        if running_turn(srv, argv[2]):
            while True:
                m = srv.events.get()
                if m['method'] == 'turn/completed' and m.get('params', {}).get('threadId') == argv[2]:
                    break
    elif cmd == 'status' and len(argv) == 3:
        print(running_turn(srv, argv[2]) or 'idle')
    elif cmd == 'trust-hooks' and len(argv) == 3:
        for entry in srv.call('hooks/list', {'cwds': [argv[2]]})['data']:
            for h in entry['hooks']:
                if h['trustStatus'] != 'trusted':
                    srv.call('config/value/write', {'keyPath': f'hooks.state."{h["key"]}".trusted_hash',
                                                    'value': h['currentHash'], 'mergeStrategy': 'replace'})
                    print(f'trusted {h["key"]}')
    else:
        print(__doc__.split('\n\n')[1], file=sys.stderr)
        return 2
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))

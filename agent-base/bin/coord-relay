#!/usr/bin/env python3
"""coord-relay: deliver box agents' messages to Claude Code sessions on the host.

Usage: coord-relay [--once]

A box agent runs `coord msg NAME TEXT` for a host name NAME: the file
$COORD/hosts/NAME holds that session's resume id (our name, never Claude Code's
display name, which changes). coord writes the message to the box's
$COORD/feed.jsonl (delivery "relay"), on the read-write mount the host sees as
~/agent-coord/BOX/feed.jsonl. This reads every box's feed from where it last
stopped (~/agent-coord/.relay.json) and posts each such message into the inbox
socket of the live host session with exactly that id (~/.claude/sessions/PID.json), as
"[from BOX/AGENT] TEXT". The receiving session sees a message from another
session, so it cannot approve anything.

Nothing is dropped (owner, 6 Nov 2026): a message that cannot be delivered (no
such host session running) is held in the state file and delivered when a
session with that id starts.

Messages between projects (N-44): an agent's post due to PROJECT/NAME of another
project is a feed line with delivery "project" (coordd writes it only where the
project file says host_relay = true). This posts it in project X as the owner
side there: `coord msg --as P/AUTHOR --origin P:N-12 NAMES TEXT` (a thread of
X's that came from P's N-12, opened or posted on), or `--re N-7` when the line
says it answers X's own thread N-7 (its origin). NAMES are `to` with X's prefix
taken off. The text is one argument, whatever it holds: on the host through
X's socket, into a box through `box.sh sh X env coord ...` (argv throughout).
Only folders whose project file says host_relay = true are projects. Only
coordd's own refusal (exit 1, its last line beginning "coord") and an unknown
project are final: the message is refused, not tried again. Anything else that
fails (X's coordd not running, box.sh's own exit 1 for a held box, sbx or
docker failing) holds it, delivered when X's coordd runs.

The relay posts no message and writes nothing into any feed, ever (owner,
N-65, N-67): it is no party to any thread, and its outcomes are its own. Each
is one line on stderr (the unit's journal): project or box, the message's id,
from, to, and "delivered", "delivered after being held since T", "held: WHY"
or "refused: WHY": one line per change of a message's state, so a held
message, retried on every wake, says nothing until it is delivered or refused.
Before a message's first carry it writes "carrying ID to X/NAMES" there too,
so a call that never returns can be seen; it waits for every call to return
(no time limit). Lines the relay wrote itself before this (from coord-relay or
X/coord-relay, in old feeds and held in old state) are read past and dropped,
and the relay's names are taken out of a line's `to` (a line with nobody else
in it is read past).

Event-driven, no polling: it sleeps on inotify until a box writes its feed, a
box directory appears, a host session starts (~/.claude/sessions changes), or,
while a message to a project is held, a coordd starts (its socket made, or its
running.json written).
"""
import argparse, ctypes, glob, json, os, re, select, socket, struct, subprocess, sys

HOME = os.path.expanduser("~")
ROOT = os.environ.get("RELAY_ROOT", f"{HOME}/agent-coord")
SESSIONS = os.environ.get("RELAY_SESSIONS", f"{HOME}/.claude/sessions")
STATE = f"{ROOT}/.relay.json"
COORD_BIN = os.path.join(os.path.dirname(os.path.realpath(__file__)), "coord")
# a host project's coordd socket (bin/host-coordd); a box's is inside its VM
RUN = f"{os.environ.get('XDG_RUNTIME_DIR') or f'/run/user/{os.getuid()}'}/coordd"
# the relay's own name: what it posts carries this as its author
RELAY = "coord-relay"
# coordc's exit when it cannot reach coordd (as opposed to 1, coordd's refusal)
NOT_RUNNING = 3


def relays(folder):
    """Whether the project file of the coord FOLDER says host_relay = true (in its [project] table)."""
    try:
        with open(f"{folder}/project") as fh:
            path = fh.read().strip()
        with open(path) as fh:
            text = fh.read()
    except OSError:
        return False
    table = None
    for line in text.splitlines():
        t = line.split("#", 1)[0].strip()
        if t.startswith("["):
            table = t
        elif table == "[project]" and re.fullmatch(r"host_relay\s*=\s*true", t):
            return True
    return False


def projects():
    """The projects messages are carried between: the coord folders under ROOT whose project file says host_relay = true."""
    return sorted(os.path.basename(d.rstrip("/")) for d in glob.glob(f"{ROOT}/*/") if relays(d.rstrip("/")))


def coord(project, args):
    """Run `coord ARGS` in PROJECT as the owner side there; (exit code, what it said)."""
    folder = os.path.realpath(f"{ROOT}/{project}")  # coord tells a box from a host project by ~/agent-coord/NAME
    env = {k: v for k, v in os.environ.items() if k not in ("AGENT_NAME", "COORD_AS", "COORDD_SOCK")}
    env["COORD"] = folder
    sock = f"{RUN}/{os.path.basename(folder)}.sock"
    if os.path.exists(sock):
        env["COORDD_SOCK"] = sock
    try:
        r = subprocess.run([COORD_BIN, *args], env=env, stdin=subprocess.DEVNULL, capture_output=True, text=True)
    except OSError as err:
        return NOT_RUNNING, str(err)
    return r.returncode, (r.stdout + r.stderr).strip()


def carry(src, e):
    """Post message E of project SRC in its project: None when posted, ("held"|"final", why) when not."""
    x = e.get("project", "")
    known = projects()
    if x not in known:
        return "final", f"no project named {x} (projects: {', '.join(p for p in known if p != src) or 'none'})"
    sender = e.get("from", "?")
    author = sender if "/" in sender else f"{src}/{sender}"
    names = [n[len(x) + 1:] if n.startswith(f"{x}/") else n for n in e.get("to", [])]
    origin = e.get("origin") or ""
    if origin.startswith(f"{x}:"):
        args = ["msg", "--as", author, "--re", origin.split(":", 1)[1], ",".join(names), e.get("text", "")]
    else:
        args = ["msg", "--as", author, "--origin", f"{src}:{e.get('ticket', '')}", ",".join(names), e.get("text", "")]
    code, out = coord(x, args)
    if code == 0:
        return None
    last = out.splitlines()[-1] if out else ""
    if code == 1 and last.startswith("coord") and "coordd is not running" not in last:
        return "final", last  # coordd's own refusal (coord msg: ..., coord: no agent ...)
    # anything else is the way in failing, not X refusing: box.sh's own exit 1 (a held box), sbx or docker
    return "held", last if code != NOT_RUNNING and last else f"{x}'s coordd is not running"


def is_relay(name):
    """Whether NAME is the relay itself, here (coord-relay) or as another project names it (X/coord-relay)."""
    return name == RELAY or name.endswith(f"/{RELAY}")


def to_carry(e):
    """Line E as it is carried: the relay's names out of its `to` (it is no party to a thread); None when the relay
    wrote it, or nobody but the relay is left to carry it to (N-65: its notices went from project to project in a loop)."""
    if is_relay(e.get("from", "")):
        return None
    to = [n for n in e.get("to", []) if not is_relay(n)]
    if not to and e.get("to"):
        return None
    return {**e, "to": to} if to != e.get("to", []) else e


def far(e):
    """Whom message E was for: its names as written (X/b, X/c)."""
    return ",".join(e.get("to", [])) or e.get("project", "?")


def host_session(box, name):
    """The inbox socket of the live host session that hosts/NAME of BOX names, and why not if none."""
    try:
        with open(f"{ROOT}/{box}/hosts/{name}") as fh:
            sid = fh.read().strip()
    except OSError:
        return None, f"no host named {name} in {box}/hosts"
    for f in glob.glob(f"{SESSIONS}/*.json"):
        try:
            with open(f) as fh:
                s = json.load(fh)
            os.kill(s["pid"], 0)
        except (OSError, ValueError, KeyError):
            continue
        if s.get("sessionId") == sid:
            return s.get("messagingSocketPath"), None
    return None, f"host {name} ({sid[:8]}) is not running"


def deliver(sock, text):
    line = json.dumps({"type": "user", "message": {"role": "user", "content": text}}) + "\n"
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as c:
        c.connect(sock)
        c.sendall(line.encode())


def attempt(box, e):
    """Deliver message E of BOX; None when delivered, else why not."""
    sock, why = host_session(box, e.get("to", ""))
    if not sock:
        return why
    try:
        deliver(sock, f"[from {box}/{e.get('from', '?')}] {e.get('text', '')}")
        return None
    except OSError as err:
        return f"{e.get('to')}: {err}"


def journal(box, e, status, why=""):
    """One line on stderr (the unit's journal) about message E of BOX: STATUS, and WHY when it was not delivered."""
    to = ",".join(e.get("to", [])) if isinstance(e.get("to"), list) else e.get("to", "")
    tail = f": {why}" if why else ""
    print(f"coord-relay: {box} {e.get('id', '-')} from {e.get('from', '?')} to {to}: {status}{tail}", file=sys.stderr, flush=True)


def relay(state):
    offsets, held = state["offsets"], state["held"]
    # Held messages first, oldest first: a host session or a project's coordd may have started. A retry says nothing
    # while the message stays held (it is retried on every wake); only a changed outcome is a journal line.
    still = []
    for h in held:
        e = h["msg"]
        if e.get("delivery") == "project":
            e = to_carry(e)
            if e is None:
                continue
            why = carry(h["box"], e)
            if why and why[0] == "held":
                still.append(h)
            elif why:
                journal(h["box"], e, "refused", why[1])
            else:
                journal(h["box"], e, f"delivered after being held since {e.get('at')}")
            continue
        why = attempt(h["box"], e)
        if why:
            still.append(h)
        else:
            journal(h["box"], e, f"delivered after being held since {e.get('at')}")
    state["held"] = held = still
    for feed in glob.glob(f"{ROOT}/*/feed.jsonl"):
        box = os.path.basename(os.path.dirname(feed))
        size = os.path.getsize(feed)
        start = offsets.get(feed, 0)  # a feed made since the relay began (older ones start at their end)
        if start > size:
            start = 0
        with open(feed, "rb") as fh:
            fh.seek(start)
            data = fh.read()
        end = data.rfind(b"\n") + 1
        for raw in data[:end].splitlines():
            try:
                e = json.loads(raw)
            except ValueError:
                continue
            if e.get("kind") != "msg" or e.get("delivery") not in ("relay", "project") or is_relay(e.get("from", "")):
                continue
            if e.get("delivery") == "project":
                if not relays(os.path.dirname(feed)):
                    continue  # only a project's own messages are carried
                e = to_carry(e)
                if e is None:
                    continue  # a line only to the relay: read past
                journal(box, e, f"carrying {e.get('id', '-')} to {far(e)}")
                why = carry(box, e)
                if not why:
                    journal(box, e, "delivered")
                elif why[0] == "held":
                    held.append({"box": box, "msg": e})
                    journal(box, e, "held", why[1])
                else:
                    journal(box, e, "refused", why[1])
                continue
            why = attempt(box, e)
            if why:
                held.append({"box": box, "msg": e})
                journal(box, e, "held", why)
            else:
                journal(box, e, "delivered")
        # past what was read, and no further: a line written while these were being carried (a project's coordd takes
        # a while) is read next time; old `relay` entries from before N-65 are read past by their kind
        offsets[feed] = start + end


class Inotify:
    """The few inotify calls this needs, through libc (no extra package)."""
    MODIFY, CREATE, MOVED_TO, ISDIR = 0x2, 0x100, 0x80, 0x40000000

    def __init__(self):
        self.libc = ctypes.CDLL("libc.so.6", use_errno=True)
        self.fd = self.libc.inotify_init1(os.O_CLOEXEC)
        if self.fd < 0:
            raise OSError(ctypes.get_errno(), "inotify_init1")
        self.watched = {}

    def watch(self, path, mask):
        if path in self.watched.values():
            return
        wd = self.libc.inotify_add_watch(self.fd, path.encode(), mask)
        if wd >= 0:
            self.watched[wd] = path

    def wait(self):
        """Block until events arrive; the (directory, name, mask) of each."""
        select.select([self.fd], [], [])
        buf, out, i = os.read(self.fd, 65536), [], 0
        while i < len(buf):
            wd, mask, _, n = struct.unpack_from("iIII", buf, i)
            name = buf[i + 16:i + 16 + n].rstrip(b"\0").decode(errors="replace")
            out.append((self.watched.get(wd, ""), name, mask))
            i += 16 + n
        return out


def save(state):
    with open(STATE + ".tmp", "w") as f:
        json.dump(state, f)
    os.replace(STATE + ".tmp", STATE)


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--once", action="store_true")
    args = p.parse_args()
    try:
        with open(STATE) as f:
            state = json.load(f)
        if "offsets" not in state:  # the old state file: offsets only
            state = {"offsets": state, "held": []}
    except (OSError, ValueError):
        state = {"offsets": {}, "held": []}
    # the relay's own notices held by a relay before N-65 never go out
    state["held"] = [h for h in state["held"] if not is_relay(h["msg"].get("from", ""))
                     and (h["msg"].get("delivery") != "project" or to_carry(h["msg"]) is not None)]
    for feed in glob.glob(f"{ROOT}/*/feed.jsonl"):  # what was there before the relay began is not delivered
        state["offsets"].setdefault(feed, os.path.getsize(feed))
    ino = None if args.once else Inotify()
    while True:
        if ino:  # watch before reading, so nothing written in between is missed
            ino.watch(ROOT, Inotify.CREATE)
            ino.watch(SESSIONS, Inotify.CREATE | Inotify.MOVED_TO | Inotify.MODIFY)
            if os.path.isdir(RUN):
                ino.watch(RUN, Inotify.CREATE | Inotify.MOVED_TO)
            for d in glob.glob(f"{ROOT}/*/"):
                ino.watch(d.rstrip("/"), Inotify.MODIFY | Inotify.CREATE)
        relay(state)
        save(state)
        if args.once:
            break
        # Wake for a feed written, a box directory made, or a host session file written; not for our own state file.
        # While a message to a project is held, also for a coordd starting: its socket made, its running.json written.
        def wakes(d, name, mask):
            if d == SESSIONS or name == "feed.jsonl" or (d == ROOT and mask & Inotify.ISDIR):
                return True
            waiting = any(h["msg"].get("delivery") == "project" for h in state["held"])
            return waiting and ((d == RUN and name.endswith(".sock")) or name == "running.json")
        while not any(wakes(d, name, mask) for d, name, mask in ino.wait()):
            pass


if __name__ == "__main__":
    main()

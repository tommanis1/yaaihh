{
  "apiKeyHelper": "cat \"$COORD/.proxy-key\"",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "CronCreate",
      "CronDelete",
      "CronList"
    ],
    "deny": [
      "Agent",
      "Artifact",
      "AskUserQuestion",
      "ReportFindings",
      "ScheduleWakeup",
      "Workflow"
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "cleanupPeriodDays": 36500,
  "crossSessionInbound": "accept",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$AGENT_BASE/claude/hook\" start",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$AGENT_BASE/claude/hook\" pre",
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$AGENT_BASE/claude/hook\" post",
            "timeout": 600
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$AGENT_BASE/claude/hook\" stop",
            "timeout": 600
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$AGENT_BASE/claude/hook\" failed",
            "timeout": 600
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$AGENT_BASE/claude/hook\" compact",
            "timeout": 600
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$AGENT_BASE/claude/hook\" prompt",
            "timeout": 600
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$AGENT_BASE/claude/hook\" permission",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "modelPicker": {
    "options": [
      {
        "model": "kiro-opus-5.5",
        "label": "Kiro Opus 5.5",
        "description": "Opus 5.5 on Kiro credits (1M)",
        "behavesAs": "claude-opus-5-5"
      },
      {
        "model": "kiro-sonnet-5.5",
        "label": "Kiro Sonnet 5.5",
        "description": "Sonnet 5.5 on Kiro credits (1M)",
        "behavesAs": "claude-sonnet-5-5"
      }
    ]
  },
  "autoCompactWindow": 350000,
  "env": {
    "CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN": "1",
    "CLAUDE_CODE_SUBAGENT_PROMPT_CACHE_TTL": "1h",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1",
    "CLAUDE_CODE_MCP_AUTO_BACKGROUND_MS": "0",
    "MCP_TOOL_TIMEOUT": "660000"
  },
  "theme": "auto",
  "promptCacheTtl": "1h",
  "skillOverrides": {
    "auto-mode-setup": "off",
    "design-qa-protocol": "off",
    "artifact-design": "off",
    "artifact-diagramming": "off",
    "update-config": "off",
    "keybindings-help": "off",
    "code-review": "off",
    "simplify": "off",
    "fewer-permission-prompts": "off",
    "loop": "off",
    "claude-api": "off",
    "workflow-authoring": "off",
    "run": "off",
    "plugin-authoring": "off",
    "init": "off",
    "security-review": "off"
  },
  "tui": "default"
}

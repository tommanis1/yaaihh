#!/usr/bin/env bash
# The one hook of an agent-base agent, Claude Code's (claude/settings.json) and Codex's ($CODEX_HOME/hooks.json, which
# bin/roster writes): each event goes to coordd (vault designs/yaaihh-2026-11-07.md §7), which knows the agent by its
# process's cgroup and keeps its session, turn, running tool calls and held mail.
#
#   hook start | prompt | pre | post | stop     SessionStart, UserPromptSubmit, PreToolUse, PostToolUse, Stop
#   hook permission                              PermissionRequest: Claude Code would ask; see below
#   hook failed                                  StopFailure: the turn ended on an API error (Stop does not run then)
#
# Apart from the refusal below, the hook only tells coordd to look: coordd reads a Claude Code agent's turns and the mail
# it got from its transcript, and hands it held mail through its channel after a turn. It never blocks a session:
# with coordd down it does nothing.
set -u
event=${1:-}
# The Bash tool's PATH is the box's own: a resumed session's shell snapshot carries the PATH of the shell it began in
# (on the host: the box's host-side shims first, unreachable here), and CLAUDE_ENV_FILE is sourced after the snapshot. In a
# project without a box (its coordd at COORDD_SOCK on the host, bin/host-coordd) it is the agent's own PATH, which
# roster gave it.
if [ "$event" = start ] && [ -n "${CLAUDE_ENV_FILE:-}" ]; then
  if [ -n "${COORDD_SOCK:-}" ]; then path=$PATH; else
    path=${TOOL_PATH:+$TOOL_PATH:}${AGENT_BASE:+$AGENT_BASE/bin:}/home/agent/.local/bin:/usr/local/bin:/usr/bin:/bin
  fi
  printf 'export PATH=%q\n' "$path" >>"$CLAUDE_ENV_FILE"
fi
# The one refusal (the owner's wish of 10 Nov 2026): an agent runs under bypassPermissions, so Claude Code asks only
# when its own safety checks stop a call (a dangerous removal such as rm -rf *, a write to its config). Nobody is there
# to answer, so the ask becomes a refusal the agent reads. Claude Code's detection decides what is dangerous; this
# only turns its prompt into a no. A question to the user (AskUserQuestion, ExitPlanMode) is not a safety check and
# is left alone, as is any prompt in another mode.
if [ "$event" = permission ]; then
  exec python3 -I -c '
import json, sys
call = json.load(sys.stdin)
if call.get("permission_mode") == "bypassPermissions" and call.get("tool_name") not in ("AskUserQuestion", "ExitPlanMode"):
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PermissionRequest", "decision": {"behavior": "deny",
        "message": "denied: Claude Code'"'"'s safety check stopped this call (for rm: a dangerous * expansion), and an "
                   "agent has no one to approve it. Do it another way: name the paths, anchor globs at an absolute path."}}}))'
fi
exec "${AGENT_BASE:?}/bin/coordc" hook "$event"
